using CFDIParser.Models;
using CFDIParser.Services;

namespace CFDIManager.Web.Services;

public sealed class ValidacionSatLoteService
{
    private readonly PostgreSqlRepository _repositorio;

    private readonly ConsultaEstadoSatService _consultaSat;

    public ValidacionSatLoteService(
        PostgreSqlRepository repositorio,
        ConsultaEstadoSatService consultaSat)
    {
        _repositorio =
            repositorio;

        _consultaSat =
            consultaSat;
    }

    public async Task<ResultadoValidacionSatLote>
        ValidarPendientesAsync(
            long empresaId,
            int cantidad = 100,
            IProgress<ProgresoValidacionSat>? progreso = null,
            CancellationToken cancellationToken = default)
    {
        List<CfdiValidacionSatDto> comprobantes =
            _repositorio
                .ObtenerCfdiPendientesValidacionSat(
                    empresaId,
                    cantidad);

        var resultado =
            new ResultadoValidacionSatLote
            {
                Total =
                    comprobantes.Count
            };

        int procesados =
            0;

        foreach (
            CfdiValidacionSatDto cfdi
            in comprobantes)
        {
            cancellationToken
                .ThrowIfCancellationRequested();

            EstadoSatDto estado =
                await _consultaSat.ConsultarAsync(
                    cfdi.UUID,
                    cfdi.RfcEmisor,
                    cfdi.RfcReceptor,
                    cfdi.Total,
                    cancellationToken);

            if (estado.ConsultaExitosa)
            {
                _repositorio.ActualizarEstadoSat(
                    empresaId,
                    cfdi.CfdiId,
                    estado);

                resultado.Correctos++;

                if ((estado.Estado ?? "").Equals(
                        "Vigente",
                        StringComparison.OrdinalIgnoreCase))
                {
                    resultado.Vigentes++;
                }
                else if ((estado.Estado ?? "").Equals(
                             "Cancelado",
                             StringComparison.OrdinalIgnoreCase))
                {
                    resultado.Cancelados++;
                }
                else
                {
                    resultado.NoEncontrados++;
                }
            }
            else
            {
                resultado.Errores++;
            }

            procesados++;

            progreso?.Report(
                new ProgresoValidacionSat
                {
                    Procesados =
                        procesados,

                    Total =
                        comprobantes.Count,

                    UUID = cfdi.UUID ?? "",                        

                    Estado =
                        estado.Estado ?? "",

                    Mensaje =
                        estado.MensajeError
                        ?? estado.CodigoEstatus
                        ?? ""
                });

            /*
             * Evita lanzar muchas solicitudes simultáneas.
             * El retraso no es una tarifa oficial del SAT;
             * es una medida prudente del sistema.
             */
            await Task.Delay(
                350,
                cancellationToken);
        }

        return resultado;
    }
}

public sealed class ResultadoValidacionSatLote
{
    public int Total { get; set; }

    public int Correctos { get; set; }

    public int Vigentes { get; set; }

    public int Cancelados { get; set; }

    public int NoEncontrados { get; set; }

    public int Errores { get; set; }
}

public sealed class ProgresoValidacionSat
{
    public int Procesados { get; set; }

    public int Total { get; set; }

    public string UUID { get; set; } =
        "";

    public string Estado { get; set; } =
        "";

    public string Mensaje { get; set; } =
        "";
}

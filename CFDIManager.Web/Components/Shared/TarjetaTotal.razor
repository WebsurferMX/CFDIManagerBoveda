@* Tarjeta de un total (Bootstrap): ícono, título, valor y detalle opcional, con degradado del color. *@

<div class="@Ancho">
    <div class="card h-100 border-@Color-subtle bg-@Color-subtle bg-gradient shadow-sm">
        <div class="card-body py-2 px-3 d-flex align-items-center gap-2">
            <div class="rounded-circle bg-body text-@Color-emphasis border border-@Color-subtle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width: 2rem; height: 2rem">
                <i class="bi @Icono"></i>
            </div>
            <div class="min-w-0">
                <div class="small text-@Color-emphasis text-uppercase fw-semibold lh-sm" style="font-size: .68rem">@Titulo</div>
                <div class="fw-bold text-@Color-emphasis lh-sm">@Valor</div>
                @if (!string.IsNullOrEmpty(Detalle))
                {
                    <div class="small text-body-secondary text-truncate" title="@Detalle">@Detalle</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public string Valor { get; set; } = "";
    [Parameter] public string Icono { get; set; } = "bi-hash";

    /// <summary>Color de Bootstrap: primary, secondary, success, info, warning o danger.</summary>
    [Parameter] public string Color { get; set; } = "secondary";

    [Parameter] public string Ancho { get; set; } = "col-6 col-md-3";
    [Parameter] public string? Detalle { get; set; }
}

@* Tarjeta de un total (Bootstrap): ícono, título, valor y detalle opcional. *@

<div class="@Ancho">
    <div class="card h-100 border-@Color-subtle shadow-sm">
        <div class="card-body py-2 d-flex align-items-center gap-3">
            <div class="rounded-3 bg-@Color-subtle text-@Color-emphasis d-flex align-items-center justify-content-center"
                 style="width: 2.5rem; height: 2.5rem">
                <i class="bi @Icono fs-5"></i>
            </div>
            <div class="min-w-0">
                <div class="small text-body-secondary">@Titulo</div>
                <div class="fs-5 fw-semibold text-@Color-emphasis">@Valor</div>
                @if (!string.IsNullOrEmpty(Detalle))
                {
                    <div class="small text-body-secondary text-truncate" title="@Detalle">@Detalle</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter, EditorRequired] public string Valor { get; set; } = "";
    [Parameter] public string Icono { get; set; } = "bi-hash";

    /// <summary>Color de Bootstrap: primary, secondary, success, info, warning o danger.</summary>
    [Parameter] public string Color { get; set; } = "secondary";

    [Parameter] public string Ancho { get; set; } = "col-6 col-md-3";
    [Parameter] public string? Detalle { get; set; }
}

@using CFDIManager.Web.Services.Correo
@using CFDIParser.Services

@inject CorreoService Correo
@inject PostgreSqlRepository Repo
@inject AccesoEmpresasService Acceso

@* Envía por correo los archivos de un reporte (Exportaciones, Administración de XML…). *@
<Modal Visible="Visible"
       Titulo="Enviar reporte por correo"
       Icono="bi-envelope-paper"
       Tamano="modal-lg"
       Ocupado="Enviando"
       OnCerrar="Cerrar">

    <ChildContent>
        @if (!Configurado)
        {
            <div class="alert alert-warning d-flex gap-2 mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <strong>El envío de correos no está configurado.</strong>
                    <div class="small">
                        <AuthorizeView Policy="@Permisos.AdministrarUsuarios">
                            <Authorized>Configúralo en <a href="configuracion/correo" class="alert-link">Configuración → Correo</a>.</Authorized>
                            <NotAuthorized>Pide al administrador que configure el servidor de correo.</NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert alert-danger d-flex gap-2 py-2">
                    <i class="bi bi-x-octagon-fill"></i>
                    <span>@Error</span>
                </div>
            }

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-semibold" for="correo-para">Para</label>
                    <input id="correo-para"
                           class="form-control"
                           placeholder="contador@empresa.com, direccion@empresa.com"
                           @bind="Para"
                           disabled="@Enviando" />
                    <div class="form-text">Separa varias direcciones con coma o punto y coma.</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold" for="correo-cc">Con copia (CC)</label>
                    <input id="correo-cc" class="form-control" @bind="Cc" disabled="@Enviando" />
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    @if (!string.IsNullOrEmpty(MiCorreo))
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="correo-copia" @bind="CopiaParaMi" disabled="@Enviando" />
                            <label class="form-check-label small" for="correo-copia">Enviarme una copia (@MiCorreo)</label>
                        </div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label small fw-semibold" for="correo-asunto">Asunto</label>
                    <input id="correo-asunto" class="form-control" @bind="Asunto" disabled="@Enviando" />
                </div>

                <div class="col-12">
                    <label class="form-label small fw-semibold" for="correo-mensaje">Mensaje</label>
                    <textarea id="correo-mensaje" class="form-control" rows="4" @bind="Mensaje" disabled="@Enviando"></textarea>
                </div>

                @if (Imagen is { Length: > 0 })
                {
                    <div class="col-12">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="correo-imagen" @bind="IncluirImagen" disabled="@Enviando" />
                            <label class="form-check-label small fw-semibold" for="correo-imagen">Incluir la imagen del resumen en el correo</label>
                        </div>
                        @if (IncluirImagen)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(Imagen)" alt="Resumen" class="img-fluid border rounded" style="max-height: 260px" />
                        }
                    </div>
                }

                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="form-label small fw-semibold mb-0">Archivos adjuntos</span>
                        <span class="badge rounded-pill @(ExcedeLimite ? "text-bg-danger" : "text-bg-secondary")">
                            @FormatoTamano(TotalBytes) de 20 MB
                        </span>
                    </div>

                    <ul class="list-group">
                        @foreach (AdjuntoCorreo adjunto in Lista)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2 small">
                                @IconoArchivo(adjunto.Nombre)
                                <span class="text-truncate flex-grow-1">@adjunto.Nombre</span>
                                <span class="text-body-secondary">@FormatoTamano(adjunto.Contenido.Length)</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Quitar del correo"
                                        @onclick="() => Lista.Remove(adjunto)" disabled="@Enviando">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </li>
                        }
                        @if (Lista.Count == 0)
                        {
                            <li class="list-group-item small text-body-secondary">Sin archivos adjuntos.</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </ChildContent>

    <Pie>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cerrar" disabled="@Enviando">Cancelar</button>

        @if (Configurado)
        {
            <button type="button" class="btn btn-primary" @onclick="Enviar" disabled="@(Enviando || ExcedeLimite || Lista.Count == 0)">
                @if (Enviando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Enviando…</span>
                }
                else
                {
                    <i class="bi bi-send me-2"></i>
                    <span>Enviar</span>
                }
            </button>
        }
    </Pie>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public IReadOnlyList<AdjuntoCorreo> Adjuntos { get; set; } = [];

    [Parameter] public string AsuntoSugerido { get; set; } = "";

    /// <summary>Datos que aparecen en el cuerpo del correo (empresa, periodo, etc.).</summary>
    [Parameter] public IReadOnlyList<(string Etiqueta, string Valor)> Datos { get; set; } = [];

    [Parameter] public long? EmpresaId { get; set; }

    /// <summary>PNG que puede ir dentro del cuerpo del correo (p. ej. el resumen de Administración de XML).</summary>
    [Parameter] public byte[]? Imagen { get; set; }

    /// <summary>Píxeles del PNG por píxel a la vista (2 = imagen al doble de resolución, se muestra a la mitad).</summary>
    [Parameter] public int ImagenEscala { get; set; } = 1;

    private bool IncluirImagen = true;

    [Parameter] public EventCallback OnCerrar { get; set; }

    /// <summary>Se invoca con el texto de confirmación al terminar el envío.</summary>
    [Parameter] public EventCallback<string> OnEnviado { get; set; }

    private bool _visibleAnterior;
    private bool Configurado;
    private bool Enviando;
    private string? Error;

    private string Para = "";
    private string Cc = "";
    private string Asunto = "";
    private string Mensaje = "";
    private bool CopiaParaMi;
    private string MiCorreo = "";
    private string MiNombre = "";

    /// <summary>Adjuntos que se enviarán: los recibidos al abrir, menos los que el usuario quite.</summary>
    private List<AdjuntoCorreo> Lista = [];

    private long TotalBytes => Lista.Sum(a => (long)a.Contenido.Length);

    private bool ExcedeLimite => TotalBytes > CorreoService.LimiteAdjuntosBytes;

    protected override async Task OnParametersSetAsync()
    {
        // Al abrir se reinicia el formulario.
        if (Visible && !_visibleAnterior)
        {
            Configurado = Correo.EstaConfigurado();
            Error = null;
            Para = "";
            Cc = "";
            Asunto = AsuntoSugerido;
            Lista = Adjuntos.ToList();
            IncluirImagen = true;
            Mensaje = "Buen día:\nTe comparto el reporte adjunto generado en CFDI Manager.\nSaludos.";

            var usuario = await Acceso.ObtenerUsuarioActualAsync();
            MiNombre = usuario.FindFirst(UsuarioClaimsFactory.NombreCompleto)?.Value ?? usuario.Identity?.Name ?? "";

            MiCorreo = AccesoEmpresasService.ObtenerUsuarioId(usuario) is long id
                ? Repo.ObtenerUsuarioPorId(id)?.Email ?? ""
                : "";
            CopiaParaMi = !string.IsNullOrEmpty(MiCorreo);
        }

        _visibleAnterior = Visible;
    }

    private async Task Enviar()
    {
        Error = null;
        Enviando = true;

        try
        {
            List<string> para = CorreoService.SepararCorreos(Para);
            List<string> cc = CorreoService.SepararCorreos(Cc);

            if (para.Count == 0)
                throw new InvalidOperationException("Escribe al menos un destinatario.");

            if (string.IsNullOrWhiteSpace(Asunto))
                throw new InvalidOperationException("Escribe el asunto.");

            if (CopiaParaMi && !cc.Contains(MiCorreo, StringComparer.OrdinalIgnoreCase))
                cc.Add(MiCorreo);

            var parrafos = Mensaje
                .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            parrafos.Add($"Archivos adjuntos: {string.Join(", ", Lista.Select(a => a.Nombre))}.");

            bool conImagen = IncluirImagen && Imagen is { Length: > 24 };
            // Ancho del PNG (encabezado IHDR) entre su escala: la tarjeta se ensancha para mostrarlo a tamaño natural.
            int anchoImagen = conImagen ? System.Buffers.Binary.BinaryPrimitives.ReadInt32BigEndian(Imagen.AsSpan(16, 4)) / Math.Max(1, ImagenEscala) : 0;

            (string html, string texto) = PlantillaCorreo.Construir(new PlantillaCorreo.Contenido
            {
                Titulo = Asunto.Trim(),
                Parrafos = parrafos,
                ImagenCid = conImagen ? "resumen" : null,
                ImagenAnchoMaximo = conImagen ? anchoImagen : 696,
                AnchoMaximo = conImagen ? Math.Max(760, anchoImagen + 64) : 760,
                Datos = [.. Datos, ("Enviado por", MiNombre), ("Fecha", DateTime.Now.ToString("dd/MM/yyyy HH:mm"))]
            });

            await Correo.EnviarAsync(new MensajeCorreo
            {
                Tipo = "Reporte",
                Para = para,
                Cc = cc,
                Asunto = Asunto.Trim(),
                CuerpoHtml = html,
                CuerpoTexto = texto,
                Adjuntos = Lista,
                Imagenes = conImagen ? [new ImagenEnLinea("resumen", "resumen.png", Imagen!)] : [],
                EnviadoPor = MiNombre,
                EmpresaId = EmpresaId
            });

            await OnEnviado.InvokeAsync($"El reporte se envió a {string.Join(", ", para)}.");
            await OnCerrar.InvokeAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Enviando = false;
        }
    }

    private Task Cerrar() => OnCerrar.InvokeAsync();

    private static string FormatoTamano(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:N1} MB"
            : $"{Math.Max(1, bytes / 1024d):N0} KB";

    // Ícono de documento: hoja blanca con esquina redondeada y, según el tipo, un distintivo de color con su letra
    // (Excel, ZIP) o el texto del formato sobre la hoja (PDF, XML).
    // (Excel, ZIP) o el texto del formato sobre la hoja (PDF, XML). Va como cadena: dentro de un bloque de código
    // Razor tomaría el <text> de SVG como su propia etiqueta.
    private static MarkupString IconoArchivo(string nombre)
    {
        const string fuente = "font-family=\"Segoe UI, Arial, sans-serif\" font-weight=\"800\" text-anchor=\"middle\"";

        static string Distintivo(string color, string letra) =>
            $"<rect x=\"0.75\" y=\"14.75\" width=\"15\" height=\"15\" rx=\"3\" fill=\"{color}\" stroke=\"#fff\" stroke-width=\"1.5\"/>"
            + $"<text x=\"8.25\" y=\"26.2\" {fuente} font-size=\"11\" fill=\"#fff\">{letra}</text>";

        string contenido = Path.GetExtension(nombre).ToLowerInvariant() switch
        {
            ".xlsx" or ".xls" or ".csv" =>
                "<rect x=\"13\" y=\"7\" width=\"10\" height=\"13\" rx=\"1.5\" fill=\"#33a852\"/>"
                + "<rect x=\"18\" y=\"7\" width=\"5\" height=\"4\" rx=\"1\" fill=\"#9be07a\"/>"
                + Distintivo("#107c41", "X"),
            ".zip" =>
                "<path d=\"M17 4v2m0 2v2m0 2v2\" stroke=\"#6b7280\" stroke-width=\"2\"/>"
                + Distintivo("#d97706", "Z"),
            ".pdf" =>
                $"<text x=\"16\" y=\"13\" {fuente} font-size=\"7.5\" fill=\"#d50000\">PDF</text>"
                + "<path d=\"M10 18h12M10 21.5h12M10 25h12\" stroke=\"#7a7a7a\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>",
            ".xml" =>
                $"<text x=\"16\" y=\"14\" {fuente} font-size=\"7.5\" fill=\"#2f4a6b\">XML</text>"
                + "<path d=\"M10 19h12M10 23h12\" stroke=\"#2f4a6b\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>",
            _ => ""
        };

        return new MarkupString(
            "<svg width=\"30\" height=\"32\" viewBox=\"0 0 30 32\" aria-hidden=\"true\" style=\"flex:none\">"
            + "<path d=\"M8 1.5h11.5a8 8 0 0 1 8 8V27a3.5 3.5 0 0 1-3.5 3.5H8A3.5 3.5 0 0 1 4.5 27V5A3.5 3.5 0 0 1 8 1.5Z\""
            + " fill=\"#f8f9fa\" stroke=\"#9aa0a6\" stroke-width=\"1.3\"/>"
            + contenido
            + "</svg>");
    }
}

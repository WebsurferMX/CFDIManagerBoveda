<!DOCTYPE html>
<html lang="es" data-theme="dark" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* Antes de los estilos para que no parpadee el tema guardado. *@
    <script src="js/theme.js"></script>
    <script>window.cfdiTheme.initialize();</script>

    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @* Iconos de Tabler 3.49 (clases ti ti-*); no chocan con Bootstrap Icons (bi bi-*). *@
    <link rel="stylesheet" href="lib/tabler-icons/tabler-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/cuenta.css" />
    <link rel="stylesheet" href="CFDIManager.Web.styles.css" />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>


<body>
    <Routes @rendermode="RenderModeForPage" />

    <script src="js/descargas.js"></script>
    <script src="js/fecha.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // El login se procesa sin interactividad (necesita HttpContext para escribir la cookie);
    // el resto de la aplicación sigue siendo InteractiveServer.
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
@implements IDisposable

@using System.Globalization
@using CFDIManager.Web.Services
@using CFDIManager.Web.Services.Sat
@using CFDIParser.Models

@inject EmpresaContext EmpresaContext
@inject RecuperarCanceladosService Recuperacion
@inject PeriodoTrabajoService Periodo
@inject CFDIManager.Web.Services.Sinube.SatMetadatosService MetadatosSat
@inject IJSRuntime JS

@* Recibidos cancelados sin XML (el SAT ya no los entrega): se cargan de SINUBE o del proveedor. Pestaña de Herramientas. *@
<div class="recuperar d-flex flex-column gap-3">
    <div>
        <span class="eyebrow">SAT · @EmpresaContext.Rfc</span>
        <h2 class="h5 mb-0">Recuperar cancelados</h2>
    </div>

    @if (!EmpresaContext.TieneEmpresaActiva)
    {
        <div class="alert alert-warning mb-0">Selecciona una empresa activa.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2 mb-0" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                <span>@Error</span>
                <button type="button" class="btn-close" @onclick="() => Error = null"></button>
            </div>
        }

        <div class="border rounded-3 bg-body-tertiary">
            <div class="p-3 d-flex flex-wrap align-items-end gap-3">
                <div>
                    <label class="form-label small fw-semibold mb-1" for="rc-anio">Año</label>
                    <select id="rc-anio" class="form-select" @bind="Anio" @bind:after="Cargar" disabled="@Ocupado">
                        @for (int a = DateTime.Today.Year; a >= DateTime.Today.Year - 6; a--)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label small fw-semibold mb-1" for="rc-mes">Mes</label>
                    <select id="rc-mes" class="form-select" @bind="Mes" @bind:after="Cargar" disabled="@Ocupado">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@m.ToString("00") · @Mx.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </div>

                <button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" @onclick="ConsultarSat" disabled="@Ocupado">
                    @if (Consultando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Consultando SAT…</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Consultar SAT</span>
                    }
                </button>

                <label class="btn btn-primary d-inline-flex align-items-center gap-2 mb-0 @(Ocupado ? "disabled" : "")">
                    @if (Cargando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Cargando…</span>
                    }
                    else
                    {
                        <i class="bi bi-upload"></i>
                        <span>Cargar XML o ZIP</span>
                    }
                    <InputFile @key="_inputKey" class="d-none" multiple accept=".xml,.zip" OnChange="CargarArchivos" disabled="@Ocupado" />
                </label>

                <div class="ms-auto d-flex align-items-center gap-3">
                    @if (MetadatosMes is not null)
                    {
                        <span class="small text-body-secondary" title="Solicitud @MetadatosMes.SolicitudId">
                            <i class="bi bi-clock-history me-1"></i>SAT al @MetadatosMes.CubreHasta.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    }
                    <button type="button" class="btn btn-outline-success" @onclick="DescargarExcel" disabled="@(Faltantes == 0)">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel de faltantes
                    </button>
                </div>
            </div>

            @if (Consultando)
            {
                <div class="border-top px-3 py-2 small d-flex align-items-center gap-2">
                    <span class="spinner-border spinner-border-sm text-primary"></span>
                    <span>@AvanceSat</span>
                    <button type="button" class="btn btn-sm btn-link ms-auto" @onclick="() => CancelacionSat?.Cancel()">Detener</button>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Mensaje))
        {
            <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-0" role="status">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@Mensaje</span>
                <button type="button" class="btn-close" @onclick="() => Mensaje = null"></button>
            </div>
        }

        @if (MetadatosMes is null && !Consultando)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                <i class="bi bi-cloud-slash fs-5"></i>
                <span>No hay metadatos de recibidos de @Anio@Mes.ToString("00"): usa Consultar SAT.</span>
            </div>
        }

        <div class="row g-3">
            <TarjetaTotal Titulo="Cancelados en el SAT" Valor="@Filas.Count.ToString("N0")" Icono="bi-x-octagon" Color="secondary" />
            <TarjetaTotal Titulo="XML en bóveda" Valor="@((Filas.Count - Faltantes).ToString("N0"))" Icono="bi-check2-circle" Color="success" />
            <TarjetaTotal Titulo="Faltan XML" Valor="@Faltantes.ToString("N0")" Icono="bi-file-earmark-excel" Color="danger" />
            <TarjetaTotal Titulo="Monto faltante" Valor="@Filas.Where(f => !f.EnBoveda).Sum(f => f.Monto).ToString("C2", Mx)" Icono="bi-cash-stack" Color="warning" />
        </div>

        @if (UltimaCarga is { Count: > 0 })
        {
            <div class="card">
                <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-semibold">Última carga</span>
                    @foreach (var grupo in UltimaCarga.GroupBy(r => r.Estatus))
                    {
                        <span class="badge rounded-pill bg-@ColorEstatus(grupo.Key)-subtle text-@ColorEstatus(grupo.Key)-emphasis border border-@ColorEstatus(grupo.Key)-subtle">
                            @grupo.Key: @grupo.Count()
                        </span>
                    }
                    <button type="button" class="btn-close ms-auto" aria-label="Cerrar" @onclick="() => UltimaCarga = null"></button>
                </div>
                <div class="table-responsive carga">
                    <table class="table table-sm align-middle mb-0 tabla">
                        <thead>
                            <tr><th>Archivo</th><th>UUID</th><th>Resultado</th><th>Detalle</th></tr>
                        </thead>
                        <tbody>
                            @foreach (RecuperacionArchivo r in UltimaCarga)
                            {
                                <tr>
                                    <td class="archivo" title="@r.Archivo">@r.Archivo</td>
                                    <td class="font-monospace">@r.Uuid</td>
                                    <td><span class="badge bg-@ColorEstatus(r.Estatus)-subtle text-@ColorEstatus(r.Estatus)-emphasis">@r.Estatus</span></td>
                                    <td class="text-body-secondary">@r.Detalle</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group" aria-label="Filtro">
                    <button type="button" class="btn @(Filtro == "faltan" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => Filtro = "faltan"'>Faltan XML</button>
                    <button type="button" class="btn @(Filtro == "boveda" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => Filtro = "boveda"'>En bóveda</button>
                    <button type="button" class="btn @(Filtro == "todos" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => Filtro = "todos"'>Todos</button>
                </div>
                <span class="small text-body-secondary ms-auto">@Visibles.Count() de @Filas.Count</span>
            </div>
            <div class="table-responsive tabla-contenedor">
                <table class="table table-sm table-hover align-middle mb-0 tabla">
                    <thead>
                        <tr>
                            <th>RFC emisor</th>
                            <th>Emisor</th>
                            <th>Fecha emisión</th>
                            <th class="text-end">Monto</th>
                            <th>Tipo</th>
                            <th>Cancelado</th>
                            <th>XML</th>
                            <th>UUID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CanceladoSatDto c in Visibles)
                        {
                            <tr>
                                <td>@c.RfcEmisor</td>
                                <td class="emisor" title="@c.NombreEmisor">@c.NombreEmisor</td>
                                <td>@c.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">@c.Monto.ToString("N2")</td>
                                <td>@c.Efecto</td>
                                <td>@c.FechaCancelacion?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (c.EnBoveda)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis">En bóveda</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger-emphasis">Falta</span>
                                    }
                                </td>
                                <td class="font-monospace">@c.Uuid</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Mx = new("es-MX");

    private int Anio;
    private int Mes;
    private List<CanceladoSatDto> Filas = new();
    private SatMetadatosPeriodoDto? MetadatosMes;
    private string Filtro = "faltan";
    private bool Cargando;
    private bool Consultando;
    private string AvanceSat = "";
    private CancellationTokenSource? CancelacionSat;
    private string? Error;
    private string? Mensaje;

    private bool Ocupado => Cargando || Consultando;
    private List<RecuperacionArchivo>? UltimaCarga;
    private Guid _inputKey = Guid.NewGuid();

    private int Faltantes => Filas.Count(f => !f.EnBoveda);

    private IEnumerable<CanceladoSatDto> Visibles => Filtro switch
    {
        "faltan" => Filas.Where(f => !f.EnBoveda),
        "boveda" => Filas.Where(f => f.EnBoveda),
        _ => Filas
    };

    protected override void OnInitialized()
    {
        Anio = Periodo.Anio;
        Mes = Periodo.Mes;
        EmpresaContext.OnChange += EmpresaCambio;
        Cargar();
    }

    private void Cargar()
    {
        if (!EmpresaContext.TieneEmpresaActiva)
        {
            Filas = new();
            MetadatosMes = null;
            return;
        }

        Filas = Recuperacion.Listar(EmpresaContext.EmpresaId, Anio, Mes);
        MetadatosMes = Recuperacion.Metadatos(EmpresaContext.EmpresaId, Anio, Mes);
    }

    private void EmpresaCambio() => InvokeAsync(() =>
    {
        CancelacionSat?.Cancel();
        UltimaCarga = null;
        Mensaje = null;
        Cargar();
        StateHasChanged();
    });

    /// <summary>
    /// Pide al SAT los metadatos de recibidos del mes y vuelve a calcular la lista: quedan los cancelados que no
    /// están en la bóveda (el SAT ya no entrega su XML). Tarda de 1 a 10 minutos.
    /// </summary>
    private async Task ConsultarSat()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        Error = null;
        Mensaje = null;
        Consultando = true;
        AvanceSat = "Enviando la solicitud de metadatos al SAT…";
        CancelacionSat = new CancellationTokenSource();
        int antes = Faltantes;
        int anio = Anio, mes = Mes;

        var progreso = new Progress<string>(texto => InvokeAsync(() =>
        {
            AvanceSat = texto;
            StateHasChanged();
        }));

        try
        {
            await MetadatosSat.ActualizarAsync(empresa, recibidos: true, anio, mes, progreso, CancelacionSat.Token, origen: "Recuperar cancelados");
            Cargar();
            Mensaje = $"SAT consultado: {Filas.Count:N0} recibidos cancelados en {anio}{mes:00}, {Faltantes:N0} sin XML" +
                      (Faltantes != antes ? $" (antes {antes:N0})." : ".");
        }
        catch (OperationCanceledException)
        {
            // Se detuvo o se cambió de empresa: la solicitud sigue en Descargas SAT y se retoma al volver a consultar.
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Consultando = false;
            CancelacionSat?.Dispose();
            CancelacionSat = null;
        }
    }

    private async Task CargarArchivos(InputFileChangeEventArgs e)
    {
        Error = null;
        Cargando = true;

        try
        {
            UltimaCarga = await Recuperacion.CargarAsync(EmpresaContext.EmpresaActiva!, e.GetMultipleFiles(5000));
            Cargar();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
            _inputKey = Guid.NewGuid();
        }
    }

    private async Task DescargarExcel()
    {
        byte[] contenido = Recuperacion.GenerarExcel(EmpresaContext.EmpresaActiva!, Anio, Mes, Filas.Where(f => !f.EnBoveda));
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"Cancelados_sin_XML_{EmpresaContext.Rfc}_{Anio}{Mes:00}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(contenido));
    }

    private static string ColorEstatus(string estatus) => estatus switch
    {
        RecuperarCanceladosService.Recuperado => "success",
        RecuperarCanceladosService.YaEstaba => "secondary",
        RecuperarCanceladosService.NoEnLista => "warning",
        _ => "danger"
    };

    public void Dispose()
    {
        EmpresaContext.OnChange -= EmpresaCambio;
        CancelacionSat?.Cancel();
    }
}

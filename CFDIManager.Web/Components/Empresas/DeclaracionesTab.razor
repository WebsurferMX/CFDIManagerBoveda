@using Microsoft.AspNetCore.Components.Forms
@using CFDIManager.Web.Services.Cif

@using CFDIManager.Web.Services.Sat

@inject ArchivosSatService Archivos
@inject DescargaArchivosSatService Descarga
@inject DiotBovedaService DiotBoveda
@inject CFDIManager.Web.Services.PeriodoTrabajoService PeriodoTrabajo
@inject IJSRuntime JS

@* Acuses de la empresa por ejercicio: declaraciones mensuales y anual, y DIOT, cada una en su tarjeta. *@
<div class="declaraciones">

    @if (EmpresaId <= 0)
    {
        <div class="alert alert-info mb-0">Guarda la empresa primero para poder cargar sus declaraciones.</div>
    }
    else
    {
        <section class="dc-card">
        <div class="dc-card-titulo"><i class="bi bi-file-earmark-text"></i>Declaraciones mensuales y anual</div>
        <div class="dc-barra">
            <label>
                Ejercicio
                <select class="form-select form-select-sm" @bind="Ejercicio">
                    @foreach (int anio in Ejercicios)
                    {
                        <option value="@anio">@anio</option>
                    }
                </select>
            </label>

            <label>
                Tipo
                <select class="form-select form-select-sm" @bind="Tipo">
                    <option value="MENSUAL">Mensual</option>
                    <option value="ANUAL">Anual</option>
                </select>
            </label>

            @if (Tipo == "MENSUAL")
            {
                <label>
                    Periodo
                    <select class="form-select form-select-sm" @bind="Periodo">
                        @for (int m = 1; m <= 12; m++)
                        {
                            int mes = m;
                            <option value="@mes">@Mx.DateTimeFormat.GetMonthName(mes)</option>
                        }
                    </select>
                </label>
            }

            <label class="btn btn-outline-primary btn-sm mb-0 text-nowrap @(Cargando ? "disabled" : "")">
                <i class="bi bi-upload me-1"></i>@(Cargando ? "Leyendo…" : "Cargar acuse (PDF)")
                <InputFile class="d-none" accept=".pdf,application/pdf" OnChange="Cargar" disabled="@Cargando" />
            </label>

            @if (TieneCiec)
            {
                <button type="button" class="btn btn-sm text-nowrap @(PanelSat ? "btn-primary" : "btn-outline-primary")" @onclick="AlternarPanelSat">
                    <i class="bi bi-cloud-arrow-down me-1"></i>Descargar del SAT
                </button>
            }
        </div>
        <small class="dc-ayuda">
            Si el acuse trae el ejercicio y el periodo, se toman del PDF; si no, los que elegiste aquí.
            @if (!TieneCiec)
            {
                <span>Para descargarlos del SAT, captura la contraseña (CIEC) en Accesos SAT.</span>
            }
        </small>

        @if (PanelSat)
        {
            <div class="dc-sat">
                <div class="dc-sat-fila">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(PortalSat == "MENSUAL" ? "btn-primary" : "btn-outline-primary")" disabled="@Trabajando" @onclick='() => CambiarPortal("MENSUAL")'>Mensuales</button>
                        <button type="button" class="btn @(PortalSat == "ANUAL" ? "btn-primary" : "btn-outline-primary")" disabled="@Trabajando" @onclick='() => CambiarPortal("ANUAL")'>Anual</button>
                    </div>
                    <span class="dc-sat-ejercicio">Ejercicio <b>@Ejercicio</b></span>
                </div>

                @if (!Descarga.SesionActiva(EmpresaId, PortalSat))
                {
                    <div class="dc-sat-fila">
                        <div class="dc-captcha">
                            @if (Captcha != "")
                            {
                                <img src="@Captcha" alt="Captcha del SAT" />
                            }
                            else
                            {
                                <span>@(Trabajando ? "Pidiendo captcha al SAT…" : "Sin captcha")</span>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Trabajando" title="Pedir otro captcha" @onclick="PedirCaptcha">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        @* form apunta a un formulario inexistente: dentro de Empresas, Enter no debe guardar la empresa. *@
                        <input class="form-control form-control-sm dc-captcha-texto" placeholder="Texto del captcha" maxlength="10" autocomplete="off"
                               form="captcha-declaraciones-sin-formulario"
                               @bind="TextoCaptcha" @bind:event="oninput" @onkeydown="TeclaCaptcha" disabled="@(Trabajando || Captcha == "")" />
                        <button type="button" class="btn btn-sm btn-primary text-nowrap" disabled="@(Trabajando || Captcha == "" || TextoCaptcha.Trim() == "")" @onclick="Entrar">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Entrar y descargar @Ejercicio
                        </button>
                    </div>
                }
                else
                {
                    <div class="dc-sat-fila">
                        <span class="dc-sat-sesion"><i class="bi bi-check-circle-fill"></i> Sesión abierta en el portal del SAT</span>
                        <button type="button" class="btn btn-sm btn-primary text-nowrap" disabled="@Trabajando" @onclick="DescargarAcuses">
                            <i class="bi bi-cloud-arrow-down me-1"></i>Descargar acuses @Ejercicio
                        </button>
                    </div>
                }

                @if (Trabajando && MensajeSat != "")
                {
                    <div class="dc-sat-progreso"><span class="spinner-border spinner-border-sm me-2"></span>@MensajeSat</div>
                }

                @if (ErrorSat != "")
                {
                    <div class="alert alert-danger py-2 small mb-0"><i class="bi bi-exclamation-triangle me-1"></i>@ErrorSat</div>
                }

                @if (Resultado is not null)
                {
                    <div class="alert @(Resultado.Errores.Count > 0 ? "alert-warning" : "alert-success") py-2 small mb-0">
                        <i class="bi bi-info-circle me-1"></i>@Resultado.Resumen
                        @foreach (string e in Resultado.Errores.Take(5))
                        {
                            <div>@e</div>
                        }
                    </div>
                }

                <small class="dc-ayuda">
                    @(PortalSat == "MENSUAL"
                        ? "Mensuales y provisionales del portal nuevo del SAT (ejercicio 2025 en adelante)."
                        : "Declaración anual del ejercicio.")
                    Solo se bajan los acuses que todavía no están guardados.
                </small>
            </div>
        }

        @if (Error != "")
        {
            <div class="alert alert-danger py-2 small mt-2 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>@Error</div>
        }

        <div class="dc-meses">
            @for (int m = 1; m <= 12; m++)
            {
                @Mes(Declaraciones, Ejercicio, m, "acuse(s)")
            }
            <div class="dc-mes anual @(Declaraciones.Any(d => d.Tipo == "ANUAL") ? "presentada" : "pendiente")">
                <span>ANUAL</span>
                <i class="bi @(Declaraciones.Any(d => d.Tipo == "ANUAL") ? "bi-check-circle-fill" : "bi-exclamation-circle")"></i>
            </div>
        </div>

        @if (Declaraciones.Count == 0)
        {
            <p class="dc-vacio">Todavía no hay acuses guardados para el ejercicio @Ejercicio.</p>
        }
        else
        {
            <table class="dc-tabla">
                <thead>
                    <tr>
                        <th>Periodo</th>
                        <th>Tipo</th>
                        <th>Presentación</th>
                        <th>No. operación</th>
                        <th class="num">A pagar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DeclaracionSatDto d in Declaraciones)
                    {
                        <tr>
                            <td><b>@(d.Tipo == "ANUAL" ? "Anual" : Mx.DateTimeFormat.GetMonthName(d.Periodo))</b></td>
                            <td>@(d.TipoDeclaracion != "" ? d.TipoDeclaracion : "—")</td>
                            <td>@(d.FechaPresentacion?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="mono">@(d.NumeroOperacion != "" ? d.NumeroOperacion : "—")</td>
                            <td class="num">@(d.ImporteAPagar is decimal i ? i.ToString("C2", Mx) : "—")</td>
                            @Acciones(d)
                        </tr>
                    }
                </tbody>
            </table>
        }
        </section>

        <section class="dc-card diot">
            <div class="dc-card-titulo"><i class="bi bi-people"></i>DIOT · operaciones con terceros</div>
            <div class="dc-barra">
                <label>
                    Ejercicio
                    <select class="form-select form-select-sm" @bind="EjercicioDiot" @bind:after="CalcularBoveda">
                        @foreach (int anio in Ejercicios)
                        {
                            <option value="@anio">@anio</option>
                        }
                    </select>
                </label>

                <label>
                    Periodo
                    <select class="form-select form-select-sm" @bind="PeriodoDiot">
                        @for (int m = 1; m <= 12; m++)
                        {
                            int mes = m;
                            <option value="@mes">@Mx.DateTimeFormat.GetMonthName(mes)</option>
                        }
                    </select>
                </label>

                <label class="btn btn-outline-primary btn-sm mb-0 text-nowrap @(CargandoDiot ? "disabled" : "")">
                    <i class="bi bi-upload me-1"></i>@(CargandoDiot ? "Leyendo…" : "Cargar acuse DIOT (PDF)")
                    <InputFile class="d-none" accept=".pdf,application/pdf" OnChange="CargarDiot" disabled="@CargandoDiot" />
                </label>
            </div>

            @if (ErrorDiot != "")
            {
                <div class="alert alert-danger py-2 small mt-2 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>@ErrorDiot</div>
            }

            <div class="dc-meses doce">
                @for (int m = 1; m <= 12; m++)
                {
                    @Mes(Diot, EjercicioDiot, m, "acuse(s) de DIOT")
                }
            </div>

            @if (Diot.Count == 0)
            {
                <p class="dc-vacio">Todavía no hay acuses de DIOT para el ejercicio @EjercicioDiot.</p>
            }
            else
            {
                <table class="dc-tabla">
                    <thead>
                        <tr>
                            <th>Periodo</th>
                            <th>Ejercicio</th>
                            <th>Tipo</th>
                            <th>Periodicidad</th>
                            <th>Presentación</th>
                            <th>Medio</th>
                            <th>Versión</th>
                            <th>No. operación</th>
                            @if (Diot.Any(d => d.Folio != ""))
                            {
                                <th>Folio</th>
                            }
                            <th class="num">Operaciones</th>
                            <th class="num">IVA pagado</th>
                            <th class="num">IVA bóveda</th>
                            <th class="num">Diferencia</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DeclaracionSatDto d in Diot)
                        {
                            <tr>
                                <td><b>@Mx.DateTimeFormat.GetMonthName(d.Periodo)</b></td>
                                <td>@d.Ejercicio</td>
                                <td>@(d.TipoDeclaracion != "" ? d.TipoDeclaracion : "—")</td>
                                <td>@(d.Periodicidad != "" ? d.Periodicidad : "—")</td>
                                <td>@(d.FechaPresentacion is DateTime fp ? fp.ToString(fp.TimeOfDay == TimeSpan.Zero ? "dd/MM/yyyy" : "dd/MM/yyyy HH:mm") : "—")</td>
                                <td>@(d.Medio != "" ? d.Medio : "—")</td>
                                <td>@(d.Version != "" ? d.Version : "—")</td>
                                <td class="mono">@(d.NumeroOperacion != "" ? d.NumeroOperacion : "—")</td>
                                @if (Diot.Any(x => x.Folio != ""))
                                {
                                    <td class="mono">@(d.Folio != "" ? d.Folio : "—")</td>
                                }
                                <td class="num">@(d.Operaciones?.ToString("N0", Mx) ?? "—")</td>
                                <td class="num">@(d.IvaPagado is decimal iva ? iva.ToString("C0", Mx) : "—")</td>
                                @if (Bovedas.TryGetValue(d.Periodo, out DiotBoveda? b) && b.HayXml)
                                {
                                    decimal? dif = d.IvaPagado is decimal acuse ? acuse - b.Iva : null;
                                    bool cuadra = dif is decimal x && Math.Abs(x) <= Math.Max(1, d.Operaciones ?? 1);
                                    <td class="num" title="@($"{b.Operaciones} proveedores en la bóveda")">@b.Iva.ToString("C0", Mx)</td>
                                    <td class="num">
                                        <span class="dc-dif @(dif is null ? "" : cuadra ? "cuadra" : "difiere")"
                                              title="@(b.PagosSinImpuestos > 0 ? $"{b.PagosSinImpuestos} complemento(s) sin impuestos por pago (Pagos 1.0) no se pudieron sumar" : "")">
                                            @(dif is decimal y ? (cuadra ? "Cuadra" : y.ToString("C0", Mx)) : "—")
                                        </span>
                                    </td>
                                }
                                else
                                {
                                    <td class="num dc-sin-xml" colspan="2">Sin XML en la bóveda</td>
                                }
                                <td class="dc-acciones dc-excel">
                                    <button type="button" class="excel" title="Excel de conciliación por proveedor" disabled="@(!Bovedas.ContainsKey(d.Periodo))"
                                            @onclick="() => ExcelDiot(d)"><i class="bi bi-file-earmark-excel"></i></button>
                                </td>
                                @Acciones(d)
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Mx = new("es-MX");

    [Parameter] public long EmpresaId { get; set; }
    [Parameter] public string Rfc { get; set; } = "";

    /// <summary>Con CIEC guardada se pueden descargar los acuses del portal del SAT.</summary>
    [Parameter] public bool TieneCiec { get; set; }

    private List<DeclaracionSatDto> Lista = [];

    // Descarga del SAT
    private bool PanelSat;
    private string PortalSat = "MENSUAL";
    private string Captcha = "";
    private string TextoCaptcha = "";
    private bool Trabajando;
    private string MensajeSat = "";
    private string ErrorSat = "";
    private ResultadoDescargaDeclaraciones? Resultado;
    private int Ejercicio = DateTime.Today.Year;
    private string Tipo = "MENSUAL";
    private int Periodo = DateTime.Today.AddMonths(-1).Month;
    private bool Cargando;
    private string Error = "";
    private long? EmpresaCargada;

    // DIOT: su propio ejercicio y periodo, y la DIOT reconstruida con la bóveda por mes (de los meses con acuse).
    private Dictionary<int, DiotBoveda> Bovedas = [];
    private int EjercicioDiot = DateTime.Today.Year;
    private int PeriodoDiot = DateTime.Today.AddMonths(-1).Month;
    private bool CargandoDiot;
    private string ErrorDiot = "";

    private IEnumerable<int> Ejercicios =>
        Enumerable.Range(DateTime.Today.Year - 5, 6).Append(PeriodoTrabajo.Anio).Concat(Lista.Select(d => d.Ejercicio)).Distinct().OrderDescending();

    private List<DeclaracionSatDto> Declaraciones =>
        Lista.Where(d => d.Tipo != "DIOT" && d.Ejercicio == Ejercicio).OrderBy(d => d.Tipo == "ANUAL" ? 13 : d.Periodo).ToList();

    private List<DeclaracionSatDto> Diot =>
        Lista.Where(d => d.Tipo == "DIOT" && d.Ejercicio == EjercicioDiot).OrderBy(d => d.Periodo).ToList();

    /// <summary>El mes en curso y los siguientes todavía no vencen.</summary>
    private static bool FuturoOActual(int ejercicio, int mes) =>
        new DateTime(ejercicio, mes, 1) >= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    /// <summary>Casilla del mes en el cuadro del ejercicio: verde con acuse, amarillo si falta, gris si no ha vencido.</summary>
    private RenderFragment Mes(List<DeclaracionSatDto> lista, int ejercicio, int mes, string acuses)
    {
        int cuantos = lista.Count(d => d.Tipo != "ANUAL" && d.Periodo == mes);
        bool futuro = FuturoOActual(ejercicio, mes);

        return @<div class="dc-mes @(cuantos > 0 ? "presentada" : futuro ? "futuro" : "pendiente")"
                     title="@(cuantos > 0 ? $"{cuantos} {acuses}" : "Sin acuse cargado")">
                    <span>@Mx.DateTimeFormat.GetAbbreviatedMonthName(mes).TrimEnd('.').ToUpperInvariant()</span>
                    <i class="bi @(cuantos > 0 ? "bi-check-circle-fill" : futuro ? "bi-dash-circle" : "bi-exclamation-circle")"></i>
                </div>;
    }

    private RenderFragment Acciones(DeclaracionSatDto d) =>
        @<td class="dc-acciones">
            <a href="@($"api/empresa/{EmpresaId}/archivos-sat/declaracion-{d.Id}")" target="_blank" title="Ver PDF"><i class="bi bi-file-earmark-pdf"></i></a>
            <button type="button" title="Eliminar" @onclick="() => Eliminar(d)"><i class="bi bi-trash3"></i></button>
        </td>;

    protected override void OnParametersSet()
    {
        if (EmpresaCargada == EmpresaId)
            return;

        EmpresaCargada = EmpresaId;

        // Las dos tarjetas abren en el periodo de trabajo (Herramientas).
        Ejercicio = EjercicioDiot = PeriodoTrabajo.Anio;
        Periodo = PeriodoDiot = PeriodoTrabajo.Mes;
        Error = "";
        ErrorDiot = "";
        if (EmpresaId > 0)
            Archivos.ReleerDiot(EmpresaId);

        Lista = EmpresaId > 0 ? Archivos.ObtenerDeclaraciones(EmpresaId) : [];
        CalcularBoveda();
        PanelSat = false;
        Resultado = null;
        ErrorSat = "";
    }

    // ---------- Descarga del SAT ----------

    private async Task AlternarPanelSat()
    {
        PanelSat = !PanelSat;

        if (PanelSat && !Descarga.SesionActiva(EmpresaId, PortalSat) && Captcha == "")
            await PedirCaptcha();
    }

    private async Task CambiarPortal(string portal)
    {
        if (PortalSat == portal)
            return;

        PortalSat = portal;
        Resultado = null;
        ErrorSat = "";

        // Cada portal tiene su propio inicio de sesión.
        if (!Descarga.SesionActiva(EmpresaId, PortalSat))
            await PedirCaptcha();
    }

    private async Task PedirCaptcha()
    {
        Trabajando = true;
        Captcha = "";
        TextoCaptcha = "";

        try
        {
            Captcha = await Descarga.ObtenerCaptchaAsync(PortalSat);
        }
        catch (Exception ex)
        {
            ErrorSat = $"No se pudo obtener el captcha del SAT: {ex.Message}";
        }
        finally
        {
            Trabajando = false;
        }
    }

    private async Task TeclaCaptcha(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && TextoCaptcha.Trim() != "" && !Trabajando)
            await Entrar();
    }

    private async Task Entrar()
    {
        Trabajando = true;
        ErrorSat = "";
        Resultado = null;
        MensajeSat = "Iniciando sesión en el SAT…";

        try
        {
            await Descarga.IniciarSesionAsync(EmpresaId, Rfc, TextoCaptcha);
        }
        catch (Exception ex)
        {
            // Cada captcha sirve una vez: se pide otro para el siguiente intento.
            ErrorSat = ex.Message;
            MensajeSat = "";
            await PedirCaptcha();
            return;
        }

        await DescargarAcuses();
    }

    private async Task DescargarAcuses()
    {
        Trabajando = true;
        ErrorSat = "";
        Resultado = null;

        var progreso = new Progress<string>(m =>
        {
            MensajeSat = m;
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            Resultado = await Descarga.DescargarDeclaracionesAsync(EmpresaId, Rfc, Ejercicio, progreso);
            Lista = Archivos.ObtenerDeclaraciones(EmpresaId);
        }
        catch (SesionSatExpiradaException ex)
        {
            ErrorSat = ex.Message;
            await PedirCaptcha();
        }
        catch (Exception ex)
        {
            ErrorSat = $"No se pudieron descargar las declaraciones: {ex.Message}";
        }
        finally
        {
            Trabajando = false;
            MensajeSat = "";
        }
    }

    private async Task Cargar(InputFileChangeEventArgs e)
    {
        Cargando = true;
        Error = "";

        try
        {
            await using Stream origen = e.File.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await origen.CopyToAsync(ms);

            DeclaracionSatDto d = await Task.Run(() =>
                Archivos.CargarDeclaracion(EmpresaId, Rfc, Tipo, Ejercicio, Periodo, ms.ToArray(), e.File.Name));

            Lista = Archivos.ObtenerDeclaraciones(EmpresaId);

            // Un acuse de DIOT cargado aquí se guarda como DIOT y aparece en su tarjeta.
            if (d.Tipo == "DIOT")
                EjercicioDiot = d.Ejercicio;
            else
                Ejercicio = d.Ejercicio;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    /// <summary>La DIOT de cada mes con acuse del ejercicio elegido, reconstruida con los XML de la bóveda.</summary>
    private void CalcularBoveda()
    {
        Bovedas = EmpresaId <= 0
            ? []
            : Diot.Select(d => d.Periodo).Distinct().ToDictionary(m => m, m => DiotBoveda.Calcular(EmpresaId, EjercicioDiot, m));
    }

    private async Task ExcelDiot(DeclaracionSatDto acuse)
    {
        if (!Bovedas.TryGetValue(acuse.Periodo, out DiotBoveda? b))
            return;

        byte[] excel = DiotBoveda.GenerarExcel(Rfc, b, acuse);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"{Rfc} DIOT {acuse.Ejercicio}-{acuse.Periodo:00} conciliacion.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(excel));
    }

    private async Task CargarDiot(InputFileChangeEventArgs e)
    {
        CargandoDiot = true;
        ErrorDiot = "";

        try
        {
            await using Stream origen = e.File.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await origen.CopyToAsync(ms);

            DeclaracionSatDto d = await Task.Run(() =>
                Archivos.CargarDeclaracion(EmpresaId, Rfc, "DIOT", EjercicioDiot, PeriodoDiot, ms.ToArray(), e.File.Name));

            Lista = Archivos.ObtenerDeclaraciones(EmpresaId);
            EjercicioDiot = d.Ejercicio;
            CalcularBoveda();
        }
        catch (Exception ex)
        {
            ErrorDiot = ex.Message;
        }
        finally
        {
            CargandoDiot = false;
        }
    }

    private async Task Eliminar(DeclaracionSatDto d)
    {
        string periodo = d.Tipo == "ANUAL" ? $"anual {d.Ejercicio}" : $"{Mx.DateTimeFormat.GetMonthName(d.Periodo)} {d.Ejercicio}";

        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el acuse de la {(d.Tipo == "DIOT" ? "DIOT" : "declaración")} {periodo}?"))
            return;

        Archivos.EliminarDeclaracion(EmpresaId, d.Id);
        Lista = Archivos.ObtenerDeclaraciones(EmpresaId);
        CalcularBoveda();
    }
}

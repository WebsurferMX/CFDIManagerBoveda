@using CFDIManager.Web.Services
@implements IDisposable
@inject IJSRuntime JS
@inject TemaUi Tema

@* Botón de tema claro/oscuro; la preferencia se guarda en el navegador (js/theme.js) y TemaUi la pasa al tema de
   MudBlazor (MainLayout). *@
<button type="button" class="btn btn-outline-secondary cambiar-tema"
        title="@(Tema.Oscuro ? "Cambiar al modo claro" : "Cambiar al modo oscuro")"
        aria-label="@(Tema.Oscuro ? "Cambiar al modo claro" : "Cambiar al modo oscuro")"
        @onclick="Cambiar">
    <i class="bi @(Tema.Oscuro ? "bi-sun" : "bi-moon-fill")" aria-hidden="true"></i>
</button>

@code {
    protected override void OnInitialized() => Tema.Cambio += Cambio;

    private async Task Cambiar()
    {
        Tema.Establecer(await JS.InvokeAsync<string>("cfdiTheme.toggle") == "dark");
    }

    private void Cambio() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tema.Cambio -= Cambio;
}

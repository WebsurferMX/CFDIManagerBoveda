@inherits LayoutComponentBase
@implements IDisposable

@using CFDIManager.Web.Services
@using CFDIParser.Models

@inject NavigationManager Navigation
@inject AccesoEmpresasService Acceso
@inject EmpresaContext EmpresaContext
@inject TemaUi Tema
@inject IJSRuntime JS

<MudThemeProvider Theme="TemaUi.Tema" IsDarkMode="Tema.Oscuro" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Class="barra-superior">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       title="@(MenuAbierto ? "Contraer menú" : "Expandir menú")"
                       aria-label="@(MenuAbierto ? "Contraer menú" : "Expandir menú")"
                       OnClick="AlternarMenu" />
        <div class="barra-superior-contenido">
            <EmpresaSelector />
        </div>
    </MudAppBar>

    @* Mini: contraído deja solo los iconos. *@
    <MudDrawer Open="MenuAbierto" OpenChanged="MenuCambio" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Never"
               Elevation="2" Class="menu-lateral">
        <MudDrawerHeader Class="menu-lateral-encabezado">
            <a href="" class="menu-lateral-marca" title="CFDI Manager">
                <i class="bi bi-safe2-fill" aria-hidden="true"></i>
                @if (MenuAbierto)
                {
                    <span>CFDI Manager</span>
                }
            </a>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <article class="content px-4">
            @if (SinEmpresas)
            {
                <div class="sin-empresas" role="status">
                    <i class="bi bi-building-lock" aria-hidden="true"></i>
                    No tienes empresas asignadas. Pide al administrador que te asigne al menos una en Configuración → Usuarios.
                </div>
            }

            @Body
        </article>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui"
     data-nosnippet>
    Ocurrió un error inesperado.

    <a href="."
       class="reload">
        Recargar
    </a>

    <span class="dismiss">
        🗙
    </span>
</div>

@code
{
    private bool SinEmpresas;

    private bool MenuAbierto = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Tema y estado del menú guardados en el navegador (js/theme.js).
        Tema.Establecer(await JS.InvokeAsync<string>("cfdiTheme.current") == "dark");
        bool abierto = await JS.InvokeAsync<bool>("cfdiMenu.abierto");

        if (abierto != MenuAbierto)
        {
            MenuAbierto = abierto;
            StateHasChanged();
        }
    }

    private Task AlternarMenu() => MenuCambio(!MenuAbierto);

    private async Task MenuCambio(bool abierto)
    {
        MenuAbierto = abierto;
        await JS.InvokeVoidAsync("cfdiMenu.guardar", abierto);
    }

    protected override async Task OnInitializedAsync()
    {
        EmpresaContext.OnChange += ContextChanged;
        Tema.Cambio += ContextChanged;

        // Con contraseña temporal no se usa la aplicación hasta elegir una personal.
        if ((await Acceso.ObtenerUsuarioActualAsync()).HasClaim(c => c.Type == UsuarioClaimsFactory.DebeCambiarPassword))
        {
            string actual = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"cuenta/cambiar-password?returnUrl={Uri.EscapeDataString(actual)}", forceLoad: true);
            return;
        }

        // Toda carga completa (F5, reconexión fallida, URL escrita) pasa por el prerender estático:
        // ahí se manda siempre al Resumen. Las navegaciones dentro de la app ya son interactivas.
        if (!RendererInfo.IsInteractive)
        {
            string ruta = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

            if (ruta is not "" and not "resumen")
            {
                Navigation.NavigateTo("/");
                return;
            }
        }

        if (EmpresaContext.TieneEmpresaActiva)
            return;

        // Solo empresas asignadas al usuario (el Administrador ve todas).
        List<EmpresaDto> empresas =
            await Acceso.ObtenerEmpresasPermitidasAsync();

        SinEmpresas =
            empresas.Count == 0 &&
            (await Acceso.ObtenerUsuarioActualAsync()).Identity?.IsAuthenticated == true;

        EmpresaDto? empresa =
            empresas.FirstOrDefault();

        if (empresa is not null)
        {
            EmpresaContext.Seleccionar(empresa);
        }
    }

    private void ContextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EmpresaContext.OnChange -= ContextChanged;
        Tema.Cambio -= ContextChanged;
    }
}

@inherits LayoutComponentBase
@implements IDisposable

@using CFDIManager.Web.Services
@using CFDIParser.Models

@inject NavigationManager Navigation
@inject AccesoEmpresasService Acceso
@inject EmpresaContext EmpresaContext

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <EmpresaSelector />
        </div>

        <article class="content px-4">
            @if (SinEmpresas)
            {
                <div class="sin-empresas" role="status">
                    <i class="bi bi-building-lock" aria-hidden="true"></i>
                    No tienes empresas asignadas. Pide al administrador que te asigne al menos una en Configuración → Usuarios.
                </div>
            }

            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui"
     data-nosnippet>
    Ocurrió un error inesperado.

    <a href="."
       class="reload">
        Recargar
    </a>

    <span class="dismiss">
        🗙
    </span>
</div>

@code
{
    private bool SinEmpresas;

    protected override async Task OnInitializedAsync()
    {
        EmpresaContext.OnChange += ContextChanged;

        // Con contraseña temporal no se usa la aplicación hasta elegir una personal.
        if ((await Acceso.ObtenerUsuarioActualAsync()).HasClaim(c => c.Type == UsuarioClaimsFactory.DebeCambiarPassword))
        {
            string actual = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"cuenta/cambiar-password?returnUrl={Uri.EscapeDataString(actual)}", forceLoad: true);
            return;
        }

        // Toda carga completa (F5, reconexión fallida, URL escrita) pasa por el prerender estático:
        // ahí se manda siempre al Resumen. Las navegaciones dentro de la app ya son interactivas.
        if (!RendererInfo.IsInteractive)
        {
            string ruta = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

            if (ruta is not "" and not "resumen")
            {
                Navigation.NavigateTo("/");
                return;
            }
        }

        if (EmpresaContext.TieneEmpresaActiva)
            return;

        // Solo empresas asignadas al usuario (el Administrador ve todas).
        List<EmpresaDto> empresas =
            await Acceso.ObtenerEmpresasPermitidasAsync();

        SinEmpresas =
            empresas.Count == 0 &&
            (await Acceso.ObtenerUsuarioActualAsync()).Identity?.IsAuthenticated == true;

        EmpresaDto? empresa =
            empresas.FirstOrDefault();

        if (empresa is not null)
        {
            EmpresaContext.Seleccionar(empresa);
        }
    }

    private void ContextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        EmpresaContext.OnChange -= ContextChanged;
    }
}

@using CFDIParser.Models
@using CFDIManager.Web.Services

@inject AccesoEmpresasService Acceso
@inject EmpresaContext EmpresaContext

<div class="empresa-selector">
    <label for="empresa-activa">Empresa activa</label>

    <select id="empresa-activa"
            value="@EmpresaContext.EmpresaId"
            @onchange="CambiarEmpresa">

        <option value="0">@(Empresas.Count == 0 ? "Sin empresas asignadas" : "Selecciona un RFC")</option>

        @foreach (var empresa in Empresas)
        {
            <option value="@empresa.EmpresaId">
                @empresa.Rfc · @empresa.NombreParaMostrar
            </option>
        }

    </select>

    <AuthorizeView Policy="@Permisos.OperarCfdi">
        <DescargaSatSwitch />

        <ActualizarIndice />
    </AuthorizeView>

    <CambiarTema />

    <UsuarioMenu />
</div>

@code
{
    // Solo las empresas asignadas al usuario (el Administrador ve todas).
    private List<EmpresaDto> Empresas = new();

    protected override async Task OnInitializedAsync()
    {
        Empresas = await Acceso.ObtenerEmpresasPermitidasAsync();
    }

    private void CambiarEmpresa(ChangeEventArgs args)
    {
        if (!long.TryParse(args.Value?.ToString(), out var empresaId))
            return;

        var empresa = Empresas.FirstOrDefault(
            e => e.EmpresaId == empresaId);

        if (empresa is null)
            return;

        EmpresaContext.Seleccionar(empresa);
    }
}

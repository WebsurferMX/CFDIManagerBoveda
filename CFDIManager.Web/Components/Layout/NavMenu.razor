@implements IDisposable
@inject NavigationManager Navegacion

@* El menú sale del catálogo de tareas (Services\Seguridad\Tareas.cs): cada opción aparece solo si el rol del
   usuario la incluye y no se la quitaron en Configuración → Usuarios. Los iconos son de Bootstrap Icons (clases
   "bi bi-..."): MudBlazor los dibuja como icono de fuente. Estilos en wwwroot/css/layout.css. *@
<MudNavMenu>
    @foreach (Tarea tarea in Tareas.Catalogo)
    {
        <AuthorizeView Policy="@tarea.Politica" Context="permiso">
            @if (tarea.Opciones.Count > 0)
            {
                @* Submenú; abierto cuando la ruta actual es de alguna de sus opciones. *@
                <MudNavGroup Title="@tarea.Nombre" Icon="@Icono(tarea.Icono)" Expanded="@EnRuta(tarea.Ruta)">
                    @foreach (OpcionMenu opcion in tarea.Opciones)
                    {
                        <MudNavLink Href="@Ruta(opcion.Ruta)" Icon="@Icono(opcion.Icono)" title="@opcion.Nombre"
                                    Match="@(opcion.CoincidenciaExacta ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            @opcion.Nombre
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
            else
            {
                <MudNavLink Href="@Ruta(tarea.Ruta)" Icon="@Icono(tarea.Icono)" title="@tarea.Nombre"
                            Match="@(tarea.CoincidenciaExacta ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @tarea.Nombre
                </MudNavLink>
            }
        </AuthorizeView>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized() => Navegacion.LocationChanged += Navego;

    private static string Icono(string icono) => "bi " + icono;

    /// <summary>El Resumen tiene ruta vacía; "./" es la raíz de la app (base href).</summary>
    private static string Ruta(string ruta) => ruta.Length == 0 ? "./" : ruta;

    /// <summary>La ruta actual es la de la tarea o una de sus subrutas.</summary>
    private bool EnRuta(string ruta)
    {
        string actual = Navegacion.ToBaseRelativePath(Navegacion.Uri).Split('?', '#')[0];
        return actual.Equals(ruta, StringComparison.OrdinalIgnoreCase) || actual.StartsWith(ruta + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void Navego(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navegacion.LocationChanged -= Navego;
}

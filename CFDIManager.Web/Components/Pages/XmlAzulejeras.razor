@page "/utilerias/xmlazulejeras"
@attribute [Authorize(Policy = "Tarea:xml-azulejeras")]
@implements IDisposable

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@using CFDIManager.Web.Services
@using CFDIManager.Web.Services.Sinube
@using CFDIParser.Models

@inject XmlAzulejerasService Servicio
@inject SinubeService Sinube
@inject SinubeDatosService DatosSinube
@inject EmpresaContext EmpresaContext
@inject IJSRuntime JS
@inject PeriodoTrabajoService Periodo

<PageTitle>XML Azulejeras (Clientes)</PageTitle>

<div class="export-page">

    <header class="page-heading">
        <div>
            <span class="eyebrow">CFDI MANAGER</span>
            <h1>XML Azulejeras (Clientes)</h1>
        </div>
    </header>

    @if (!EmpresaContext.TieneEmpresaActiva)
    {
        <section class="message error-message">
            <strong>No hay empresa seleccionada.</strong>
            <span>Selecciona una empresa antes de continuar.</span>
        </section>
    }
    else
    {
        <section class="company-card">
            <div>
                <span class="company-label">EMPRESA ACTIVA</span>
                <strong>
                    @EmpresaContext.Rfc · @EmpresaContext.NombreEmpresa
                </strong>
            </div>
        </section>

        @if (!EsEmpresaAzulejera())
        {
            <section class="message error-message">
                <strong>Sin equivalencias.</strong>
                <span>Esta empresa no tiene series de mostrador configuradas para XML Azulejeras (Clientes).</span>
            </section>
        }
        else
        {
            <section class="export-card">
                <div class="date-range-card">
                    <div class="date-field">
                        <label>📅 Desde</label>
                        <FechaInput @bind-Valor="FechaInicio" />
                    </div>

                    <div class="date-arrow">➜</div>

                    <div class="date-field">
                        <label>📅 Hasta</label>
                        <FechaInput @bind-Valor="FechaFin" />
                    </div>
                </div>

                <div class="export-actions">
                    <button type="button" class="secondary-button" @onclick="Restablecer" disabled="@Ocupado">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Restablecer</span>
                    </button>

                    <button type="button" class="secondary-button" @onclick="Analizar" disabled="@(Ocupado || FechaFin.Date < FechaInicio.Date)">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>@(Analizando ? "Analizando..." : "Analizar")</span>
                    </button>

                    <button type="button" class="primary-button" @onclick="GenerarZip" disabled="@(!PuedeGenerar)"
                            title="@(Series is null ? "Primero analiza el periodo" : SeriesElegidas.Count == 0 ? "Elige al menos una serie" : "")">
                        @if (Generando)
                        {
                            <i class="bi bi-hourglass-split"></i>
                            <span>Generando...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-zip-fill"></i>
                            <span>Generar XML Azulejeras</span>
                        }
                    </button>
                </div>
            </section>
        }
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <section class="message error-message">
            <strong>Error</strong>
            <span>@Error</span>
        </section>
    }

    @if (Series is not null)
    {
        List<SerieAzulejeraDto> elegidas = Series.Where(s => SeriesElegidas.Contains(s.Serie)).ToList();

        <div class="card shadow-sm border-primary-subtle mb-3">
            <div class="card-header bg-primary-subtle d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                <div class="fw-semibold">
                    <i class="bi bi-bar-chart-line me-1"></i>Análisis del periodo
                    <span class="text-body-secondary fw-normal small ms-1">
                        @FechaInicio.ToString("dd/MM/yyyy") – @FechaFin.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-2 small">
                    <span class="badge rounded-pill text-bg-secondary">@Series.Sum(s => s.Total).ToString("N0") emitidos</span>
                    <span class="badge rounded-pill text-bg-secondary">@Series.Count serie(s)</span>
                    <span class="badge rounded-pill text-bg-primary">Se modificarán @elegidas.Sum(s => s.PublicoGeneral).ToString("N0")</span>
                    <span class="badge rounded-pill text-bg-success">@Moneda(elegidas.Sum(s => s.ImportePublicoGeneral))</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 4rem">
                                <input type="checkbox" class="form-check-input" title="Marcar todas" disabled="@Ocupado"
                                       checked="@(Convertibles.Any() && Convertibles.All(s => SeriesElegidas.Contains(s.Serie)))"
                                       @onchange="e => ElegirTodas(e.Value is true)" />
                            </th>
                            <th>Serie</th>
                            @foreach (string tipo in TiposPresentes)
                            {
                                <th class="text-end" title="@NombreTipo(tipo)">@NombreTipo(tipo)</th>
                            }
                            <th class="text-end">Total</th>
                            <th class="text-end">Público general</th>
                            <th class="text-end">Importe público general</th>
                            <th>Se convierte a</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (SerieAzulejeraDto s in Series)
                        {
                            bool convertible = s.TieneEquivalencia && s.PublicoGeneral > 0;

                            <tr class="@(convertible ? "" : "text-body-secondary")">
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" disabled="@(!convertible || Ocupado)"
                                           checked="@SeriesElegidas.Contains(s.Serie)"
                                           @onchange="e => ElegirSerie(s.Serie, e.Value is true)" />
                                </td>
                                <td><span class="badge text-bg-light border fs-6">@(s.Serie == "" ? "(sin serie)" : s.Serie)</span></td>
                                @foreach (string tipo in TiposPresentes)
                                {
                                    <td class="text-end">@(s.PorTipo.GetValueOrDefault(tipo) is int n and > 0 ? n.ToString("N0") : "—")</td>
                                }
                                <td class="text-end fw-semibold">@s.Total.ToString("N0")</td>
                                <td class="text-end fw-semibold text-primary-emphasis">@s.PublicoGeneral.ToString("N0")</td>
                                <td class="text-end">@Moneda(s.ImportePublicoGeneral)</td>
                                <td>
                                    @if (s.TieneEquivalencia)
                                    {
                                        <i class="bi bi-arrow-right text-body-secondary me-1"></i>
                                        <span class="badge text-bg-primary">@s.SerieNueva</span>
                                        <span class="small ms-1">@s.NombreReceptor</span>
                                    }
                                    else
                                    {
                                        <span class="small fst-italic">Sin equivalencia: no se modifica</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td></td>
                            <td>Total</td>
                            @foreach (string tipo in TiposPresentes)
                            {
                                <td class="text-end">@Series.Sum(s => s.PorTipo.GetValueOrDefault(tipo)).ToString("N0")</td>
                            }
                            <td class="text-end">@Series.Sum(s => s.Total).ToString("N0")</td>
                            <td class="text-end">@Series.Sum(s => s.PublicoGeneral).ToString("N0")</td>
                            <td class="text-end">@Moneda(Series.Sum(s => s.ImportePublicoGeneral))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    @if (Resultado is not null)
    {
        <div class="row g-2 mb-3">
            @Tarjeta("Leídos", Resultado.Leidos.ToString("N0"), "bi-files", "secondary")
            @Tarjeta("Modificados", Resultado.Modificados.ToString("N0"), "bi-pencil-square", "primary")
            @Tarjeta("Sin cambio", Resultado.SinCambios.ToString("N0"), "bi-dash-circle", "secondary")
            @Tarjeta("Errores", Resultado.Errores.ToString("N0"), "bi-exclamation-triangle", Resultado.Errores > 0 ? "danger" : "secondary")
            @Tarjeta("Importe total", Moneda(Resultado.ImporteTotal), "bi-cash-stack", "secondary", ancho: "col-md-4")
            @Tarjeta("Con cambio", Moneda(Resultado.ImporteModificados), "bi-cash-coin", "primary", ancho: "col-md-4")
            @Tarjeta("Sin cambio", Moneda(Resultado.ImporteSinCambios), "bi-cash", "secondary", ancho: "col-md-4")
        </div>

        @if (Resultado.Archivos.Count > 0)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                    <div class="fw-semibold"><i class="bi bi-cloud-arrow-up me-1"></i>Importación a SINUBE</div>
                    <span class="badge rounded-pill text-bg-secondary">@Resultado.Archivos.Count.ToString("N0") XML generados</span>
                </div>

                <div class="card-body">
                    @if (FaltaSinube is not null)
                    {
                        <div class="alert alert-warning small mb-0">
                            @FaltaSinube Configúralo en <a href="exportacion-sinube" class="alert-link">Importación a SINUBE</a>.
                        </div>
                    }
                    else if (ConfigSinube is not null)
                    {
                        <div class="card mb-3">
                            <div class="card-header py-2 small fw-semibold">
                                <i class="bi bi-sliders me-1"></i>Parámetros · facturas de clientes
                                <span class="text-body-secondary fw-normal ms-2">
                                    @ConfigSinube.Empresa · @ConfigSinube.Sucursal · @ConfigSinube.Ambiente
                                </span>
                            </div>
                            <div class="card-body small row g-3">
                                <div class="col-lg-6">
                                    <div class="fw-semibold mb-1">Identificación de productos</div>
                                    @foreach ((string modo, string texto) in ModosProducto)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="modoProducto" id="modo-@modo"
                                                   checked="@(ConfigSinube.ModoProducto == modo)" disabled="@Subiendo"
                                                   @onchange="() => CambiarModo(modo)" />
                                            <label class="form-check-label" for="modo-@modo">@texto</label>
                                        </div>
                                    }
                                </div>
                                <div class="col-lg-6">
                                    <div class="fw-semibold mb-1">Opciones</div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="serieFolio" @bind="ConfigSinube.SerieFolioDeFolio" disabled="@Subiendo" />
                                        <label class="form-check-label" for="serieFolio">Obtener serie/folio del atributo Folio cuando vienen concatenados</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="agrupar" @bind="ConfigSinube.AgruparCodigoSat" disabled="@Subiendo" />
                                        <label class="form-check-label" for="agrupar">Agrupar por código SAT en facturas de más de 200 conceptos</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="productoClientes" @bind="ConfigSinube.UsarProductoClientes" disabled="@Subiendo" />
                                        <label class="form-check-label" for="productoClientes">Sustituir NoIdentificacion por producto del catálogo de clientes</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="ieps" @bind="ConfigSinube.ValidarIeps" disabled="@Subiendo" />
                                        <label class="form-check-label" for="ieps">Revisar productos con IEPS antes de enviar</label>
                                    </div>
                                    @if (ConfigSinube.ValidarIeps)
                                    {
                                        <div class="form-check ms-4">
                                            <input class="form-check-input" type="checkbox" id="conIeps" @bind="EnviarConIeps" disabled="@Subiendo" />
                                            <label class="form-check-label" for="conIeps">Enviar aunque haya productos sin tasa IEPS en SINUBE</label>
                                        </div>
                                    }
                                    @if (Resultado.SinNoIdentificacion > 0 && ConfigSinube.ModoProducto != SinubeModosProducto.OmitirNoIdentificacion)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="anticipos" @bind="AnticiposConCodigoGenerico" disabled="@Subiendo" />
                                            <label class="form-check-label" for="anticipos">
                                                Anticipos sin NoIdentificacion (@Resultado.SinNoIdentificacion.ToString("N0")) con código genérico
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                            <button type="button" class="btn btn-outline-primary" @onclick="RevisarSinube" disabled="@Ocupado">
                                @if (Revisando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span><span>Revisando…</span>
                                }
                                else
                                {
                                    <i class="bi bi-search me-1"></i><span>Revisar en SINUBE</span>
                                }
                            </button>

                            @if (Subiendo)
                            {
                                <button type="button" class="btn btn-outline-danger" @onclick="() => CancelacionSinube?.Cancel()">
                                    <i class="bi bi-stop-circle me-1"></i>Detener
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" @onclick="SubirASinube"
                                        disabled="@(Ocupado || Revision is null || Revision.PorSubir.Count == 0)">
                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i>
                                    Subir @((Revision?.PorSubir.Count ?? 0).ToString("N0")) a SINUBE
                                </button>
                            }
                        </div>

                        @if (Subiendo)
                        {
                            int porcentaje = Revision is { PorSubir.Count: > 0 } r ? Procesados * 100 / r.PorSubir.Count : 0;

                            <div class="progress mb-3" role="progressbar" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100" style="height: 1.25rem">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @porcentaje%">
                                    @Procesados.ToString("N0") / @Revision!.PorSubir.Count.ToString("N0")
                                </div>
                            </div>
                        }

                        @if (Revision is not null && Envios.Count == 0)
                        {
                            <div class="row g-2">
                                @Tarjeta("Generados", Resultado.Archivos.Count.ToString("N0"), "bi-files", "secondary")
                                @Tarjeta("Ya en SINUBE", Revision.EnSinube.ToString("N0"), "bi-cloud-check", "info")
                                @Tarjeta("Enviados antes", Revision.EnviadosAntes.ToString("N0"), "bi-clock-history", "secondary")
                                @Tarjeta("Por subir", Revision.PorSubir.Count.ToString("N0"), "bi-cloud-arrow-up", "primary",
                                    detalle: AnticiposPorSubir.Count > 0 ? $"{AnticiposPorSubir.Count:N0} anticipos con código genérico" : null)
                            </div>
                        }
                    }
                </div>
            </div>

            @if (Envios.Count > 0)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                        <div class="fw-semibold"><i class="bi bi-journal-text me-1"></i>Bitácora de SINUBE</div>
                        <div class="btn-group btn-group-sm" role="group">
                            @foreach ((string clave, string texto) in FiltrosBitacora)
                            {
                                <button type="button" class="btn @(FiltroBitacora == clave ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => FiltroBitacora = clave">
                                    @texto <span class="badge text-bg-light ms-1">@ContarFiltro(clave).ToString("N0")</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="card-body pb-0">
                        <div class="row g-2 mb-3">
                            @Tarjeta("Subidos", Contar("OK").ToString("N0"), "bi-check-circle", "success")
                            @Tarjeta("Ya existían", Contar("EXISTE").ToString("N0"), "bi-cloud-check", "info")
                            @Tarjeta("Descartados", Descartados.ToString("N0"), "bi-x-circle", Descartados > 0 ? "warning" : "secondary",
                                detalle: string.Join(" · ", new[] { "OMITIDO", "IEPS", "INVALIDO", "ERROR" }.Where(e => Contar(e) > 0).Select(e => $"{TextoEstatus(e)}: {Contar(e):N0}")))
                            @Tarjeta("Procesados", Envios.Count.ToString("N0"), "bi-list-check", "secondary")
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height: 480px">
                        <table class="table table-sm table-striped table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr><th class="text-end">#</th><th>Serie-Folio</th><th>UUID</th><th>Estatus</th><th>Mensaje</th></tr>
                            </thead>
                            <tbody>
                                @foreach ((SinubeEnvioDto envio, int numero) in EnviosFiltrados)
                                {
                                    <tr>
                                        <td class="text-end text-body-secondary small">@numero</td>
                                        <td class="text-nowrap fw-semibold">@envio.Serie @envio.Folio</td>
                                        <td class="font-monospace small">@envio.Uuid</td>
                                        <td><span class="badge @ClaseEstatus(envio.Estatus)">@TextoEstatus(envio.Estatus)</span></td>
                                        <td class="small">@envio.Mensaje</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (Resultado.Detalles.Count > 0)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex align-items-center justify-content-between py-2">
                    <div class="fw-semibold"><i class="bi bi-list-ul me-1"></i>XML modificados</div>
                    <span class="badge rounded-pill text-bg-secondary">@Resultado.Detalles.Count.ToString("N0")</span>
                </div>
                <div class="table-responsive" style="max-height: 480px">
                    <table class="table table-sm table-striped table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Fecha</th><th>Tipo</th><th>Serie</th><th>Nueva serie</th><th>Cliente</th><th class="text-end">Total</th><th>UUID</th><th>Resultado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Resultado.Detalles)
                            {
                                <tr>
                                    <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge text-bg-light border">@NombreTipo(item.TipoCfdi)</span></td>
                                    <td>@item.SerieOriginal</td>
                                    <td><span class="badge text-bg-primary">@item.SerieNueva</span></td>
                                    <td class="small">@item.NombreNuevo</td>
                                    <td class="text-end">@Moneda(item.Total)</td>
                                    <td class="font-monospace small">@item.UUID</td>
                                    <td>
                                        @if (item.Resultado == "MODIFICADO")
                                        {
                                            <span class="badge text-bg-success">Modificado</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger" title="@item.Resultado">Error</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

</div>

@code
{
    private DateTime FechaInicio { get; set; }

    private DateTime FechaFin { get; set; }

    private bool Analizando;
    private bool Generando;
    private bool Subiendo;
    private bool Ocupado => Analizando || Generando || Subiendo || Revisando;

    private string? Error { get; set; }

    private List<SerieAzulejeraDto>? Series;
    private HashSet<string> SeriesElegidas = new(StringComparer.OrdinalIgnoreCase);

    private XmlAzulejerasResultado? Resultado;

    private List<SinubeEnvioDto> Envios = [];
    private int Procesados;
    private CancellationTokenSource? CancelacionSinube;
    private string? FaltaSinube;
    private SinubeConfiguracionDto? ConfigSinube;
    private bool EnviarConIeps;
    private bool AnticiposConCodigoGenerico = true;

    private static readonly (string Modo, string Texto)[] ModosProducto =
    [
        (SinubeModosProducto.NoIdentificacion, "Usar NoIdentificacion del CFDI"),
        (SinubeModosProducto.OmitirNoIdentificacion, "Omitir NoIdentificacion y usar un solo código genérico"),
        (SinubeModosProducto.CodigoSat6, "Usar código prod. SAT a 6 posiciones (3.3 / 4.0)"),
        (SinubeModosProducto.CodigoSatComoViene, "Usar código prod. SAT como viene en el CFDI (3.3 / 4.0)")
    ];

    private static readonly string[] OrdenTipos = ["I", "E", "P", "T", "N"];

    private IEnumerable<string> TiposPresentes =>
        OrdenTipos.Where(t => Series?.Any(s => s.PorTipo.ContainsKey(t)) == true)
            .Concat(Series?.SelectMany(s => s.PorTipo.Keys).Distinct().Where(t => !OrdenTipos.Contains(t)) ?? []);

    private static string NombreTipo(string tipo) => tipo switch
    {
        "I" => "Ingreso",
        "E" => "Egreso",
        "P" => "Pago",
        "T" => "Traslado",
        "N" => "Nómina",
        _ => tipo
    };

    private bool EsEmpresaAzulejera() =>
        EmpresaContext.EmpresaActiva is not null && XmlAzulejerasService.EsAzulejera(EmpresaContext.EmpresaActiva.Rfc);

    private static string Moneda(decimal importe) => importe.ToString("C2");

    private bool PuedeGenerar =>
        EmpresaContext.TieneEmpresaActiva &&
        EsEmpresaAzulejera() &&
        Series is not null &&
        SeriesElegidas.Count > 0 &&
        FechaFin.Date >= FechaInicio.Date &&
        !Ocupado;

    protected override void OnInitialized()
    {
        FechaInicio = Periodo.Inicio;
        FechaFin = Periodo.Fin;

        EmpresaContext.OnChange += EmpresaCambio;
    }

    private async Task Analizar()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        Error = null;
        Resultado = null;
        Envios = [];
        Revision = null;
        Analizando = true;

        try
        {
            Series = await Task.Run(() => Servicio.Analizar(empresa, FechaInicio, FechaFin));

            // Por omisión, todas las series que se pueden convertir.
            SeriesElegidas = Series.Where(s => s.TieneEquivalencia && s.PublicoGeneral > 0)
                .Select(s => s.Serie).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Analizando = false;
        }
    }

    private IEnumerable<SerieAzulejeraDto> Convertibles =>
        Series?.Where(s => s.TieneEquivalencia && s.PublicoGeneral > 0) ?? [];

    private void ElegirTodas(bool incluir) =>
        SeriesElegidas = incluir
            ? Convertibles.Select(s => s.Serie).ToHashSet(StringComparer.OrdinalIgnoreCase)
            : new(StringComparer.OrdinalIgnoreCase);

    private void ElegirSerie(string serie, bool incluir)
    {
        if (incluir)
            SeriesElegidas.Add(serie);
        else
            SeriesElegidas.Remove(serie);
    }

    private async Task GenerarZip()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        Error = null;
        Resultado = null;
        Envios = [];
        Revision = null;
        Generando = true;

        try
        {
            var series = SeriesElegidas.ToHashSet(StringComparer.OrdinalIgnoreCase);
            Resultado = await Task.Run(() => Servicio.GenerarZip(empresa, FechaInicio, FechaFin, series));

            ConfigSinube = Sinube.ObtenerConfiguracion(empresa);
            FaltaSinube = SinubeService.FaltanDatos(ConfigSinube, requierePassword: true);

            if (Resultado.Archivos.Count > 0)
            {
                await JS.InvokeVoidAsync(
                    "descargarArchivoBase64",
                    Resultado.NombreArchivo,
                    Resultado.TipoContenido,
                    Convert.ToBase64String(Resultado.Contenido));
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Generando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Sube los XML modificados con el proceso de Importación a SINUBE (facturas de clientes).</summary>
    private async Task SubirASinube()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa || Resultado is null || ConfigSinube is null)
            return;

        if (Revision is null || Revision.PorSubir.Count == 0)
            return;

        Error = null;
        Envios = [];
        Procesados = 0;
        Subiendo = true;
        CancelacionSinube = new CancellationTokenSource();

        try
        {
            // Los parámetros elegidos aquí quedan guardados, igual que en Importación a SINUBE.
            SinubeConfiguracionDto configuracion = ConfigSinube;
            Sinube.GuardarConfiguracion(configuracion, null);
            List<string> archivos = Revision.PorSubir;
            HashSet<string> yaEnSinube = Revision.YaEnSinube;
            List<string> anticipos = AnticiposPorSubir;

            var tandas = new List<(List<string> Archivos, SinubeConfiguracionDto Configuracion)>
            {
                (archivos.Except(anticipos).ToList(), configuracion)
            };

            if (anticipos.Count > 0)
            {
                // Copia solo para esta tanda: no cambia el parámetro guardado.
                SinubeConfiguracionDto generico = System.Text.Json.JsonSerializer.Deserialize<SinubeConfiguracionDto>(
                    System.Text.Json.JsonSerializer.Serialize(configuracion))!;
                generico.ModoProducto = SinubeModosProducto.OmitirNoIdentificacion;
                tandas.Add((anticipos, generico));
            }

            int previos = 0;

            foreach ((List<string> tanda, SinubeConfiguracionDto config) in tandas.Where(t => t.Archivos.Count > 0))
            {
                int desplazamiento = previos;

                await Task.Run(() => Sinube.EnviarArchivosAsync(
                    empresa,
                    config,
                    clientes: true,
                    tanda,
                    tiposComprobante: null,
                    reenviar: false,
                    enviarConAdvertenciaIeps: EnviarConIeps,
                    (envio, actual, total) => InvokeAsync(() =>
                    {
                        if (config != configuracion && envio.Estatus == "OK")
                            envio.Mensaje = $"{envio.Mensaje} (anticipo: código genérico)".Trim();

                        Envios.Add(envio);
                        Procesados = desplazamiento + actual;
                        StateHasChanged();
                    }),
                    CancelacionSinube.Token,
                    sinFolio: null,
                    yaEnSinube));

                previos += tanda.Count;
            }
        }
        catch (OperationCanceledException)
        {
            Error = $"Proceso detenido. Se procesaron {Procesados:N0} de {Revision.PorSubir.Count:N0} XML.";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Subiendo = false;
            CancelacionSinube?.Dispose();
            CancelacionSinube = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Lo que ya tiene SINUBE (consulta por mes) y lo ya enviado desde la app; el resto queda por subir.</summary>
    private sealed class RevisionSinube
    {
        public HashSet<string> YaEnSinube { get; init; } = new(StringComparer.OrdinalIgnoreCase);
        public int EnSinube { get; init; }
        public int EnviadosAntes { get; init; }
        public List<string> PorSubir { get; init; } = [];
    }

    private RevisionSinube? Revision;
    private bool Revisando;

    private List<string> AnticiposPorSubir =>
        Revision is not null && Resultado is not null && ConfigSinube is not null &&
        AnticiposConCodigoGenerico && ConfigSinube.ModoProducto != SinubeModosProducto.OmitirNoIdentificacion
            ? Revision.PorSubir.Where(Resultado.ArchivosSinNoIdentificacion.Contains).ToList()
            : [];

    private void CambiarModo(string modo)
    {
        if (ConfigSinube is not null)
            ConfigSinube.ModoProducto = modo;
    }

    private async Task RevisarSinube()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa || Resultado is null || ConfigSinube is null)
            return;

        Error = null;
        Envios = [];
        Revision = null;
        Revisando = true;

        try
        {
            var meses = new List<DateTime>();
            for (var m = new DateTime(FechaInicio.Year, FechaInicio.Month, 1); m <= FechaFin; m = m.AddMonths(1))
                meses.Add(m);

            HashSet<string> enSinube = await DatosSinube.UuidsFacturasClientesAsync(ConfigSinube, meses);
            HashSet<string> enviados = Sinube.UuidsEnviados(empresa, clientes: true);

            string Uuid(string archivo) => Path.GetFileNameWithoutExtension(archivo);

            Revision = new RevisionSinube
            {
                YaEnSinube = enSinube,
                EnSinube = Resultado.Archivos.Count(a => enSinube.Contains(Uuid(a))),
                EnviadosAntes = Resultado.Archivos.Count(a => !enSinube.Contains(Uuid(a)) && enviados.Contains(Uuid(a))),
                PorSubir = Resultado.Archivos.Where(a => !enSinube.Contains(Uuid(a)) && !enviados.Contains(Uuid(a))).ToList()
            };
        }
        catch (Exception ex)
        {
            Error = $"No se pudo consultar SINUBE: {ex.Message}";
        }
        finally
        {
            Revisando = false;
        }
    }

    // ---------- presentación ----------

    private string FiltroBitacora = "todos";

    private static readonly (string Clave, string Texto)[] FiltrosBitacora =
        [("todos", "Todos"), ("OK", "Subidos"), ("EXISTE", "Ya existían"), ("descartados", "Descartados")];

    private bool PasaFiltro(SinubeEnvioDto e) => FiltroBitacora switch
    {
        "todos" => true,
        "descartados" => e.Estatus is not ("OK" or "EXISTE"),
        _ => e.Estatus == FiltroBitacora
    };

    private int ContarFiltro(string clave) => clave switch
    {
        "todos" => Envios.Count,
        "descartados" => Descartados,
        _ => Contar(clave)
    };

    private IEnumerable<(SinubeEnvioDto Envio, int Numero)> EnviosFiltrados =>
        Envios.Select((e, i) => (e, i + 1)).Where(x => PasaFiltro(x.e)).Reverse().Take(1000);

    /// <summary>Tarjeta de total con Bootstrap.</summary>
    private static RenderFragment Tarjeta(string titulo, string valor, string icono, string color,
        string ancho = "col-6 col-md-3", string? detalle = null) => __builder =>
    {
        <div class="@ancho">
            <div class="card h-100 border-@color-subtle shadow-sm">
                <div class="card-body py-2 d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-@color-subtle text-@color-emphasis d-flex align-items-center justify-content-center"
                         style="width: 2.5rem; height: 2.5rem">
                        <i class="bi @icono fs-5"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="small text-body-secondary">@titulo</div>
                        <div class="fs-5 fw-semibold text-@color-emphasis">@valor</div>
                        @if (!string.IsNullOrEmpty(detalle))
                        {
                            <div class="small text-body-secondary text-truncate" title="@detalle">@detalle</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    };

    private int Contar(string estatus) => Envios.Count(e => e.Estatus == estatus);

    private int Descartados => Envios.Count(e => e.Estatus is not ("OK" or "EXISTE"));

    private static string TextoEstatus(string estatus) => estatus switch
    {
        "OK" => "Subido",
        "EXISTE" => "Ya existía",
        "OMITIDO" => "Omitido",
        "IEPS" => "Revisar IEPS",
        "INVALIDO" => "XML inválido",
        "ERROR" => "Error",
        _ => estatus
    };

    private static string ClaseEstatus(string estatus) => estatus switch
    {
        "OK" => "text-bg-success",
        "EXISTE" => "text-bg-info",
        "OMITIDO" => "text-bg-secondary",
        "IEPS" => "text-bg-warning",
        _ => "text-bg-danger"
    };

    private void Restablecer()
    {
        FechaInicio = Periodo.Inicio;
        FechaFin = Periodo.Fin;

        Error = null;
        Series = null;
        SeriesElegidas.Clear();
        Resultado = null;
        Envios = [];
        Revision = null;
    }

    private void EmpresaCambio()
    {
        _ = InvokeAsync(() =>
        {
            Series = null;
            SeriesElegidas.Clear();
            Resultado = null;
            Envios = [];
        Revision = null;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        CancelacionSinube?.Cancel();
        EmpresaContext.OnChange -= EmpresaCambio;
    }
}

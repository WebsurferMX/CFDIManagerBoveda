@page "/conciliacion-sinube"
@attribute [Authorize(Policy = "Tarea:conciliacion-sinube")]
@implements IDisposable

@using System.Globalization
@using CFDIManager.Web.Services
@using CFDIManager.Web.Services.Correo
@using CFDIManager.Web.Services.Sinube
@using CFDIParser.Models

@inject EmpresaContext EmpresaContext
@inject ConciliacionSinubeService Conciliacion
@inject SinubeService Sinube
@inject SatMetadatosService MetadatosSat
@inject IJSRuntime JS
@inject PeriodoTrabajoService Periodo

<PageTitle>Conciliación SINUBE vs SAT</PageTitle>

<div class="conciliacion-page d-flex flex-column gap-3 pb-4">
    <header class="d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <span class="eyebrow">SINUBE</span>
            <h1 class="h2 mb-1">Conciliación SINUBE vs SAT</h1>
            <p class="text-body-secondary mb-0">
                Cruza por UUID lo que tiene el SAT (metadatos de la descarga masiva), los XML de la bóveda y lo registrado en SINUBE.
            </p>
        </div>
    </header>

    @if (!EmpresaContext.TieneEmpresaActiva)
    {
        <div class="alert alert-warning mb-0">Selecciona una empresa activa.</div>
    }
    else
    {
        @if (FaltaConfiguracion is not null)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                <i class="bi bi-plug fs-5"></i>
                <span>
                    @FaltaConfiguracion
                    Configúralo en <a href="exportacion-sinube" class="alert-link">Exportación a SINUBE</a> (usuario y contraseña del portal).
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger alert-dismissible d-flex align-items-center gap-2 mb-0" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                <span>@Error</span>
                <button type="button" class="btn-close" @onclick="() => Error = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Mensaje))
        {
            <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2 mb-0" role="status">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>@Mensaje</span>
                <button type="button" class="btn-close" @onclick="() => Mensaje = null"></button>
            </div>
        }

        @* ---------- Periodo ---------- *@
        <div class="card shadow-sm">
            <div class="card-body d-flex flex-wrap align-items-end gap-3">
                <div>
                    <span class="form-label small fw-semibold mb-1 d-block">Comprobantes</span>
                    <div class="btn-group" role="group" aria-label="Tipo de conciliación">
                        <button type="button" class="btn @(Tipo == TipoConciliacion.Proveedores ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => CambiarTipo(TipoConciliacion.Proveedores)" disabled="@Procesando">
                            <i class="bi bi-box-arrow-in-down-left me-1"></i>Proveedores
                        </button>
                        <button type="button" class="btn @(Tipo == TipoConciliacion.Clientes ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => CambiarTipo(TipoConciliacion.Clientes)" disabled="@Procesando">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Clientes
                        </button>
                    </div>
                </div>

                <div>
                    <label class="form-label small fw-semibold mb-1" for="anio">Año</label>
                    <select id="anio" class="form-select" @bind="Anio">
                        @for (int a = DateTime.Today.Year; a >= DateTime.Today.Year - 6; a--)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label small fw-semibold mb-1" for="mes">Mes</label>
                    <select id="mes" class="form-select" @bind="Mes">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@m.ToString("00") · @Mx.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </div>

                <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" @onclick="Conciliar" disabled="@(Procesando || ActualizandoSat || FaltaConfiguracion is not null)">
                    @if (Procesando)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>Conciliando…</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Carga y analiza</span>
                    }
                </button>

                @if (Resultado is not null)
                {
                    <div class="ms-auto d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-success" @onclick="DescargarExcel"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
                        <button type="button" class="btn btn-outline-primary" @onclick="PrepararCorreo"><i class="bi bi-envelope-paper me-1"></i>Enviar por correo</button>
                    </div>
                }
            </div>
        </div>

        @* ---------- Fuente SAT: metadatos de la descarga masiva ---------- *@
        @if (ActualizandoSat)
        {
            <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 mb-0">
                <span class="spinner-border spinner-border-sm"></span>
                <span class="flex-grow-1">@ProgresoSat</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => CancelacionSat?.Cancel()">Dejar de esperar</button>
            </div>
        }
        else if (Resultado is not null)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 px-1 small fuente-sat">
                @if (Resultado.MetadatosSat is { } m)
                {
                    <i class="bi bi-patch-check-fill text-success"></i>
                    <span>
                        <b>SAT:</b> metadatos de la descarga masiva al @m.Consultado.ToString("dd/MM/yyyy HH:mm") · @m.Registros.ToString("N0") CFDI
                        @if (m.CubreHasta < new DateTime(Resultado.Anio, Resultado.Mes, 1).AddMonths(1).AddSeconds(-1))
                        {
                            <text> · cubre hasta @m.CubreHasta.ToString("dd/MM HH:mm")</text>
                        }
                    </span>
                }
                else
                {
                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                    <span><b>SAT:</b> sin metadatos de este mes; la existencia y el estatus salen de la bóveda.</span>
                }

                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ActualizarSat" disabled="@Procesando">
                    <i class="bi bi-cloud-arrow-down me-1"></i>@(Resultado.MetadatosSat is null ? "Solicitar al SAT" : "Actualizar del SAT")
                </button>

                @if (UuidsSinXml.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-warning" @onclick="DescargarFaltantes" disabled="@Procesando"
                            title="Descarga del SAT los XML que faltan en la bóveda, incluidos los cancelados">
                        <i class="bi bi-download me-1"></i>Descargar @UuidsSinXml.Count.ToString("N0") XML faltantes
                        @if (CanceladosSinXml > 0)
                        {
                            <span class="badge text-bg-danger ms-1">@CanceladosSinXml cancelados</span>
                        }
                    </button>
                }

                <span class="ms-auto text-body-secondary">Conciliado en @Resultado.Duracion.TotalSeconds.ToString("N1") s</span>
            </div>
        }

        @if (Resultado is not null)
        {
            @* ---------- Indicadores (también filtran) ---------- *@
            <div class="row g-2">
                @foreach (var (clave, titulo, valor, icono, color) in Indicadores)
                {
                    <div class="col-6 col-md-4 col-xl">
                        <button type="button" class="card shadow-sm h-100 w-100 text-start indicador @(Vista == clave ? "activo" : "")" @onclick="() => Vista = Vista == clave ? Vistas.Todos : clave">
                            <span class="card-body d-flex align-items-center gap-2 p-2">
                                <span class="indicador-icono text-@color bg-@color-subtle"><i class="bi @icono"></i></span>
                                <span>
                                    <span class="d-block small text-body-secondary lh-sm">@titulo</span>
                                    <span class="d-block fs-5 fw-bold lh-sm">@valor.ToString("N0")</span>
                                </span>
                            </span>
                        </button>
                    </div>
                }
            </div>

            @* ---------- Tabla ---------- *@
            <div class="card shadow-sm">
                <div class="card-header bg-body d-flex flex-wrap align-items-center gap-3 py-2">
                    <div class="me-auto">
                        <span class="eyebrow">@(Resultado.Tipo == TipoConciliacion.Clientes ? "COMPROBANTES DE CLIENTES" : "COMPROBANTES DE PROVEEDORES")</span>
                        <div class="small text-body-secondary">
                            Periodo <b>@Resultado.Anio@Resultado.Mes.ToString("00")</b> · consultado @Resultado.Fecha.ToString("dd/MM/yyyy HH:mm")
                            @if (Resultado.NominasOmitidas > 0)
                            {
                                <span title="SINUBE lleva la nómina en otra entidad; aquí se concilian facturas y notas de crédito.">
                                    · <i class="bi bi-info-circle"></i> @Resultado.NominasOmitidas.ToString("N0") recibos de nómina no se concilian
                                </span>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="no-conciliadas" @bind="SoloNoConciliadas" />
                        <label class="form-check-label small" for="no-conciliadas">Mostrar solo no conciliadas</label>
                    </div>

                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="no-contabilizadas" @bind="NoContabilizadas" />
                        <label class="form-check-label small" for="no-contabilizadas">No contabilizadas</label>
                    </div>

                    <div class="input-group input-group-sm buscador">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="Razón social, RFC, UUID o folio" @bind="Busqueda" @bind:event="oninput" />
                    </div>
                </div>

                <div class="table-responsive tabla-contenedor">
                    <table class="table table-sm table-hover align-middle mb-0 tabla-conciliacion">
                        <thead>
                            <tr>
                                <th>Razón social</th>
                                <th>Fecha emisión</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Conciliada</th>
                                <th class="text-center">Existe en SAT</th>
                                <th class="text-center">XML en bóveda</th>
                                <th class="text-center">Existe en SINUBE</th>
                                <th>Estatus en SAT</th>
                                <th>Estatus en SINUBE</th>
                                <th>Tipo</th>
                                <th>Serie</th>
                                <th>Folio</th>
                                <th>UUID</th>
                                <th class="text-center">Póliza</th>
                                <th>Mes póliza</th>
                                <th class="text-center">Mes distinto</th>
                                <th>PAC</th>
                                <th>Diferencias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ConciliacionFilaDto f in FilasVisibles.Take(Limite))
                            {
                                <tr class="@(f.Conciliada ? "" : "no-conciliada")">
                                    <td class="razon" title="@f.Rfc">@f.RazonSocial</td>
                                    <td class="text-nowrap">@f.Fecha?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end font-monospace">$@f.Total.ToString("N2")</td>
                                    <td class="text-center">@Marca(f.Conciliada)</td>
                                    <td class="text-center">@Marca(f.ExisteSat)</td>
                                    <td class="text-center">@Marca(f.ExisteBoveda)</td>
                                    <td class="text-center">@Marca(f.ExisteSinube)</td>
                                    <td>@Estatus(f.EstatusSat)</td>
                                    <td>@Estatus(f.EstatusSinube)</td>
                                    <td>@f.Tipo</td>
                                    <td>@f.Serie</td>
                                    <td>@f.Folio</td>
                                    <td class="font-monospace small uuid">@f.Uuid</td>
                                    <td class="text-center" title="@f.PolizaTexto">@Marca(f.Poliza)</td>
                                    <td>@(f.MesPoliza?.ToString() ?? "")</td>
                                    <td class="text-center">@(f.MesDistinto ? Marca(true) : "")</td>
                                    <td class="font-monospace small">@f.Pac</td>
                                    <td class="small">
                                        @foreach (string d in f.Diferencias)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1">@d</span>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (FilasVisibles.Count == 0)
                            {
                                <tr><td colspan="18" class="text-center text-body-secondary py-4">No hay comprobantes con este filtro.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-body d-flex justify-content-between align-items-center small text-body-secondary">
                    <span>Mostrando @Math.Min(Limite, FilasVisibles.Count).ToString("N0") de @FilasVisibles.Count.ToString("N0") comprobante(s)</span>
                    @if (FilasVisibles.Count > Limite)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Limite += 500">Mostrar 500 más</button>
                    }
                </div>
            </div>
        }
        else if (!Procesando)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center text-body-secondary py-5">
                    <i class="bi bi-arrow-left-right fs-1 opacity-50 d-block mb-2"></i>
                    Elige el tipo y el periodo y pulsa <b>Carga y analiza</b>. Se consulta SINUBE (solo lectura) y se cruza
                    con los CFDI @(Tipo == TipoConciliacion.Clientes ? "emitidos" : "recibidos") de la bóveda.
                </div>
            </div>
        }
    }
</div>

<EnviarCorreoModal Visible="AdjuntosCorreo.Count > 0"
                   Adjuntos="AdjuntosCorreo"
                   AsuntoSugerido="@($"Conciliación SINUBE vs SAT {(Resultado?.Tipo == TipoConciliacion.Clientes ? "clientes" : "proveedores")} {EmpresaContext.NombreEmpresa} · {Resultado?.Anio}{Resultado?.Mes:00}")"
                   Datos="@([("Empresa", EmpresaContext.NombreEmpresa), ("RFC", EmpresaContext.Rfc), ("Comprobantes", ConciliacionSinubeService.Titulo(Resultado?.Tipo ?? Tipo)), ("Periodo", $"{Resultado?.Anio}{Resultado?.Mes:00}"), ("No conciliados", (Resultado?.Filas.Count(f => !f.Conciliada) ?? 0).ToString("N0"))])"
                   EmpresaId="EmpresaContext.EmpresaId"
                   OnCerrar="() => AdjuntosCorreo = []"
                   OnEnviado="texto => Mensaje = texto" />

@code {
    private static readonly CultureInfo Mx = new("es-MX");

    private enum Vistas { Todos, Conciliados, FaltanSinube, FaltanSat, FaltaXml, EstatusDistinto, SinPoliza, MesDistinto }

    private TipoConciliacion Tipo = TipoConciliacion.Proveedores;

    private int Anio;
    private int Mes;

    private ResultadoConciliacion? Resultado;
    private bool Procesando;
    private string? Error;
    private string? Mensaje;
    private string? FaltaConfiguracion;

    private bool SoloNoConciliadas;
    private bool NoContabilizadas;
    private string Busqueda = "";
    private Vistas Vista = Vistas.Todos;
    private int Limite = 500;

    private List<AdjuntoCorreo> AdjuntosCorreo = [];

    protected override void OnInitialized()
    {
        Anio = Periodo.Anio;
        Mes = Periodo.Mes;
        EmpresaContext.OnChange += EmpresaCambio;
        RevisarConfiguracion();
    }

    private void EmpresaCambio() => InvokeAsync(() =>
    {
        Resultado = null;
        Error = Mensaje = null;
        RevisarConfiguracion();
        StateHasChanged();
    });

    public void Dispose()
    {
        EmpresaContext.OnChange -= EmpresaCambio;
        CancelacionSat?.Cancel();
    }

    private void RevisarConfiguracion()
    {
        if (!EmpresaContext.TieneEmpresaActiva)
            return;

        SinubeConfiguracionDto c = Sinube.ObtenerConfiguracion(EmpresaContext.EmpresaActiva!);

        FaltaConfiguracion = SinubeService.FaltanDatos(c, requierePassword: true) is string falta
            ? falta.Replace("Herramientas → Acceso a SINUBE", "Exportación a SINUBE") + " "
            : string.IsNullOrWhiteSpace(c.Usuario) ? "Falta el usuario de SINUBE. " : null;
    }

    private void CambiarTipo(TipoConciliacion tipo)
    {
        if (Tipo == tipo)
            return;

        Tipo = tipo;
        Resultado = null;
        Error = Mensaje = null;
    }

    private static bool Tiene(ConciliacionFilaDto f, string diferencia) =>
        f.Diferencias.Any(d => d.StartsWith(diferencia));

    // Estatus distinto o cancelado en el SAT y activo en SINUBE.
    private static bool TieneDiferenciaEstatus(ConciliacionFilaDto f) =>
        f.Diferencias.Any(d => d.StartsWith("Estatus") || d.StartsWith("Cancelado"));

    private bool EsDeVista(ConciliacionFilaDto f) => Vista switch
    {
        Vistas.Conciliados => f.Conciliada,
        Vistas.FaltanSinube => Tiene(f, "No está en SINUBE"),
        Vistas.FaltanSat => !f.ExisteSat,
        Vistas.FaltaXml => Tiene(f, "Falta el XML"),
        Vistas.EstatusDistinto => TieneDiferenciaEstatus(f),
        Vistas.SinPoliza => f.ExisteSinube && !f.Poliza,
        Vistas.MesDistinto => f.MesDistinto,
        _ => true
    };

    private List<ConciliacionFilaDto> FilasVisibles =>
        (Resultado?.Filas ?? [])
            .Where(EsDeVista)
            .Where(f => !SoloNoConciliadas || !f.Conciliada)
            .Where(f => !NoContabilizadas || !f.Poliza)
            .Where(f =>
                string.IsNullOrWhiteSpace(Busqueda) ||
                f.RazonSocial.Contains(Busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
                f.Rfc.Contains(Busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
                f.Uuid.Contains(Busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
                f.Folio.Contains(Busqueda.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IEnumerable<(Vistas, string, int, string, string)> Indicadores
    {
        get
        {
            List<ConciliacionFilaDto> f = Resultado?.Filas ?? [];

            List<(Vistas, string, int, string, string)> indicadores =
            [
                (Vistas.Todos, "Comprobantes", f.Count, "bi-files", "primary"),
                (Vistas.Conciliados, "Conciliados", f.Count(x => x.Conciliada), "bi-check2-all", "success"),
                (Vistas.FaltanSinube, "Faltan en SINUBE", f.Count(x => Tiene(x, "No está en SINUBE")), "bi-cloud-slash", "danger"),
                (Vistas.FaltanSat, Resultado?.MetadatosSat is null ? "Faltan en bóveda" : "No están en el SAT", f.Count(x => !x.ExisteSat), "bi-question-octagon", "warning"),
                (Vistas.FaltaXml, "Falta XML en bóveda", f.Count(x => Tiene(x, "Falta el XML")), "bi-file-earmark-x", "warning"),
                (Vistas.EstatusDistinto, "Estatus distinto", f.Count(TieneDiferenciaEstatus), "bi-shield-exclamation", "danger"),
                (Vistas.SinPoliza, "Sin póliza", f.Count(x => x.ExisteSinube && !x.Poliza), "bi-journal-x", "secondary"),
                (Vistas.MesDistinto, "Mes distinto", f.Count(x => x.MesDistinto), "bi-calendar-x", "info")
            ];

            // Sin metadatos del SAT la bóveda es el SAT: "falta XML" no aplica.
            return indicadores.Where(k => k.Item1 != Vistas.FaltaXml || Resultado?.MetadatosSat is not null);
        }
    }

    private async Task Conciliar()
    {
        Error = Mensaje = null;
        Procesando = true;
        Vista = Vistas.Todos;
        Limite = 500;

        try
        {
            Resultado = await Conciliacion.ConciliarAsync(EmpresaContext.EmpresaActiva!, Tipo, Anio, Mes);
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            Error = ex is TaskCanceledException ? "SINUBE tardó demasiado en responder. Intenta de nuevo." : ex.Message;
        }
        finally
        {
            Procesando = false;
        }
    }

    // ---------- Metadatos del SAT ----------

    private bool ActualizandoSat;
    private string ProgresoSat = "";
    private CancellationTokenSource? CancelacionSat;

    /// <summary>Pide (o retoma) los metadatos del mes al SAT, espera a que estén listos y vuelve a conciliar.</summary>
    private async Task ActualizarSat()
    {
        Error = Mensaje = null;
        ActualizandoSat = true;
        CancelacionSat = new CancellationTokenSource();
        var progreso = new Progress<string>(texto => InvokeAsync(() => { ProgresoSat = texto; StateHasChanged(); }));

        try
        {
            SatMetadatosPeriodoDto m = await MetadatosSat.ActualizarAsync(
                EmpresaContext.EmpresaActiva!, Tipo == TipoConciliacion.Proveedores, Anio, Mes, progreso, CancelacionSat.Token);

            ActualizandoSat = false;
            await Conciliar();
            Mensaje ??= $"Metadatos del SAT actualizados: {m.Registros:N0} CFDI.";
        }
        catch (OperationCanceledException)
        {
            Mensaje = "Se dejó de esperar al SAT. La solicitud sigue en Descargas SAT; al pulsar \"Actualizar del SAT\" se retoma.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Error = ex.Message;
        }
        finally
        {
            ActualizandoSat = false;
            CancelacionSat?.Dispose();
            CancelacionSat = null;
        }
    }

    // En el SAT y sin XML en la bóveda, vigentes y cancelados (los cancelados no afectan la conciliación,
    // pero se descargan para tener la bóveda completa). El SAT no entrega XML recibidos cancelados
    // ("5012 No se permite la descarga de xml que se encuentren cancelados"): en proveedores no se ofrecen.
    private List<ConciliacionFilaDto> SinXml =>
        Resultado?.MetadatosSat is null
            ? []
            : Resultado.Filas
                .Where(f => f.ExisteSat && !f.ExisteBoveda)
                .Where(f => Resultado.Tipo == TipoConciliacion.Clientes || f.EstatusSat != "Cancelado")
                .ToList();

    private List<string> UuidsSinXml => SinXml.Select(f => f.Uuid).ToList();

    private int CanceladosSinXml => SinXml.Count(f => f.EstatusSat == "Cancelado");

    /// <summary>Descarga del SAT los XML faltantes, los importa a la bóveda y vuelve a conciliar.</summary>
    private async Task DescargarFaltantes()
    {
        List<ConciliacionFilaDto> faltan = SinXml;
        Error = Mensaje = null;
        ActualizandoSat = true;
        CancelacionSat = new CancellationTokenSource();
        var progreso = new Progress<string>(texto => InvokeAsync(() => { ProgresoSat = texto; StateHasChanged(); }));

        try
        {
            SatMetadatosService.ResultadoXmlFaltantes r = await MetadatosSat.DescargarXmlFaltantesAsync(
                EmpresaContext.EmpresaActiva!, Tipo == TipoConciliacion.Proveedores, Anio, Mes,
                faltan.Where(f => f.EstatusSat != "Cancelado").Select(f => f.Uuid).ToList(),
                faltan.Where(f => f.EstatusSat == "Cancelado").Select(f => f.Uuid).ToList(),
                progreso, CancelacionSat.Token);

            ActualizandoSat = false;
            await Conciliar();

            int siguenFaltando = UuidsSinXml.Count;
            Mensaje ??= $"Se importaron {r.Importados:N0} XML a la bóveda." +
                (r.Rechazados.Count > 0 ? $" El SAT no entregó {r.Rechazados.Count:N0}: {string.Join(" · ", r.Rechazados.Take(3))}{(r.Rechazados.Count > 3 ? "…" : "")}." : "") +
                (siguenFaltando > r.Rechazados.Count ? $" Otros {siguenFaltando - r.Rechazados.Count:N0} aún no están disponibles en el SAT (suele pasar con los del mismo día); intenta más tarde." : "");
        }
        catch (OperationCanceledException)
        {
            Mensaje = "Se dejó de esperar al SAT. La solicitud sigue en Descargas SAT y se retoma al volver a intentarlo.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Error = ex.Message;
        }
        finally
        {
            ActualizandoSat = false;
            CancelacionSat?.Dispose();
            CancelacionSat = null;
        }
    }

    private string NombreArchivo =>
        $"Conciliacion_SINUBE_SAT_{(Resultado!.Tipo == TipoConciliacion.Clientes ? "Clientes" : "Proveedores")}_{EmpresaContext.Rfc}_{Resultado.Anio}{Resultado.Mes:00}.xlsx";

    private async Task DescargarExcel()
    {
        byte[] contenido = Conciliacion.GenerarExcel(Resultado!, FilasVisibles);
        await JS.InvokeVoidAsync("descargarArchivoBase64", NombreArchivo,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(contenido));
    }

    private void PrepararCorreo()
    {
        AdjuntosCorreo =
        [
            new(NombreArchivo, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Conciliacion.GenerarExcel(Resultado!, FilasVisibles))
        ];
    }

    private static RenderFragment Marca(bool valor) => __builder =>
    {
        if (valor)
        {
            <i class="bi bi-check-square-fill text-success"></i>
        }
        else
        {
            <i class="bi bi-square text-body-tertiary"></i>
        }
    };

    private static RenderFragment Estatus(string estatus) => __builder =>
    {
        string color = estatus switch
        {
            "Vigente" => "success",
            "Cancelado" => "danger",
            "No encontrado" => "warning",
            _ => "secondary"
        };

        if (!string.IsNullOrEmpty(estatus))
        {
            <span class="badge rounded-pill bg-@color-subtle text-@color-emphasis border border-@color-subtle">@estatus.ToUpperInvariant()</span>
        }
    };
}

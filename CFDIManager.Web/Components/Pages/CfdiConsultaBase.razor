@implements IDisposable

@using System.Globalization
@using CFDIManager.Web.Services
@using CFDIParser.Models
@using CFDIParser.Services

@inject ConsultaEstadoSatService ConsultaEstadoSat
@inject ValidacionSatLoteService ValidacionSatLote
@inject PostgreSqlRepository Repo
@inject EmpresaContext EmpresaContext
@inject AccesoEmpresasService Acceso

@* Tabler solo en estas pantallas: en toda la app cambia el aspecto de las que ya estaban terminadas. *@
<HeadContent>
    <link rel="stylesheet" href="lib/tabler/css/tabler.min.css" />
</HeadContent>

<div class="consulta">
    @* ---------- Encabezado ---------- *@
    <div class="page-header mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="page-pretitle">CFDI Manager · @EmpresaContext.Rfc</div>
                <h2 class="page-title">@Titulo</h2>
                @if (!string.IsNullOrWhiteSpace(Descripcion))
                {
                    <div class="text-secondary mt-1">@Descripcion</div>
                }
            </div>
        </div>
    </div>

    @* ---------- Filtros ---------- *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-sm-6 col-lg-2">
                    <label class="form-label">Tipo CFDI</label>
                    <select class="form-select" @bind="Filtro.TipoCfdi">
                        <option value="">Todos</option>
                        <option value="I">I · Facturas</option>
                        <option value="N">N · Nómina</option>
                        <option value="E">E · Notas de crédito</option>
                        <option value="T">T · Traslados</option>
                        <option value="P">P · Pagos</option>
                    </select>
                </div>

                <div class="col-sm-6 col-lg-auto">
                    <label class="form-label">Fecha inicial</label>
                    <FechaInput @bind-Valor="Filtro.FechaInicio" />
                </div>

                <div class="col-sm-6 col-lg-auto">
                    <label class="form-label">Fecha final</label>
                    <FechaInput @bind-Valor="Filtro.FechaFin" />
                </div>

                <div class="col-sm-6 col-lg">
                    <label class="form-label">Búsqueda</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input class="form-control"
                               @bind="Filtro.Busqueda"
                               @bind:event="oninput"
                               @onkeydown="ManejarTecla"
                               placeholder="UUID, RFC, razón social, serie o folio" />
                    </div>
                </div>

                <div class="col-12 col-lg-auto">
                    <div class="btn-list">
                        <button type="button" class="btn btn-primary" @onclick="Consultar" disabled="@Cargando">
                            <i class="ti ti-filter me-1"></i>@(Cargando ? "Consultando…" : "Consultar")
                        </button>
                        <button type="button" class="btn" @onclick="LimpiarFiltros" disabled="@Cargando">
                            <i class="ti ti-eraser me-1"></i>Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">
            <div class="d-flex gap-2">
                <i class="ti ti-alert-octagon fs-2"></i>
                <div>
                    <h4 class="alert-title">No se pudo completar la consulta</h4>
                    <div class="text-secondary">@Error</div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(MensajeSat))
    {
        <div class="alert @(MensajeSatEsError ? "alert-danger" : "alert-success") alert-dismissible" role="status">
            <div class="d-flex gap-2">
                <i class="ti @(MensajeSatEsError ? "ti-alert-triangle" : "ti-shield-check") fs-2"></i>
                <div>
                    <h4 class="alert-title">Validación SAT</h4>
                    <div class="text-secondary">@MensajeSat</div>
                </div>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarMensajeSat"></button>
        </div>
    }

    @if (Cargando)
    {
        <div class="card">
            <div class="card-body">
                <div class="text-secondary mb-2">Consultando @Titulo.ToLowerInvariant() en PostgreSQL…</div>
                <div class="progress progress-sm"><div class="progress-bar progress-bar-indeterminate"></div></div>
            </div>
        </div>
    }
    else
    {
        @* ---------- Validación SAT por lote ---------- *@
        @if (ValidandoLoteSat || UltimoResultadoLote is not null)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <div>
                            <div class="subheader">Validación SAT por lote</div>
                            <div class="text-secondary small font-monospace">@TextoProgresoSat</div>
                        </div>
                        <div class="ms-auto h2 mb-0">@PorcentajeSat.ToString("0")%</div>
                    </div>

                    <div class="progress progress-sm mb-3">
                        <div class="progress-bar @(ValidandoLoteSat ? "progress-bar-striped progress-bar-animated" : "bg-green")"
                             style="width: @PorcentajeSat.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
                    </div>

                    <div class="datagrid">
                        <div class="datagrid-item"><div class="datagrid-title">Procesados</div><div class="datagrid-content">@ProcesadosSat</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Vigentes</div><div class="datagrid-content text-green">@VigentesSat</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Cancelados</div><div class="datagrid-content text-red">@CanceladosSat</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">No encontrados</div><div class="datagrid-content text-yellow">@NoEncontradosSat</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Otros</div><div class="datagrid-content">@OtrosSat</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Errores</div><div class="datagrid-content">@ErroresSat</div></div>
                    </div>
                </div>
            </div>
        }

        @* ---------- Totales por tipo (clic = filtrar) ---------- *@
        <div class="row row-cards mb-3">
            @foreach (Totalizador t in Totalizadores)
            {
                <div class="col-sm-6 col-lg-4 col-xxl-2">
                    <button type="button" class="card card-sm card-link totalizador w-100 text-start @(Filtro.TipoCfdi == t.Tipo ? "activo" : "")"
                            style="--color-tipo: var(--tblr-@t.Color)"
                            @onclick="() => AplicarTipo(t.Tipo)">
                        <span class="card-body d-flex align-items-center gap-3">
                            <span class="avatar bg-@t.Color-lt"><i class="ti @t.Icono"></i></span>
                            <span class="d-block lh-sm">
                                <span class="subheader d-block">@t.Nombre</span>
                                <span class="h3 d-block mb-0">@Moneda(t.Importe)</span>
                                <span class="text-secondary small">@t.Cantidad.ToString("N0") CFDI</span>
                            </span>
                        </span>
                    </button>
                </div>
            }
        </div>

        @* ---------- Tabla ---------- *@
        <div class="card">
            <div class="card-header flex-wrap gap-2">
                <div>
                    <h3 class="card-title">@Titulo</h3>
                    <div class="card-subtitle">
                        @if (Resultado.TotalRegistros > 0)
                        {
                            <span>Mostrando @Resultado.RegistroInicial–@Resultado.RegistroFinal de @Resultado.TotalRegistros.ToString("N0")</span>
                        }
                        else
                        {
                            <span>Sin resultados</span>
                        }
                    </div>
                </div>

                <div class="card-actions d-flex flex-wrap align-items-center gap-2">
                    <div class="input-group input-group-sm w-auto" title="Cuántos CFDI pendientes valida cada lote">
                        <span class="input-group-text">Lote SAT</span>
                        <select class="form-select form-select-sm" @bind="TamanoLoteSat" disabled="@ValidandoLoteSat">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-success" disabled="@(ValidandoLoteSat || Cargando)" @onclick="ValidarPendientesSatAsync">
                        @if (ValidandoLoteSat)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Validando @ProcesadosSat/@TotalSat…</span>
                        }
                        else
                        {
                            <i class="ti ti-shield-check me-1"></i>
                            <span>Validar pendientes SAT</span>
                        }
                    </button>

                    @if (ValidandoLoteSat)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="CancelarValidacionSat">
                            <i class="ti ti-player-stop me-1"></i>Cancelar
                        </button>
                    }

                    <div class="input-group input-group-sm w-auto">
                        <span class="input-group-text">Filas</span>
                        <select class="form-select form-select-sm" value="@Filtro.RegistrosPorPagina" @onchange="CambiarTamanoPagina">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover text-nowrap">
                    <thead>
                        <tr>
                            <th><button type="button" class="table-sort @ClaseOrden("fecha_emision")" @onclick="@(() => Ordenar("fecha_emision"))">Fecha</button></th>
                            <th><button type="button" class="table-sort @ClaseOrden("tipo_cfdi")" @onclick="@(() => Ordenar("tipo_cfdi"))">Tipo</button></th>
                            <th>Serie / Folio</th>
                            <th><button type="button" class="table-sort @ClaseOrden("rfc")" @onclick="@(() => Ordenar("rfc"))">@EtiquetaRfc</button></th>
                            <th><button type="button" class="table-sort @ClaseOrden("nombre")" @onclick="@(() => Ordenar("nombre"))">@EtiquetaNombre</button></th>
                            <th class="text-end"><button type="button" class="table-sort @ClaseOrden("total")" @onclick="@(() => Ordenar("total"))">Total</button></th>
                            <th>UUID</th>
                            <th title="Estado SAT y fecha de la última validación">Estado SAT</th>
                            <th class="w-1">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Resultado.Registros.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="empty py-4">
                                        <div class="empty-icon"><i class="ti ti-file-search fs-1"></i></div>
                                        <p class="empty-title">Sin CFDI</p>
                                        <p class="empty-subtitle text-secondary">No se encontraron CFDI con los filtros seleccionados.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (CfdiConsultaDto cfdi in Resultado.Registros)
                            {
                                <tr class="fila @(Seleccionado?.CfdiId == cfdi.CfdiId ? "table-active" : "")" @onclick="() => Seleccionar(cfdi)">
                                    <td class="text-secondary">@cfdi.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-@ColorTipo(cfdi.TipoCfdi)-lt" title="@NombreTipo(cfdi.TipoCfdi)">@cfdi.TipoCfdi</span></td>
                                    <td><strong>@cfdi.Serie</strong> @cfdi.Folio</td>
                                    <td class="font-monospace small">@ObtenerRfc(cfdi)</td>
                                    <td class="nombre text-truncate" title="@ObtenerNombre(cfdi)">@ObtenerNombre(cfdi)</td>
                                    <td class="text-end"><span class="fw-bold">@Moneda(cfdi.Total)</span> <span class="text-secondary small">@cfdi.Moneda</span></td>
                                    <td class="font-monospace small text-secondary" title="@cfdi.UUID">@AbreviarUuid(cfdi.UUID)</td>
                                    <td title="@TituloValidacion(cfdi)">
                                        <span class="status status-@ColorEstadoSat(cfdi.EstadoSat)"><span class="status-dot"></span>@ObtenerTextoEstadoSat(cfdi.EstadoSat)</span>
                                        <div class="small text-secondary validacion">@TextoValidacion(cfdi)</div>
                                    </td>
                                    <td @onclick:stopPropagation="true">
                                        <div class="btn-list flex-nowrap">
                                            <a class="btn btn-sm btn-icon btn-outline-blue" href="@ObtenerUrlXml(cfdi.CfdiId)" target="_blank" rel="noopener noreferrer" title="Ver XML">
                                                <i class="ti ti-file-code"></i>
                                            </a>
                                            <a class="btn btn-sm btn-icon btn-outline-red" href="@ObtenerUrlPdf(cfdi.CfdiId)" target="_blank" rel="noopener noreferrer" title="Generar PDF">
                                                <i class="ti ti-file-type-pdf"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-icon btn-outline-@ColorEstadoSat(cfdi.EstadoSat)"
                                                    title="@ObtenerTituloBotonSat(cfdi)"
                                                    disabled="@(EstaValidandoSat(cfdi.CfdiId) || ValidandoLoteSat)"
                                                    @onclick="() => ValidarEstadoSatAsync(cfdi)">
                                                @if (EstaValidandoSat(cfdi.CfdiId))
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="ti ti-shield-check"></i>
                                                }
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex align-items-center">
                <p class="m-0 text-secondary">Página @Resultado.PaginaActual de @Math.Max(Resultado.TotalPaginas, 1)</p>
                <ul class="pagination m-0 ms-auto">
                    <li class="page-item @(!Resultado.TienePaginaAnterior || Cargando ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="PaginaAnterior"><i class="ti ti-chevron-left"></i> Anterior</button>
                    </li>
                    <li class="page-item @(!Resultado.TienePaginaSiguiente || Cargando ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="PaginaSiguiente">Siguiente <i class="ti ti-chevron-right"></i></button>
                    </li>
                </ul>
            </div>
        </div>

        @* ---------- Detalle del CFDI seleccionado ---------- *@
        @if (Seleccionado is not null)
        {
            <div class="card mt-3">
                <div class="card-header">
                    <div>
                        <h3 class="card-title">
                            <span class="badge bg-@ColorTipo(Seleccionado.TipoCfdi)-lt me-2">@NombreTipo(Seleccionado.TipoCfdi)</span>@ObtenerNombre(Seleccionado)
                        </h3>
                        <div class="card-subtitle font-monospace">@Seleccionado.UUID</div>
                    </div>
                    <div class="card-actions btn-list">
                        <a class="btn btn-sm" href="@ObtenerUrlXml(Seleccionado.CfdiId)" target="_blank" rel="noopener noreferrer"><i class="ti ti-file-code me-1"></i>XML</a>
                        <a class="btn btn-sm" href="@ObtenerUrlPdf(Seleccionado.CfdiId)" target="_blank" rel="noopener noreferrer"><i class="ti ti-file-type-pdf me-1"></i>PDF</a>
                        <button type="button" class="btn-close ms-2" aria-label="Cerrar" @onclick="() => Seleccionado = null"></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item"><div class="datagrid-title">Clasificación</div><div class="datagrid-content">@Seleccionado.Clasificacion</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Fecha</div><div class="datagrid-content">@Seleccionado.FechaEmision.ToString("dd/MM/yyyy HH:mm")</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Serie / Folio</div><div class="datagrid-content">@Seleccionado.Serie @Seleccionado.Folio</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">@EtiquetaRfc</div><div class="datagrid-content font-monospace">@ObtenerRfc(Seleccionado)</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">@EtiquetaNombre</div><div class="datagrid-content">@ObtenerNombre(Seleccionado)</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Subtotal</div><div class="datagrid-content">@Moneda(Seleccionado.Subtotal)</div></div>
                        <div class="datagrid-item"><div class="datagrid-title">Total</div><div class="datagrid-content fw-bold">@Moneda(Seleccionado.Total)</div></div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Estado SAT</div>
                            <div class="datagrid-content">
                                <span class="status status-@ColorEstadoSat(Seleccionado.EstadoSat)"><span class="status-dot"></span>@ObtenerTextoEstadoSat(Seleccionado.EstadoSat)</span>
                            </div>
                        </div>
                        <div class="datagrid-item"><div class="datagrid-title">Última validación</div><div class="datagrid-content">@TituloValidacion(Seleccionado)</div></div>
                    </div>
                    <div class="datagrid mt-3">
                        <div class="datagrid-item"><div class="datagrid-title">Ruta XML</div><div class="datagrid-content font-monospace small text-break">@Seleccionado.RutaXml</div></div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "Consulta de CFDI";
    [Parameter] public string Descripcion { get; set; } = "";
    [Parameter] public string Clasificacion { get; set; } = "";
    [Parameter] public string EtiquetaRfc { get; set; } = "RFC";
    [Parameter] public string EtiquetaNombre { get; set; } = "Razón social";

    private CfdiFiltroDto Filtro { get; set; } = CrearFiltroInicial();
    private ResultadoPaginadoDto<CfdiConsultaDto> Resultado { get; set; } = new();
    private CfdiResumenConsultaDto Resumen { get; set; } = new();
    private CfdiConsultaDto? Seleccionado { get; set; }
    private bool Cargando { get; set; } = true;
    private string? Error { get; set; }
    private readonly HashSet<long> CfdiValidandoSat = new();
    private string MensajeSat { get; set; } = "";
    private bool MensajeSatEsError { get; set; }

    private bool ValidandoLoteSat { get; set; }
    private int TamanoLoteSat { get; set; } = 25;
    private int ProcesadosSat { get; set; }
    private int TotalSat { get; set; }
    private int VigentesSat { get; set; }
    private int CanceladosSat { get; set; }
    private int NoEncontradosSat { get; set; }
    private int OtrosSat { get; set; }
    private int ErroresSat { get; set; }
    private string UltimoUuidSat { get; set; } = "";
    private string UltimoEstadoSat { get; set; } = "";
    private ResultadoValidacionSatLote? UltimoResultadoLote { get; set; }
    private CancellationTokenSource? CancelacionLoteSat { get; set; }

    private double PorcentajeSat =>
        TotalSat <= 0
            ? 0
            : Math.Min(100d, (double)ProcesadosSat / TotalSat * 100d);

    private string TextoProgresoSat =>
        ValidandoLoteSat
            ? string.IsNullOrWhiteSpace(UltimoUuidSat)
                ? "Preparando comprobantes pendientes..."
                : $"{UltimoUuidSat}: {UltimoEstadoSat}"
            : UltimoResultadoLote is null
                ? "Sin ejecución"
                : $"Lote terminado: {UltimoResultadoLote.Procesados} procesado(s).";

    private void CerrarMensajeSat() => MensajeSat = "";
    private string SufijoFemenino => Clasificacion == "EMITIDO" ? "emitidas" : "recibidas";
    private string SufijoMasculino => Clasificacion == "EMITIDO" ? "emitidos" : "recibidos";

    protected override async Task OnInitializedAsync()
    {
        EmpresaContext.OnChange += CambiarEmpresa;
        await InicializarEmpresaAsync();
        CargarDatos();
    }

    protected override void OnParametersSet() => Filtro.Clasificacion = NormalizarClasificacion(Clasificacion);

    private async Task InicializarEmpresaAsync()
    {
        if (EmpresaContext.TieneEmpresaActiva) return;
        EmpresaDto? primeraEmpresa = (await Acceso.ObtenerEmpresasPermitidasAsync()).FirstOrDefault();
        if (primeraEmpresa is not null) EmpresaContext.Seleccionar(primeraEmpresa);
    }

    private void Consultar() { Filtro.Pagina = 1; Seleccionado = null; CargarDatos(); }

    private void CargarDatos()
    {
        Cargando = true;
        Error = null;
        try
        {
            if (!EmpresaContext.TieneEmpresaActiva) throw new InvalidOperationException("No tienes empresas activas asignadas.");
            Filtro.EmpresaId = EmpresaContext.EmpresaId;
            Filtro.Clasificacion = NormalizarClasificacion(Clasificacion);
            Resultado = Repo.BuscarCfdi(Filtro);
            Resumen = Repo.ObtenerResumenCfdi(CrearFiltroResumen());
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Resultado = new();
            Resumen = new();
        }
        finally { Cargando = false; }
    }

    private void LimpiarFiltros()
    {
        Filtro = CrearFiltroInicial();
        Filtro.EmpresaId = EmpresaContext.EmpresaId;
        Filtro.Clasificacion = NormalizarClasificacion(Clasificacion);
        Seleccionado = null;
        MensajeSat = "";
        CargarDatos();
    }

    private void AplicarTipo(string tipo) { Filtro.TipoCfdi = tipo; Filtro.Pagina = 1; Seleccionado = null; CargarDatos(); }
    private void Seleccionar(CfdiConsultaDto cfdi) => Seleccionado = cfdi;

    private void PaginaAnterior()
    {
        if (!Resultado.TienePaginaAnterior) return;
        Filtro.Pagina--;
        Seleccionado = null;
        CargarDatos();
    }

    private void PaginaSiguiente()
    {
        if (!Resultado.TienePaginaSiguiente) return;
        Filtro.Pagina++;
        Seleccionado = null;
        CargarDatos();
    }

    private void CambiarTamanoPagina(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int cantidad)) return;
        Filtro.RegistrosPorPagina = cantidad;
        Filtro.Pagina = 1;
        Seleccionado = null;
        CargarDatos();
    }

    private void Ordenar(string campo)
    {
        if (Filtro.OrdenarPor == campo) Filtro.OrdenDescendente = !Filtro.OrdenDescendente;
        else { Filtro.OrdenarPor = campo; Filtro.OrdenDescendente = true; }
        Filtro.Pagina = 1;
        CargarDatos();
    }

    private void ManejarTecla(KeyboardEventArgs args) { if (args.Key == "Enter") Consultar(); }

    private void CambiarEmpresa()
    {
        _ = InvokeAsync(() =>
        {
            Filtro.EmpresaId = EmpresaContext.EmpresaId;
            Filtro.Pagina = 1;
            Seleccionado = null;
            MensajeSat = "";
            CargarDatos();
            StateHasChanged();
        });
    }

    private async Task ValidarPendientesSatAsync()
    {
        if (!EmpresaContext.TieneEmpresaActiva)
        {
            MostrarMensajeSat(
                "Selecciona una empresa antes de validar.",
                true);
            return;
        }

        if (ValidandoLoteSat)
        {
            return;
        }

        ReiniciarProgresoSat();
        ValidandoLoteSat = true;
        CancelacionLoteSat = new CancellationTokenSource();
        MostrarMensajeSat(
            $"Iniciando validación de hasta {TamanoLoteSat} CFDI pendientes...",
            false);

        var progreso = new Progress<ProgresoValidacionSat>(
            dato =>
            {
                ProcesadosSat = dato.Procesados;
                TotalSat = dato.Total;
                UltimoUuidSat = dato.UUID;
                UltimoEstadoSat = string.IsNullOrWhiteSpace(dato.Estado)
                    ? dato.CodigoEstatus
                    : dato.Estado;

                _ = InvokeAsync(StateHasChanged);
            });

        try
        {
            ResultadoValidacionSatLote resultado =
                await ValidacionSatLote.ValidarPendientesAsync(
                    EmpresaContext.EmpresaId,
                    TamanoLoteSat,
                    progreso,
                    CancelacionLoteSat.Token);

            UltimoResultadoLote = resultado;
            ProcesadosSat = resultado.Procesados;
            TotalSat = resultado.Total;
            VigentesSat = resultado.Vigentes;
            CanceladosSat = resultado.Cancelados;
            NoEncontradosSat = resultado.NoEncontrados;
            OtrosSat = resultado.Otros;
            ErroresSat = resultado.Errores;

            MostrarMensajeSat(
                resultado.Total == 0
                    ? "No hay CFDI pendientes de validación SAT para este lote."
                    : $"Lote terminado. Vigentes: {resultado.Vigentes}, " +
                      $"cancelados: {resultado.Cancelados}, " +
                      $"no encontrados: {resultado.NoEncontrados}, " +
                      $"otros: {resultado.Otros}, errores: {resultado.Errores}.",
                resultado.Errores > 0);

            CargarDatos();
        }
        catch (OperationCanceledException)
        {
            MostrarMensajeSat(
                $"Validación cancelada después de {ProcesadosSat} CFDI.",
                false);
            CargarDatos();
        }
        catch (Exception ex)
        {
            MostrarMensajeSat(
                $"No se pudo completar la validación por lote: {ex.Message}",
                true);
        }
        finally
        {
            ValidandoLoteSat = false;
            CancelacionLoteSat?.Dispose();
            CancelacionLoteSat = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelarValidacionSat()
    {
        CancelacionLoteSat?.Cancel();
    }

    private void ReiniciarProgresoSat()
    {
        ProcesadosSat = 0;
        TotalSat = 0;
        VigentesSat = 0;
        CanceladosSat = 0;
        NoEncontradosSat = 0;
        OtrosSat = 0;
        ErroresSat = 0;
        UltimoUuidSat = "";
        UltimoEstadoSat = "";
        UltimoResultadoLote = null;
    }

    private async Task ValidarEstadoSatAsync(CfdiConsultaDto cfdi)
    {
        if (!EmpresaContext.TieneEmpresaActiva) { MostrarMensajeSat("Selecciona una empresa antes de validar.", true); return; }
        if (string.IsNullOrWhiteSpace(cfdi.UUID)) { MostrarMensajeSat("El CFDI no contiene UUID.", true); return; }
        if (!CfdiValidandoSat.Add(cfdi.CfdiId)) return;

        MostrarMensajeSat($"Consultando el CFDI {cfdi.UUID} en el SAT...", false);
        await InvokeAsync(StateHasChanged);

        try
        {
            EstadoSatDto resultado = await ConsultaEstadoSat.ConsultarAsync(cfdi.UUID, cfdi.RfcEmisor, cfdi.RfcReceptor, cfdi.Total);
            if (!resultado.ConsultaExitosa)
            {
                MostrarMensajeSat(resultado.MensajeError ?? resultado.CodigoEstatus ?? "No fue posible consultar el CFDI en el SAT.", true);
                return;
            }

            Repo.ActualizarEstadoSat(EmpresaContext.EmpresaId, cfdi.CfdiId, resultado);
            cfdi.EstadoSat = resultado.Estado;
            cfdi.FechaValidacionSat = DateTime.Now;
            cfdi.OrigenValidacionSat = "Consulta SAT";
            if (Seleccionado?.CfdiId == cfdi.CfdiId) Seleccionado.EstadoSat = resultado.Estado;

            string codigo = string.IsNullOrWhiteSpace(resultado.CodigoEstatus) ? "" : $" {resultado.CodigoEstatus}.";
            string cancelable = string.IsNullOrWhiteSpace(resultado.EsCancelable) ? "" : $" Cancelabilidad: {resultado.EsCancelable}.";
            string cancelacion = string.IsNullOrWhiteSpace(resultado.EstatusCancelacion) ? "" : $" Estatus de cancelación: {resultado.EstatusCancelacion}.";
            MostrarMensajeSat($"CFDI {cfdi.UUID}: {resultado.Estado}." + codigo + cancelable + cancelacion, false);
        }
        catch (Exception ex) { MostrarMensajeSat($"No se pudo validar el CFDI: {ex.Message}", true); }
        finally { CfdiValidandoSat.Remove(cfdi.CfdiId); await InvokeAsync(StateHasChanged); }
    }

    private static string ObtenerTituloBotonSat(CfdiConsultaDto cfdi)
    {
        string estado = ObtenerTextoEstadoSat(cfdi.EstadoSat);
        return $"Consultar estado en el SAT. Estado actual: {estado}.";
    }

    private bool EstaValidandoSat(long cfdiId) => CfdiValidandoSat.Contains(cfdiId);
    private void MostrarMensajeSat(string mensaje, bool esError) { MensajeSat = mensaje; MensajeSatEsError = esError; }
    // Al importar se guarda PENDIENTE; en pantalla se lee mejor como "Sin validar".
    private static string ObtenerTextoEstadoSat(string? estado) =>
        (estado ?? "").Trim().ToUpperInvariant() is "" or "PENDIENTE" or "NO VALIDADO" or "NO VERIFICADO" ? "Sin validar" : estado!.Trim();

    private static string TextoValidacion(CfdiConsultaDto cfdi) =>
        cfdi.FechaValidacionSat is DateTime v ? v.ToString("dd/MM/yyyy HH:mm") : "Nunca";

    private static string TituloValidacion(CfdiConsultaDto cfdi) =>
        cfdi.FechaValidacionSat is DateTime v
            ? $"{v:dd/MM/yyyy HH:mm} · {(string.IsNullOrWhiteSpace(cfdi.OrigenValidacionSat) ? "Consulta SAT" : cfdi.OrigenValidacionSat)}"
            : "Nunca se ha validado en el SAT";

    private static string ColorEstadoSat(string? estado) => (estado ?? "").Trim().ToUpperInvariant() switch
    {
        "VIGENTE" => "green",
        "CANCELADO" => "red",
        "NO ENCONTRADO" => "yellow",
        "ERROR" => "orange",
        _ => "secondary"
    };

    private string ObtenerRfc(CfdiConsultaDto cfdi) => Clasificacion == "EMITIDO" ? cfdi.RfcReceptor : cfdi.RfcEmisor;
    private string ObtenerNombre(CfdiConsultaDto cfdi) => Clasificacion == "EMITIDO" ? cfdi.NombreReceptor : cfdi.NombreEmisor;
    private string ObtenerUrlXml(long cfdiId) => $"/api/empresa/{EmpresaContext.EmpresaId}/cfdi/{cfdiId}/xml";
    private string ObtenerUrlPdf(long cfdiId) => $"/api/empresa/{EmpresaContext.EmpresaId}/cfdi/{cfdiId}/pdf";
    public void Dispose()
    {
        CancelacionLoteSat?.Cancel();
        CancelacionLoteSat?.Dispose();
        EmpresaContext.OnChange -= CambiarEmpresa;
    }

    private static CfdiFiltroDto CrearFiltroInicial() => new()
    {
        FechaInicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
        FechaFin = DateTime.Today,
        Pagina = 1,
        RegistrosPorPagina = 25,
        OrdenarPor = "fecha_emision",
        OrdenDescendente = true
    };

    private static string NormalizarClasificacion(string clasificacion)
    {
        string valor = (clasificacion ?? "").Trim().ToUpperInvariant();
        if (valor is not ("EMITIDO" or "RECIBIDO")) throw new InvalidOperationException("La consulta debe indicar EMITIDO o RECIBIDO.");
        return valor;
    }

    private static string Moneda(decimal valor) => valor.ToString("C2", CultureInfo.GetCultureInfo("es-MX"));
    private static string AbreviarUuid(string uuid) => string.IsNullOrWhiteSpace(uuid) ? "" : uuid.Length <= 13 ? uuid : $"{uuid[..8]}…{uuid[^4..]}";
    // Colores por tipo en toda la app: facturas azul, nómina verde, notas de crédito rojo, traslados ámbar, pagos morado.
    private static string ColorTipo(string tipo) => tipo switch { "I" => "blue", "N" => "green", "E" => "red", "T" => "yellow", "P" => "purple", _ => "secondary" };

    private static string NombreTipo(string tipo) => tipo switch { "I" => "Factura", "N" => "Nómina", "E" => "Nota de crédito", "T" => "Traslado", "P" => "Pago", _ => tipo };

    private string ClaseOrden(string campo) => Filtro.OrdenarPor != campo ? "" : Filtro.OrdenDescendente ? "desc" : "asc";

    private sealed record Totalizador(string Tipo, string Nombre, string Icono, string Color, long Cantidad, decimal Importe);

    // Mismo orden de siempre: Facturas, Nómina, Notas de crédito, Traslados, Pagos; al final el total.
    private IEnumerable<Totalizador> Totalizadores =>
    [
        new("I", $"Facturas {SufijoFemenino}", "ti-file-invoice", "blue", Resumen.CantidadFacturas, Resumen.TotalFacturas),
        new("N", $"Nómina {SufijoFemenino}", "ti-users", "green", Resumen.CantidadNominas, Resumen.TotalNominas),
        new("E", "Notas de crédito", "ti-receipt-refund", "red", Resumen.CantidadNotasCredito, Resumen.TotalNotasCredito),
        new("T", $"Traslados {SufijoMasculino}", "ti-truck", "yellow", Resumen.CantidadTraslados, Resumen.TotalTraslados),
        new("P", $"Pagos {SufijoMasculino}", "ti-cash", "purple", Resumen.CantidadPagos, Resumen.TotalPagos),
        new("", $"Total {SufijoMasculino}", "ti-sum", "azure", Resumen.TotalCfdi, Resumen.ImporteTotal)
    ];

    private CfdiFiltroDto CrearFiltroResumen() => new()
    {
        EmpresaId = EmpresaContext.EmpresaId,
        FechaInicio = Filtro.FechaInicio,
        FechaFin = Filtro.FechaFin,
        Clasificacion = NormalizarClasificacion(Clasificacion),
        TipoCfdi = "",
        Busqueda = Filtro.Busqueda,
        Pagina = 1,
        RegistrosPorPagina = 25,
        OrdenarPor = "fecha_emision",
        OrdenDescendente = true
    };
}

@page "/configuracion/herramientas"
@attribute [Authorize(Policy = "Tarea:herramientas")]

@using System.Globalization
@using CFDIManager.Web.Services
@using CFDIManager.Web.Services.Storage
@using CFDIManager.Web.Services.Sat
@using CFDIParser.Models
@using CFDIParser.Services
@implements IDisposable

@inject PeriodoTrabajoService Periodo
@inject ResincronizacionBoveda Resincronizacion
@inject PostgreSqlRepository Repo
@inject IJSRuntime JS
@inject EmpresaContext EmpresaContext
@inject CFDIManager.Web.Services.Sat.EstadoDescargaAutomaticaSat DescargaSat
@inject IConfiguration Configuracion

<PageTitle>Herramientas</PageTitle>

<div class="config-page d-flex flex-column gap-3 pb-4">
    <header>
        <span class="eyebrow">CONFIGURACIÓN</span>
        <h1 class="h2 mb-1">Herramientas</h1>
        <p class="text-body-secondary mb-0">Ajustes generales de CFDI Manager. Solo los ve el Administrador.</p>
    </header>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger alert-dismissible d-flex gap-2 mb-0" role="alert">
            <i class="bi bi-x-octagon-fill"></i>
            <span>@Error</span>
            <button type="button" class="btn-close" @onclick="() => Error = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Exito))
    {
        <div class="alert alert-success alert-dismissible d-flex gap-2 mb-0" role="status">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Exito</span>
            <button type="button" class="btn-close" @onclick="() => Exito = null"></button>
        </div>
    }

    <div class="row g-3">
        <div class="col-xl-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-body py-3">
                    <span class="eyebrow">PERIODO DE TRABAJO</span>
                    <h2 class="h5 mb-0">Mes con el que abren las pantallas</h2>
                </div>

                <div class="card-body">
                    <p class="text-body-secondary small">
                        Aplica a todos los usuarios: Resumen, CFDI de ingresos y egresos, Administración de XML,
                        Exportaciones, Descargas SAT, Conciliación SINUBE y XML Azulejeras. Cada quien puede cambiar
                        las fechas en su pantalla; esto solo define con qué mes abren.
                    </p>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="modo" id="automatico"
                               checked="@Automatico" @onchange="() => Automatico = true" />
                        <label class="form-check-label" for="automatico">
                            <strong>Automático:</strong> el mes en curso (@NombreMes(DateTime.Today))
                        </label>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="modo" id="fijo"
                               checked="@(!Automatico)" @onchange="() => Automatico = false" />
                        <label class="form-check-label" for="fijo">
                            <strong>Mes fijo:</strong> para terminar un mes cuando ya empezó el siguiente
                        </label>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-end ms-4 mb-3">
                        <div>
                            <label class="form-label small mb-1" for="mes">Mes</label>
                            <select id="mes" class="form-select" disabled="@Automatico" @bind="MesElegido">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m">@Mx.TextInfo.ToTitleCase(Mx.DateTimeFormat.GetMonthName(m))</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-1" for="anio">Año</label>
                            <select id="anio" class="form-select" disabled="@Automatico" @bind="AnioElegido">
                                @for (int a = DateTime.Today.Year; a >= DateTime.Today.Year - 5; a--)
                                {
                                    <option value="@a">@a</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <button class="btn btn-primary" @onclick="Guardar">
                            <i class="bi bi-check-lg me-1"></i>Guardar
                        </button>
                        <span class="small text-body-secondary">
                            Ahora: <strong>@(Periodo.EsAutomatico ? "automático" : "mes fijo")</strong>,
                            las pantallas abren del @Periodo.Inicio.ToString("dd/MM/yyyy") al @Periodo.Fin.ToString("dd/MM/yyyy").
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-body d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
                    <div>
                        <span class="eyebrow">SAT</span>
                        <h2 class="h5 mb-0">Descarga automática del SAT</h2>
                    </div>

                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="descargaGeneral"
                               checked="@(!DescargaPausada)" @onchange="CambiarPausa" />
                        <label class="form-check-label fw-semibold" for="descargaGeneral">
                            @(DescargaPausada ? "Pausada para todas las empresas" : "Encendida")
                        </label>
                    </div>
                </div>

                <div class="card-body">
                    <p class="text-body-secondary small">
                        Ventana diaria (@string.Join(" y ", Horarios)), meses pendientes desde "Descargar desde" y cierre de mes.
                        El interruptor general la detiene para todas aunque la empresa la tenga encendida; las casillas
                        la encienden o apagan por empresa (igual que el switch de Administración de XML).
                        Las descargas que lances a mano en Descargas SAT no se ven afectadas.
                    </p>

                    @if (DescargaPausada)
                    {
                        <div class="alert alert-warning py-2 small">
                            <i class="bi bi-pause-circle me-1"></i>
                            Pausada: no se pide, verifica ni descarga nada automáticamente. Al encenderla, en la siguiente pasada
                            (máximo 30 min) se piden los periodos y ventanas que hayan quedado pendientes.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <div class="input-group input-group-sm" style="max-width: 360px">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="search" class="form-control" placeholder="Buscar por RFC o empresa"
                                   @bind="BusquedaDescarga" @bind:event="oninput" />
                        </div>
                        <span class="small text-body-secondary">@EmpresasDescarga.Count() de @Empresas.Count empresas</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Automática</th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-reset fw-semibold text-decoration-none"
                                                @onclick='() => OrdenarDescarga("empresa")'>
                                            Empresa <i class="bi @IconoOrden("empresa")"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-reset fw-semibold text-decoration-none"
                                                @onclick='() => OrdenarDescarga("rfc")'>
                                            RFC <i class="bi @IconoOrden("rfc")"></i>
                                        </button>
                                    </th>
                                    <th>Descarga</th>
                                    <th>Desde</th>
                                    <th>Último ciclo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (EmpresaDto e in EmpresasDescarga)
                                {
                                    EmpresaSatDto? sat = AccesosSat.GetValueOrDefault(e.EmpresaId);

                                    <tr class="@(DescargaPausada ? "opacity-75" : "")">
                                        <td>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       checked="@(sat?.DescargaAutomatica == true)"
                                                       disabled="@(sat is not { TieneEFirma: true })"
                                                       title="@(sat is { TieneEFirma: true } ? "" : "Sin e.firma: cárgala en Empresas → Accesos SAT")"
                                                       @onchange="ev => CambiarEmpresa(e, ev.Value is true)" />
                                            </div>
                                        </td>
                                        <td><strong>@e.NombreParaMostrar</strong></td>
                                        <td class="small font-monospace">@e.Rfc</td>
                                        <td class="small">@QueDescarga(sat)</td>
                                        <td class="small">@(sat?.DescargaDesde?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td class="small">
                                            @if (DescargaSat.PorEmpresa.TryGetValue(e.EmpresaId, out ResultadoDescargaAutomatica? r))
                                            {
                                                @($"{r.Fin:dd/MM HH:mm} · {r.SolicitudesNuevas} nuevas · {r.Pendientes} pendientes")
                                                @if (r.Aviso != "")
                                                {
                                                    <div class="text-warning">@r.Aviso</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-body-secondary">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-body py-3">
                    <span class="eyebrow">CARPETA DE DATOS</span>
                    <h2 class="h5 mb-0">Ubicación de Storage en este equipo (@Environment.MachineName)</h2>
                </div>

                <div class="card-body">
                    <p class="text-body-secondary small">
                        Aquí viven los XML de la bóveda, las e.firmas, logos, constancias y descargas del SAT. Puede estar
                        fuera de la carpeta de la app (por ejemplo <span class="font-monospace">D:\CFDIManagerDatos</span>) para que
                        publicar una versión nueva nunca la toque y respaldarla sea más fácil. Es una carpeta de este equipo
                        (el servidor): quien entra remoto recibe sus archivos por descarga.
                    </p>

                    <dl class="row small mb-3">
                        <dt class="col-sm-3">En uso</dt>
                        <dd class="col-sm-9 font-monospace">@CarpetaStorage.Raiz</dd>
                        @if (CarpetaPendiente is not null)
                        {
                            <dt class="col-sm-3 text-warning">Al reiniciar la app</dt>
                            <dd class="col-sm-9 font-monospace text-warning">@CarpetaPendiente</dd>
                        }
                    </dl>

                    <div class="input-group mb-2">
                        <span class="input-group-text"><i class="bi bi-folder2"></i></span>
                        <input class="form-control font-monospace" @bind="CarpetaNueva" @bind:event="oninput"
                               placeholder="D:\CFDIManagerDatos" disabled="@CopiandoStorage" />
                        <button class="btn btn-outline-secondary" disabled="@CopiandoStorage" title="Storage junto a la app"
                                @onclick="() => CarpetaNueva = CarpetaStorage.Predeterminada">
                            Predeterminada
                        </button>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="copiarDatos" @bind="CopiarDatos" disabled="@CopiandoStorage" />
                        <label class="form-check-label small" for="copiarDatos">
                            Copiar los datos actuales a la nueva carpeta (recomendado; la carpeta actual no se borra)
                        </label>
                    </div>

                    @if (CopiandoStorage)
                    {
                        int porcentaje = AvanceStorage.Total == 0 ? 0 : AvanceStorage.Hechos * 100 / AvanceStorage.Total;

                        <div class="progress mb-1" role="progressbar" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @porcentaje%"></div>
                        </div>
                        <div class="small text-body-secondary mb-2">Copiando @AvanceStorage.Hechos.ToString("N0") de @AvanceStorage.Total.ToString("N0") archivos…</div>
                    }

                    <button class="btn btn-primary" disabled="@(CopiandoStorage || string.IsNullOrWhiteSpace(CarpetaNueva))" @onclick="GuardarCarpeta">
                        <i class="bi bi-check-lg me-1"></i>Guardar ubicación
                    </button>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-body py-3">
                    <span class="eyebrow">BÓVEDA</span>
                    <h2 class="h5 mb-0">Re-sincronizar con la bóveda</h2>
                </div>

                <div class="card-body">
                    <p class="text-body-secondary small">
                        Una empresa a la vez, por el volumen. Vuelve a leer todos los XML de su carpeta y rehace sus datos en la base (conceptos,
                        impuestos, relacionados, emisor/receptor y ruta del archivo). Importa los XML que falten y retira los
                        CFDI cuyo XML ya no está en su carpeta. <strong>Conserva</strong> el Estado SAT, las fechas de validación
                        y lo verificado. Corre en segundo plano: puedes salir de esta pantalla.
                    </p>

                    <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
                        <div>
                            <label class="form-label small mb-1" for="empresa">Empresa</label>
                            <select id="empresa" class="form-select" disabled="@Resincronizacion.EnCurso" @bind="EmpresaElegida">
                                @foreach (EmpresaDto e in Empresas)
                                {
                                    <option value="@e.EmpresaId">@e.NombreParaMostrar · @e.Rfc</option>
                                }
                            </select>
                        </div>

                        @if (Resincronizacion.EnCurso)
                        {
                            <button class="btn btn-outline-danger" @onclick="Resincronizacion.Cancelar">
                                <i class="bi bi-stop-circle me-1"></i>Cancelar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" disabled="@(EmpresaElegida == 0)" @onclick="IniciarResincronizacion">
                                <i class="bi bi-arrow-repeat me-1"></i>Re-sincronizar
                            </button>
                        }
                    </div>

                    @if (Resincronizacion.EnCurso)
                    {
                        int porcentaje = Resincronizacion.Total == 0 ? 0 : Resincronizacion.Procesados * 100 / Resincronizacion.Total;

                        <div class="progress mb-1" role="progressbar" aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @porcentaje%"></div>
                        </div>
                        <div class="small text-body-secondary mb-3">
                            @Resincronizacion.Procesados.ToString("N0") de @Resincronizacion.Total.ToString("N0") XML
                            @(Resincronizacion.EmpresaActual != "" ? $"· {Resincronizacion.EmpresaActual}" : "")
                        </div>
                    }
                    else if (Resincronizacion.Fin is DateTime fin)
                    {
                        <div class="small text-body-secondary mb-2">
                            @(Resincronizacion.Cancelada ? "Cancelada" : "Terminó") el @fin.ToString("dd/MM/yyyy HH:mm")
                            (@((fin - Resincronizacion.Inicio!.Value).ToString(@"m\:ss")) min).
                        </div>
                    }

                    @if (Resincronizacion.Resultados.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Empresa</th>
                                        <th class="text-end">XML</th>
                                        <th class="text-end">Rehechos</th>
                                        <th class="text-end">Nuevos</th>
                                        <th class="text-end">Omitidos</th>
                                        <th class="text-end">Con error</th>
                                        <th class="text-end">Retirados</th>
                                        <th>Sin XML en la bóveda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (ResultadoResincronizacion r in Resincronizacion.Resultados.ToList())
                                    {
                                        <tr>
                                            <td>
                                                <strong>@r.Nombre</strong> <span class="text-body-secondary small">@r.Rfc</span>
                                                @if (r.Aviso != "")
                                                {
                                                    <div class="small text-warning">@r.Aviso</div>
                                                }
                                                @foreach (string error in r.MuestraErrores)
                                                {
                                                    <div class="small text-danger">@error</div>
                                                }
                                            </td>
                                            <td class="text-end">@r.Archivos.ToString("N0")</td>
                                            <td class="text-end">@r.Rehechos.ToString("N0")</td>
                                            <td class="text-end">@r.Nuevos.ToString("N0")</td>
                                            <td class="text-end" title="El RFC de la empresa no es emisor ni receptor del XML">@r.Omitidos.ToString("N0")</td>
                                            <td class="text-end @(r.Errores > 0 ? "text-danger fw-semibold" : "")">@r.Errores.ToString("N0")</td>
                                            <td class="text-end">@r.Retirados.ToString("N0")</td>
                                            <td>
                                                @if (r.SinXml.Count == 0)
                                                {
                                                    <span class="text-body-secondary">—</span>
                                                }
                                                else
                                                {
                                                    <span class="me-2" title="@string.Join("\n", r.SinXml.Take(10).Select(s => $"{s.Uuid} · {s.Ruta}"))">
                                                        @r.SinXml.Count.ToString("N0") CFDI
                                                    </span>
                                                    <button class="btn btn-sm btn-outline-danger" disabled="@Resincronizacion.EnCurso"
                                                            @onclick="() => QuitarSinXml(r)">
                                                        Quitar
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo Mx = CultureInfo.GetCultureInfo("es-MX");

    private bool Automatico;
    private int MesElegido;
    private int AnioElegido;
    private string? Exito;
    private string? Error;

    private List<EmpresaDto> Empresas = [];
    private long EmpresaElegida;

    protected override void OnInitialized()
    {
        Empresas = Repo.ObtenerEmpresasActivas().OrderBy(e => e.NombreParaMostrar).ToList();

        // Propone la empresa seleccionada en la barra superior.
        EmpresaElegida = Empresas.Any(e => e.EmpresaId == EmpresaContext.EmpresaId)
            ? EmpresaContext.EmpresaId
            : Empresas.FirstOrDefault()?.EmpresaId ?? 0;

        Resincronizacion.Cambio += Refrescar;
        DescargaSat.Cambio += Refrescar;
        CargarDescargaAutomatica();
        CargarCarpeta();

        Automatico = Periodo.EsAutomatico;

        // En automático se propone el mes anterior, que es el caso de uso habitual.
        DateTime propuesta = Periodo.MesFijo ?? DateTime.Today.AddMonths(-1);
        MesElegido = propuesta.Month;
        AnioElegido = propuesta.Year;
    }

    private void Guardar()
    {
        Periodo.Guardar(Automatico ? null : new DateTime(AnioElegido, MesElegido, 1));

        Exito = Automatico
            ? "Listo: las pantallas abren con el mes en curso."
            : $"Listo: las pantallas abren en {NombreMes(Periodo.Inicio)}. Los usuarios lo verán al abrir o recargar cada pantalla.";
    }

    private static string NombreMes(DateTime fecha) => fecha.ToString("MMMM yyyy", Mx);

    private async Task IniciarResincronizacion()
    {
        Error = null;
        Exito = null;

        if (Empresas.FirstOrDefault(e => e.EmpresaId == EmpresaElegida) is not EmpresaDto empresa)
            return;

        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Re-sincronizar {empresa.NombreParaMostrar} ({empresa.Rfc}) con la bóveda?\n\nSe vuelven a leer todos sus XML; con miles puede tardar varios minutos. " +
                "El Estado SAT y las validaciones se conservan."))
            return;

        if (!Resincronizacion.Iniciar(empresa))
            Error = "No se pudo iniciar: hay una sincronización de la bóveda en curso. Intenta en unos minutos.";
    }

    private async Task QuitarSinXml(ResultadoResincronizacion r)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Quitar de la base {r.SinXml.Count:N0} CFDI de {r.Nombre} cuyo XML no está en la bóveda?\n\n" +
                "Se borran con sus conceptos, validaciones y marcas. Si después aparece su XML, se vuelven a importar al sincronizar."))
            return;

        int quitados = Resincronizacion.QuitarSinXml(r.EmpresaId);
        Exito = $"Se quitaron {quitados:N0} CFDI sin XML de {r.Nombre}.";
    }

    // ---------- carpeta de datos (Storage) ----------

    private string CarpetaNueva = "";
    private string? CarpetaPendiente;
    private bool CopiarDatos = true;
    private bool CopiandoStorage;
    private (int Hechos, int Total) AvanceStorage;

    private void CargarCarpeta()
    {
        string definida = Repo.ObtenerConfiguracionApp(CarpetaStorage.ClaveConfiguracion) ?? "";
        string siguiente = definida == "" ? CarpetaStorage.Predeterminada : Path.GetFullPath(definida);

        CarpetaPendiente = string.Equals(siguiente, CarpetaStorage.Raiz, StringComparison.OrdinalIgnoreCase) ? null : siguiente;
        CarpetaNueva = CarpetaPendiente ?? CarpetaStorage.Raiz;
    }

    private async Task GuardarCarpeta()
    {
        Error = null;
        Exito = null;

        string nueva;

        try
        {
            if (!Path.IsPathRooted(CarpetaNueva.Trim()))
                throw new InvalidOperationException("Escribe una ruta completa, por ejemplo D:\\CFDIManagerDatos.");

            nueva = Path.GetFullPath(CarpetaNueva.Trim()).TrimEnd('\\');
            string actual = CarpetaStorage.Raiz.TrimEnd('\\');

            if (!nueva.Equals(actual, StringComparison.OrdinalIgnoreCase) &&
                (nueva.StartsWith(actual + "\\", StringComparison.OrdinalIgnoreCase) || actual.StartsWith(nueva + "\\", StringComparison.OrdinalIgnoreCase)))
                throw new InvalidOperationException("La nueva carpeta no puede estar dentro de la actual ni contenerla.");

            // Que exista y que la app (la cuenta del servicio) pueda escribir ahí.
            Directory.CreateDirectory(nueva);
            string prueba = Path.Combine(nueva, $".prueba-{Guid.NewGuid():N}");
            await File.WriteAllTextAsync(prueba, "ok");
            File.Delete(prueba);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException or NotSupportedException)
        {
            Error = $"No se puede usar esa carpeta: {ex.Message}";
            return;
        }

        int copiados = 0, omitidos = 0;

        if (CopiarDatos && !nueva.Equals(CarpetaStorage.Raiz.TrimEnd('\\'), StringComparison.OrdinalIgnoreCase))
        {
            CopiandoStorage = true;

            try
            {
                (copiados, omitidos) = await Task.Run(() => CarpetaStorage.CopiarA(nueva, (h, t) =>
                {
                    AvanceStorage = (h, t);
                    InvokeAsync(StateHasChanged);
                }, CancellationToken.None));
            }
            catch (Exception ex)
            {
                Error = $"Falló la copia; no se cambió la ubicación: {ex.Message}";
                return;
            }
            finally
            {
                CopiandoStorage = false;
            }
        }

        // La predeterminada se guarda vacía: así sigue a la carpeta de la app aunque esta se mueva.
        bool predeterminada = nueva.Equals(CarpetaStorage.Predeterminada.TrimEnd('\\'), StringComparison.OrdinalIgnoreCase);
        Repo.GuardarConfiguracionApp(CarpetaStorage.ClaveConfiguracion, predeterminada ? "" : nueva);
        CargarCarpeta();

        string copia = CopiarDatos && copiados + omitidos > 0
            ? $" Se copiaron {copiados:N0} archivos ({omitidos:N0} ya estaban)."
            : "";

        Exito = CarpetaPendiente is null
            ? $"La app ya usa esa carpeta.{copia}"
            : $"Ubicación guardada.{copia} Reinicia la app para usarla (servicio: Restart-Service CFDIManager). " +
              "La carpeta anterior no se borra; después conviene Re-sincronizar cada empresa para actualizar las rutas.";
    }

    // ---------- descarga automática ----------

    private bool DescargaPausada;
    private Dictionary<long, EmpresaSatDto?> AccesosSat = new();

    private IEnumerable<string> Horarios =>
        (Configuracion["DescargaAutomaticaSat:Horarios"] ?? "07:00,21:00").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private void CargarDescargaAutomatica()
    {
        DescargaPausada = Repo.ObtenerConfiguracionApp(EstadoDescargaAutomaticaSat.ClavePausa) == "1";
        AccesosSat = Empresas.ToDictionary(e => e.EmpresaId, e => Repo.ObtenerEmpresaSat(e.EmpresaId));
    }

    private void CambiarPausa(ChangeEventArgs e)
    {
        bool encendida = e.Value is true;
        Repo.GuardarConfiguracionApp(EstadoDescargaAutomaticaSat.ClavePausa, encendida ? "0" : "1");
        CargarDescargaAutomatica();

        Exito = encendida
            ? "Descarga automática encendida: corre en la siguiente pasada para las empresas que la tienen activa."
            : "Descarga automática pausada para todas las empresas.";
    }

    private void CambiarEmpresa(EmpresaDto empresa, bool activa)
    {
        Error = null;

        try
        {
            Repo.CambiarDescargaAutomatica(empresa.EmpresaId, activa, new DateTime(DateTime.Today.Year, 1, 1));
            Exito = $"Descarga automática {(activa ? "encendida" : "apagada")} para {empresa.NombreParaMostrar}.";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        CargarDescargaAutomatica();
    }

    private string BusquedaDescarga = "";
    private string OrdenDescarga = "empresa";
    private bool OrdenDescargaDesc;

    private static readonly StringComparer Alfabetico = StringComparer.Create(Mx, ignoreCase: true);

    private IEnumerable<EmpresaDto> EmpresasDescarga
    {
        get
        {
            string texto = BusquedaDescarga.Trim();

            IEnumerable<EmpresaDto> filtradas = Empresas.Where(e =>
                texto == "" ||
                e.Rfc.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                e.NombreParaMostrar.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                e.RazonSocial.Contains(texto, StringComparison.OrdinalIgnoreCase));

            Func<EmpresaDto, string> clave = OrdenDescarga == "rfc" ? e => e.Rfc : e => e.NombreParaMostrar;

            return OrdenDescargaDesc ? filtradas.OrderByDescending(clave, Alfabetico) : filtradas.OrderBy(clave, Alfabetico);
        }
    }

    private void OrdenarDescarga(string columna)
    {
        OrdenDescargaDesc = OrdenDescarga == columna && !OrdenDescargaDesc;
        OrdenDescarga = columna;
    }

    private string IconoOrden(string columna) =>
        OrdenDescarga != columna ? "bi-arrow-down-up text-body-secondary"
        : OrdenDescargaDesc ? "bi-sort-alpha-up-alt" : "bi-sort-alpha-down";

    private static string QueDescarga(EmpresaSatDto? sat) =>
        sat is null ? "—"
        : string.Join(" · ", new[] { (sat.DescargaEmitidos, "Emitidos"), (sat.DescargaRecibidos, "Recibidos"), (sat.DescargaMetadatos, "Metadatos") }
            .Where(x => x.Item1).Select(x => x.Item2)) is { Length: > 0 } texto ? texto : "—";

    private void Refrescar() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Resincronizacion.Cambio -= Refrescar;
        DescargaSat.Cambio -= Refrescar;
    }
}

@page "/administracion-xml"
@attribute [Authorize(Policy = "Tarea:administracion-xml")]
@implements IDisposable

@using CFDIParser.Models
@using CFDIParser.Services
@using CFDIManager.Web.Services
@using CFDIManager.Web.Services.AdministracionXml
@using Microsoft.AspNetCore.Components.Forms

@inject EmpresaContext EmpresaContext
@inject PostgreSqlRepository Repo
@inject AdministracionXmlService Admin
@inject CatalogoLogosService Logos
@inject IJSRuntime JS
@inject CFDIManager.Web.Services.Seguridad.AccesoEmpresasService Acceso
@inject DescargasTemporales Descargas
@inject CFDIManager.Web.Services.Storage.EstadoSincronizacionStorage Sincronizacion
@inject RutaXmlService Rutas
@inject PeriodoTrabajoService Periodo
@inject CFDIManager.Web.Services.Sat.EstadoDescargaAutomaticaSat DescargaSat
@inject CFDIManager.Web.Services.AdministracionXml.ValidacionSatSegundoPlano ValidacionesSat
@inject EnvioCfdiService EnvioCfdi

<PageTitle>Administración de XML</PageTitle>

<div class="admin-xml">

    @if (!EmpresaContext.TieneEmpresaActiva)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 m-3">
            <i class="bi bi-building-exclamation fs-5"></i>
            Selecciona una empresa activa para administrar sus XML.
        </div>
    }
    else
    {
        <section class="principal">

            @* Dos tarjetas: filtros (tipo, año, mes) y resumen del comprobante elegido. *@
            <div class="encabezado">
                <div class="card shadow-sm filtros">
                    <div class="card-body d-flex gap-3 p-2">
                        <div class="lista-filtro">
                            <span class="etiqueta">Tipo</span>
                            <div class="list-group list-group-sm">
                                <button type="button" class="list-group-item list-group-item-action @(Clasificacion == "EMITIDO" ? "active" : "")" @onclick='() => CambiarClasificacion("EMITIDO")'>
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Emitidos
                                </button>
                                <button type="button" class="list-group-item list-group-item-action @(Clasificacion == "RECIBIDO" ? "active" : "")" @onclick='() => CambiarClasificacion("RECIBIDO")'>
                                    <i class="bi bi-box-arrow-in-down-left me-1"></i>Recibidos
                                </button>
                            </div>

                            <span class="etiqueta mt-2">Año</span>
                            <div class="list-group list-group-sm corta">
                                @foreach (int a in Anios)
                                {
                                    <button type="button" class="list-group-item list-group-item-action @(a == Anio ? "active" : "")" @onclick="() => CambiarAnio(a)">@a</button>
                                }
                            </div>
                        </div>

                        <div class="lista-filtro">
                            <span class="etiqueta d-flex justify-content-between align-items-center gap-2">
                                Mes
                                <span class="form-check form-switch m-0 small fw-normal">
                                    <input class="form-check-input" type="checkbox" id="acumular" checked="@Acumular" @onchange="CambiarAcumular" />
                                    <label class="form-check-label" for="acumular">Acumular</label>
                                </span>
                            </span>
                            <div class="list-group list-group-sm alta" title="Ctrl + clic para elegir varios meses">
                                @foreach (int m in MesesDisponibles)
                                {
                                    <button type="button" class="list-group-item list-group-item-action @(MesesElegidos.Contains(m) ? "active" : "")" @onclick="e => ElegirMes(m, e)">
                                        <span class="text-body-secondary me-1 mes-num">@m.ToString("00")</span>@Cultura.DateTimeFormat.GetMonthName(m)
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="lista-filtro dias">
                            <span class="etiqueta d-flex justify-content-between align-items-center gap-2">
                                Día
                                @if (DiasElegidos.Count > 0)
                                {
                                    <span class="badge rounded-pill text-bg-primary fw-semibold">@DiasElegidos.Count</span>
                                }
                            </span>
                            @if (MuestraDias)
                            {
                                <div class="list-group list-group-sm alta" title="Ctrl + clic para elegir varios días">
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between @(DiasElegidos.Count == 0 ? "active" : "")" @onclick="TodosLosDias">
                                        Todo el mes <span class="cantidad">@DiasDisponibles.Sum(d => d.Cantidad).ToString("N0")</span>
                                    </button>
                                    @foreach (var (dia, cantidad) in DiasDisponibles)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between gap-2 @(DiasElegidos.Contains(dia) ? "active" : "") @(cantidad == 0 ? "sin-coincidencias" : "")" @onclick="e => ElegirDia(dia, e)">
                                            <span><span class="mes-num fw-semibold me-1">@dia.ToString("00")</span><span class="text-body-secondary mes-num">@NombreDia(dia)</span></span>
                                            <span class="cantidad">@cantidad.ToString("N0")</span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="dias-aviso alta">
                                    <i class="bi bi-calendar-day fs-5 opacity-50"></i>
                                    <span>Elige un solo mes, sin acumular, para filtrar por día.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm resumen">
                    <div class="card-body p-2">
                        @if (Activa is { } sel)
                        {
                            @* El XML y su representación impresa lado a lado, a todo el ancho. *@
                            <div class="vista-previa">
                                <pre class="vista-xml" title="Doble clic para abrir el XML" @ondblclick="AbrirXml">@XmlVista</pre>
                                @* Imagen de la primera página generada desde el XML: no depende del visor de PDF del navegador. *@
                                <div class="vista-pdf-marco" title="Doble clic para abrir el PDF" @ondblclick="GenerarPdf">
                                    <img class="vista-pdf" src="@UrlCfdi(sel.CfdiId, "vista")" alt="Representación impresa" loading="lazy" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="h-100 d-flex flex-column align-items-center justify-content-center text-body-secondary">
                                <i class="bi bi-file-earmark-text fs-1 opacity-50"></i>
                                <span>Selecciona un comprobante para ver su resumen.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="barra-busqueda">
                <div class="busqueda">
                    <label class="etiqueta" for="buscar-xml">Buscar por</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="buscar-xml" class="form-control" placeholder="UUID, RFC, nombre, serie o folio"
                               @bind="Busqueda" @bind:event="oninput" @bind:after="BuscarConPausa" />
                    </div>
                </div>
                <div class="reporte">
                    <label class="etiqueta" for="tipo-reporte">Nvo. reporte de</label>
                    <select id="tipo-reporte" class="form-select form-select-sm" @bind="TipoReporte">
                        <option value="general">Reporte general (por tipo)</option>
                        <option value="conceptos">Conceptos</option>
                        @if (Clasificacion == "RECIBIDO")
                        {
                            <option value="agrupado:emisor">Agrupado por emisor</option>
                        }
                        else
                        {
                            <option value="agrupado:receptor">Agrupado por receptor</option>
                        }
                        @if (VariosMeses)
                        {
                            <option value="agrupado:mes">Agrupado por mes</option>
                        }
                        <option value="agrupado:uso">Uso CFDI</option>
                        <option value="agrupado:metodo">Método de pago</option>
                        <option value="agrupado:tipo">Tipo</option>
                        <option value="pareto">Análisis 80-20 (Pareto) con dashboard</option>                    </select>
                </div>
                <div class="progreso progress" role="progressbar" aria-label="Progreso del proceso">
                    <div class="progress-bar @(EnProceso ? "progress-bar-striped progress-bar-animated" : "")"
                         style="width:@(Proceso is { Total: > 0 } p ? (p.Hechos * 100 / p.Total) : 0)%"></div>
                    <span class="progreso-texto">@TextoProceso</span>
                    @if (EnProceso)
                    {
                        <button class="btn btn-sm btn-danger cancelar" @onclick="CancelarProceso"><i class="bi bi-stop-fill me-1"></i>Cancelar</button>
                    }
                </div>
            </div>

            <div class="card shadow-sm rejilla-card">
                <div class="card-header bg-body-tertiary p-1 pb-0 border-bottom-0">
                    <div class="pestanas">
                        @foreach (var (clave, titulo, cantidad) in Pestanas)
                        {
                            // Igual que la tarjeta: Nómina 1.1 solo si el filtro trae alguna (o si es la pestaña abierta).
                            if (clave == "nomina11" && cantidad == 0 && Pestana != clave)
                            {
                                continue;
                            }

                            <button type="button" class="pestana tono-@ColorPestana(clave) @(Pestana == clave ? "activa" : "")" @onclick="() => CambiarPestana(clave)">
                                @titulo <span class="badge rounded-pill cantidad">@cantidad.ToString("N0")</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="rejilla">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="sel"><input class="form-check-input" type="checkbox" checked="@TodoElFiltro" @onchange="MarcarTodoElFiltro" title="Seleccionar todo el filtro (todas las páginas)" /></th>
                                @foreach (Columna c in ColumnasVisibles)
                                {
                                    <th class="ordenable @(c.Numero ? "num" : "") @(Orden == c.Clave ? "ordenada" : "")"
                                        title="Ordenar por @c.Titulo" @onclick="() => Ordenar(c.Clave)">
                                        @c.Titulo
                                        <i class="bi @(Orden != c.Clave ? "bi-chevron-expand" : Descendente ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (AdminXmlFilaDto x in Filas)
                            {
                                <tr class="@(x.CfdiId == ActivaId ? "activa" : "")" @onclick="e => ClicFila(x, e)" @ondblclick="AbrirXml"
                                    title="Ctrl + clic marca o desmarca · Shift + clic marca un rango">
                                    <td class="sel" @onclick:stopPropagation="true">
                                        <input class="form-check-input" type="checkbox" checked="@(TodoElFiltro || Marcadas.Contains(x.CfdiId))" @onchange="e => Marcar(x.CfdiId, e)" />
                                    </td>
                                    @foreach (Columna c in ColumnasVisibles)
                                    {
                                        <td class="@(c.Numero ? "num" : "") @c.Clase(x)" title="@c.Ayuda(x)"><span>@c.Valor(x)</span></td>
                                    }
                                </tr>
                            }
                            @if (Filas.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(ColumnasVisibles.Count + 1)" class="text-center text-body-secondary py-4">
                                        <i class="bi bi-inbox fs-4 d-block"></i>
                                        Sin comprobantes para este filtro.
                                        @if (!string.IsNullOrWhiteSpace(Busqueda) && MesesElegidos.Count < MesesDisponibles.Count)
                                        {
                                            <div class="mt-2">
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="BuscarEnTodoElAnio">
                                                    <i class="bi bi-search me-1"></i>Buscar en todo @Anio
                                                </button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pie">
                <span class="small">
                    <i class="bi bi-files text-body-secondary me-1"></i>
                    <b>@(Filas.Count == 0 ? 0 : Pagina * TamanoPagina + 1)–@(Pagina * TamanoPagina + Filas.Count)</b> de <b>@((Totales?.EnPestana ?? 0).ToString("N0"))</b> en el filtro
                    @if (TodoElFiltro)
                    {
                        <span class="badge text-bg-primary ms-1">todo el filtro marcado</span>
                    }
                    else if (Marcadas.Count > 0)
                    {
                        <span class="badge text-bg-primary ms-1">@Marcadas.Count marcados</span>
                    }
                </span>

                @if (TotalPaginas > 1)
                {
                    <div class="input-group input-group-sm paginador">
                        <button class="btn btn-outline-secondary" disabled="@(Pagina == 0)" @onclick="() => IrPagina(0)" title="Primera"><i class="bi bi-chevron-double-left"></i></button>
                        <button class="btn btn-outline-secondary" disabled="@(Pagina == 0)" @onclick="() => IrPagina(Pagina - 1)" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                        <span class="input-group-text">Página</span>
                        <input class="form-control text-center" type="number" min="1" max="@TotalPaginas" value="@(Pagina + 1)" @onchange="IrPaginaEscrita" />
                        <span class="input-group-text">de @TotalPaginas</span>
                        <button class="btn btn-outline-secondary" disabled="@(Pagina >= TotalPaginas - 1)" @onclick="() => IrPagina(Pagina + 1)" title="Siguiente"><i class="bi bi-chevron-right"></i></button>
                        <button class="btn btn-outline-secondary" disabled="@(Pagina >= TotalPaginas - 1)" @onclick="() => IrPagina(TotalPaginas - 1)" title="Última"><i class="bi bi-chevron-double-right"></i></button>
                    </div>
                }

                <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle importe">
                    Vigente <b>$@((Totales?.Vigente ?? 0).ToString("N2"))</b>
                </span>
                <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis border border-danger-subtle importe">
                    Cancelado <b>$@((Totales?.Cancelado ?? 0).ToString("N2"))</b>
                </span>

                <span class="flex-grow-1"></span>

                <div class="input-group input-group-sm filtrar">
                    <span class="input-group-text"><i class="bi bi-funnel me-1"></i>Filtrar</span>
                    <select class="form-select" @bind="Filtrar" @bind:after="Consultar">
                        <option value="">Todos</option>
                        <option value="vigentes">Vigentes</option>
                        <option value="cancelados">Cancelados</option>
                        <option value="sinvalidar">Sin validar en SAT</option>
                        <option value="duplicados">Duplicados (mismo UUID en varios XML)</option>
                        <option value="ppd">PPD (pago en parcialidades)</option>
                        <option value="relacionados" title="El que relaciona y el relacionado">Relacionados</option>
                    </select>
                </div>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" @onclick='() => AbrirModal("columnas")'><i class="bi bi-layout-three-columns me-1"></i>Columnas</button>
                    <button class="btn btn-outline-secondary" @onclick="() => MostrarDetalles = !MostrarDetalles">
                        <i class="bi @(MostrarDetalles ? "bi-chevron-bar-down" : "bi-chevron-bar-up") me-1"></i>@(MostrarDetalles ? "Ocultar detalles" : "Mostrar detalles")
                    </button>
                </div>
            </div>

            @* Detalle a la izquierda y totales por tipo a la derecha en 2 columnas; sin detalle, los totales en una fila. *@
            <div class="zona-inferior @(MostrarDetalles ? "" : "sin-detalles")">
            @if (Totales is { } t)
            {
                <div class="kpis">
                    @foreach (var (titulo, cantidad, total, tono, icono) in new[]
                    {
                        ("Facturas", t.Facturas.Cantidad, t.Facturas.Total, "azul", "bi-receipt"),
                        ("Nómina 1.1", t.Nominas11.Cantidad, t.Nominas11.Total, "verde", "bi-people"),
                        ("Nómina 1.2", t.Nominas12.Cantidad, t.Nominas12.Total, "verde", "bi-people"),
                        ("Notas de crédito", t.NotasCredito.Cantidad, t.NotasCredito.Total, "mal", "bi-arrow-counterclockwise"),
                        ("Traslados", t.Traslados.Cantidad, t.Traslados.Total, "ambar", "bi-truck"),
                        ("Pagos", t.Pagos.Cantidad, t.Pagos.Total, "morado", "bi-cash-coin")
                    })
                    {
                        // Nómina 1.1 dejó de emitirse el 1 de abril de 2017: solo se muestra si el filtro trae alguna.
                        if (titulo == "Nómina 1.1" && cantidad == 0)
                        {
                            continue;
                        }

                        <div class="kpi tono-@tono" title="@titulo: @cantidad.ToString("N0") · $@total.ToString("N2")">
                            <span class="ic"><i class="bi @icono"></i></span>
                            <div class="kpi-texto">
                                <div class="kpi-titulo"><span class="kpi-nombre">@titulo</span><span class="cantidad">@cantidad.ToString("N0")</span></div>
                                <div class="kpi-valor">$@total.ToString("N2")</div>
                            </div>
                        </div>
                    }
                    <div class="kpi tono-todos" title="Archivos XML: @t.Archivos.ToString("N0")">
                        <span class="ic"><i class="bi bi-files"></i></span>
                        <div class="kpi-texto">
                            <div class="kpi-titulo">Archivos XML</div>
                            <div class="kpi-valor">@t.Archivos.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            }

            @if (MostrarDetalles)
            {
                <div class="detalles @(VerRelacionados && Relacionados.Count > 0 ? "con-relacionados" : "")">
                    <div class="card shadow-sm detalle-tablas">
                        <div class="card-header bg-body-tertiary py-0 px-2">
                            <ul class="nav nav-tabs card-header-tabs">
                                @foreach (var (clave, titulo) in new[] { ("conceptos", "Conceptos"), ("impuestos", "Impuestos"), ("locales", "Impuestos locales"), ("complemento", "Complemento") })
                                {
                                    <li class="nav-item">
                                        <button type="button" class="nav-link @(Det == clave ? "active" : "")" @onclick="() => CambiarDetalle(clave)">@titulo</button>
                                    </li>
                                }
                                @* Solo cuando el comprobante relaciona otros CFDI o algún CFDI lo relaciona a él. *@
                                @if (Relacionados.Count > 0)
                                {
                                    <li class="nav-item">
                                        <button type="button" class="nav-link @(VerRelacionados ? "active" : "")" @onclick="() => VerRelacionados = !VerRelacionados">
                                            Relacionados
                                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis ms-1">@Relacionados.Count</span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="detalle-cuerpo">
                            @if (Activa is null)
                            {
                                <p class="text-body-secondary p-3 mb-0">Selecciona un comprobante.</p>
                            }
                            else if (Det == "conceptos")
                            {
                                <table class="table table-sm table-striped mb-0">
                                    <thead><tr><th>ClaveProdServ</th><th>NoIdentificación</th><th class="num">Cantidad</th><th>Clave unidad</th><th>Unidad</th><th>Descripción</th><th class="num">Valor unitario</th><th class="num">Descuento</th><th class="num">Importe</th></tr></thead>
                                    <tbody>
                                        @foreach (ConceptoDto k in Conceptos)
                                        {
                                            <tr><td>@k.ClaveProdServ</td><td>@k.NoIdentificacion</td><td class="num">@k.Cantidad.ToString("N2")</td><td>@k.ClaveUnidad</td><td>@k.Unidad</td><td class="largo" title="@k.Descripcion">@k.Descripcion</td><td class="num">@k.ValorUnitario.ToString("N2")</td><td class="num">@((k.Descuento ?? 0).ToString("N2"))</td><td class="num">@k.Importe.ToString("N2")</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else if (Det == "impuestos")
                            {
                                <table class="table table-sm table-striped mb-0">
                                    <thead><tr><th>Concepto</th><th>Tipo</th><th>Impuesto</th><th>Factor</th><th class="num">Tasa o cuota</th><th class="num">Base</th><th class="num">Importe</th></tr></thead>
                                    <tbody>
                                        @for (int i = 0; i < Conceptos.Count; i++)
                                        {
                                            int n = i + 1;
                                            foreach (ImpuestoDto imp in Conceptos[i].Impuestos)
                                            {
                                                <tr><td>@n</td><td>@imp.Tipo</td><td>@NombreImpuesto(imp.Impuesto)</td><td>@imp.TipoFactor</td><td class="num">@imp.Tasa.ToString("0.######")</td><td class="num">@imp.Base.ToString("N2")</td><td class="num">@imp.Importe.ToString("N2")</td></tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                                <div class="d-flex flex-wrap gap-2 p-2 small">
                                    <span class="badge bg-body-secondary text-body border">IVA @Activa.Iva.ToString("N2")</span>
                                    <span class="badge bg-body-secondary text-body border">IEPS @Activa.Ieps.ToString("N2")</span>
                                    <span class="badge bg-body-secondary text-body border">Ret. IVA @Activa.RetIva.ToString("N2")</span>
                                    <span class="badge bg-body-secondary text-body border">Ret. ISR @Activa.RetIsr.ToString("N2")</span>
                                </div>
                            }
                            else if (Det == "complemento")
                            {
                                <div class="p-2">
                                    @if (ComplementosDetalle.Count == 0)
                                    {
                                        <p class="text-body-secondary mb-0">Sin complementos.</p>
                                    }
                                    @foreach (NodoXml n in ComplementosDetalle)
                                    {
                                        @PintarNodo(n)
                                    }
                                </div>
                            }
                            else
                            {
                                <table class="table table-sm table-striped mb-0">
                                    <thead><tr><th>Tipo</th><th>Impuesto</th><th class="num">Tasa</th><th class="num">Importe</th></tr></thead>
                                    <tbody>
                                        @foreach (ImpuestoLocalDto l in ImpuestosLocales)
                                        {
                                            <tr><td>@l.Tipo</td><td>@l.Nombre</td><td class="num">@l.Tasa.ToString("0.####")</td><td class="num">@l.Importe.ToString("N2")</td></tr>
                                        }
                                        @if (ImpuestosLocales.Count == 0)
                                        {
                                            <tr><td colspan="4" class="text-body-secondary">Sin impuestos locales.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                    @* Se abre con la pestaña Relacionados; se cierra con la misma pestaña o al cambiar de comprobante. *@
                    @if (VerRelacionados && Relacionados.Count > 0)
                    {
                        <div class="card shadow-sm relacionados">
                            <div class="card-header bg-body-tertiary py-1 px-2 d-flex align-items-center">
                                <span class="flex-grow-1"><i class="bi bi-link-45deg me-1"></i>Relacionados</span>
                                <button type="button" class="btn-close btn-sm" aria-label="Cerrar" @onclick="() => VerRelacionados = false"></button>
                            </div>
                            <ul class="list-group list-group-flush">
                                @foreach (var grupo in Relacionados.GroupBy(r => r.RelacionaAEste))
                                {
                                    <li class="list-group-item grupo">@(grupo.Key ? "Lo relacionan" : "Este CFDI relaciona")</li>
                                    @foreach (CfdiRelacionadoDto r in grupo)
                                    {
                                        <li class="list-group-item @(r.RelacionaAEste && r.TipoRelacion == "04" ? "sustituido" : "")">
                                            <span class="tipo-relacion" title="Tipo de relación @r.TipoRelacion · @NombreTipoRelacion(r.TipoRelacion)">
                                                @r.TipoRelacion · @(r.RelacionaAEste ? NombreRelacionInversa(r.TipoRelacion) : NombreTipoRelacion(r.TipoRelacion))
                                            </span>
                                            @if (r.EnBase)
                                            {
                                                <span class="datos">
                                                    @r.TipoCfdi · @(string.IsNullOrEmpty(r.Serie) ? "" : r.Serie + " ")@r.Folio
                                                    · @r.FechaEmision?.ToString("dd/MM/yyyy") · $@r.Total.ToString("N2")
                                                    @if (r.EstadoSat.StartsWith("Cancel", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger-emphasis ms-1">Cancelado</span>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="datos text-body-secondary">No está en la bóveda</span>
                                            }
                                            <span class="font-monospace uuid" title="@r.UUID">@r.UUID</span>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
            </div>
        </section>

        <aside class="herramientas">
            @foreach (var (seccion, acciones) in Herramientas)
            {
                <div class="seccion">@seccion</div>
                <div class="list-group list-group-flush">
                    @foreach (var (texto, icono, tono, accion) in acciones)
                    {
                        <button type="button" class="list-group-item list-group-item-action herramienta" @onclick="accion">
                            <span class="ic tono-@tono"><i class="bi @icono"></i></span>
                            @texto
                        </button>
                    }
                </div>
            }
        </aside>
    }

    @if (Aviso != "")
    {
        <div class="toast show aviso align-items-center border-0 shadow @(AvisoError ? "text-bg-danger" : "text-bg-dark")" role="status">
            <div class="d-flex align-items-center gap-2 p-2 ps-3">
                <i class="bi @(AvisoError ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill") fs-5"></i>
                <span class="flex-grow-1">@Aviso</span>
                @if (CarpetaAviso != "")
                {
                    <button class="btn btn-sm btn-light text-nowrap" @onclick="() => AbrirCarpeta(CarpetaAviso)"><i class="bi bi-folder2-open me-1"></i>Abrir carpeta</button>
                }
                <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick='() => Aviso = ""'></button>
            </div>
        </div>
    }

    <Modal Visible="@(Modal != "")"
           Titulo="@TituloModal"
           Icono="@IconoModal"
           Tamano="@(Modal is "columnas" or "renombrar" or "red" or "imagen" ? "modal-lg" : "modal-xl")"
           OnCerrar="CerrarModal">
        @switch (Modal)
        {
            case "xml":
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <a class="btn btn-sm btn-primary" href="@UrlCfdi(ActivaId, "xml", true)" target="_blank"><i class="bi bi-download me-1"></i>Descargar XML</a>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GenerarPdf"><i class="bi bi-file-earmark-pdf me-1"></i>Ver PDF</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Localizar"><i class="bi bi-folder2-open me-1"></i>Localizar en carpeta</button>
                </div>
                <pre class="codigo">@TextoXml</pre>
                break;

            case "columnas":
                <p class="small text-body-secondary">Elige las columnas que se muestran en la tabla. La selección se guarda en este navegador.</p>
                <div class="columnas-elegir">
                    @foreach (Columna c in Columnas)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="col-@c.Clave" checked="@(!Ocultas.Contains(c.Clave))" @onchange="e => AlternarColumna(c.Clave, e)" />
                            <label class="form-check-label" for="col-@c.Clave">@c.Titulo</label>
                        </div>
                    }
                </div>
                break;

            case "importar":
            case "externos":
                <div class="alert alert-info small d-flex gap-2">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>
                        Los XML se importan a <b>@EmpresaContext.NombreEmpresa</b> igual que en Importaciones: se clasifican como
                        emitidos o recibidos, se copian a <b>@RutaEmpresa</b> y se registran en la base de datos. Los repetidos se actualizan.
                    </span>
                </div>
                @if (Modal == "importar")
                {
                    <label class="form-label fw-semibold small">Archivos XML</label>
                    <div class="input-group mb-3">
                        <InputFile class="form-control" multiple accept=".xml" OnChange="ElegirArchivos" />
                        <button class="btn btn-primary" disabled="@(ArchivosElegidos.Count == 0 || Cancelacion is not null)" @onclick="ImportarArchivos">
                            <i class="bi bi-upload me-1"></i>Importar @ArchivosElegidos.Count archivo(s)
                        </button>
                    </div>
                    <hr />
                }
                <label class="form-label fw-semibold small">Importar una carpeta completa (incluye subcarpetas), por ejemplo la bóveda de AdminXML</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-folder"></i></span>
                    <input class="form-control" @bind="CarpetaImportar" placeholder="C:\AdminXML\BovedaCFDi\@EmpresaContext.Rfc" />
                    <button class="btn btn-primary text-nowrap" disabled="@(Cancelacion is not null)" @onclick="ImportarCarpeta"><i class="bi bi-folder-plus me-1"></i>Importar carpeta</button>
                </div>
                break;

            case "agrupaciones":
                <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                    <div class="input-group input-group-sm w-auto">
                        <span class="input-group-text">Agrupar por</span>
                        <select class="form-select" @bind="AgruparPor" @bind:after="CargarAgrupaciones">
                            <option value="emisor">Emisor</option>
                            <option value="receptor">Receptor</option>
                            <option value="mes">Mes</option>
                            <option value="uso">Uso CFDI</option>
                            <option value="metodo">Método de pago</option>
                            <option value="tipo">Tipo</option>
                        </select>
                    </div>
                    <button class="btn btn-sm btn-outline-success" @onclick='() => Exportar("agrupado:" + AgruparPor)'><i class="bi bi-file-earmark-excel me-1"></i>Exportar a Excel</button>
                </div>
                <p class="text-body-secondary small">Facturas menos notas de crédito del filtro actual (sin importar la pestaña).</p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover">
                        <thead><tr><th>Clave</th><th>Nombre</th><th class="num">Comprobantes</th><th class="num">SubTotal</th><th class="num">IVA</th><th class="num">Total</th></tr></thead>
                        <tbody>
                            @foreach (AdminXmlAgrupacionDto a in Agrupaciones)
                            {
                                <tr><td class="font-monospace">@a.Clave</td><td class="largo" title="@a.Nombre">@a.Nombre</td><td class="num">@a.Cantidad</td><td class="num">@a.Subtotal.ToString("N2")</td><td class="num">@a.Iva.ToString("N2")</td><td class="num fw-semibold">@a.Total.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "renombrar":
                <CFDIManager.Web.Components.AdministracionXml.RenombrarXmlAsistente
                    Ejemplo="@(Activa ?? Filas.FirstOrDefault())"
                    Alcance="@DescribirAlcance()"
                    OnIniciar="Renombrar" />
                break;

            case "logos":
                <p class="text-body-secondary small">El logo del RFC emisor aparece en sus PDF. PNG o JPG.</p>
                <div class="input-group mb-3">
                    <span class="input-group-text">RFC</span>
                    <input class="form-control font-monospace text-uppercase" style="max-width: 180px" @bind="RfcLogo" />
                    <InputFile class="form-control" accept=".png,.jpg,.jpeg" OnChange="GuardarLogo" />
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="bi bi-cloud-download me-1"></i>De SINUBE</span>
                    <input class="form-control" placeholder="Dirección del logo o HTML del formato de SINUBE" @bind="LogoSinube" />
                    <button type="button" class="btn btn-outline-primary" @onclick="ImportarLogo" disabled="@(string.IsNullOrWhiteSpace(LogoSinube))">Importar</button>
                </div>
                <div class="logos">
                    @foreach (string rfc in LogosGuardados)
                    {
                        <div class="card logo">
                            <div class="card-body d-flex flex-column align-items-center gap-2 p-2">
                                <img src="/api/logos/@rfc?v=@VersionLogos" alt="Logo de @rfc" />
                                <span class="small font-monospace">@rfc</span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => QuitarLogo(rfc)"><i class="bi bi-trash me-1"></i>Quitar</button>
                            </div>
                        </div>
                    }
                    @if (LogosGuardados.Count == 0)
                    {
                        <p class="text-body-secondary">Aún no hay logos.</p>
                    }
                </div>
                break;

            case "series":
                <p class="text-body-secondary small">Folios numéricos del filtro actual (sin importar la pestaña).</p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead><tr><th>Serie</th><th>Tipos</th><th class="num">Desde</th><th class="num">Hasta</th><th class="num">Cantidad</th><th>Faltantes</th><th>Repetidos</th></tr></thead>
                        <tbody>
                            @foreach (AdminXmlSerieDto s in Series)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.Serie</td><td>@s.Tipos</td><td class="num">@s.Desde</td><td class="num">@s.Hasta</td><td class="num">@s.Cantidad</td>
                                    <td class="@(s.Faltantes.Count > 0 ? "mal" : "ok") ajusta">@(s.Faltantes.Count == 0 ? "Ninguno" : $"{s.Faltantes.Count}{(s.Faltantes.Count >= 500 ? "+" : "")}: {string.Join(", ", s.Faltantes.Take(60))}{(s.Faltantes.Count > 60 ? "…" : "")}")</td>
                                    <td class="@(s.Repetidos.Count > 0 ? "mal" : "ok") ajusta">@(s.Repetidos.Count == 0 ? "Ninguno" : string.Join(", ", s.Repetidos.Take(30)))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "complemento":
                @if (Complementos.Count == 0)
                {
                    <p class="text-body-secondary">Sin complementos.</p>
                }
                @foreach (NodoXml n in Complementos)
                {
                    @PintarNodo(n)
                }
                break;

            case "red":
                <p>Los XML de <b>@EmpresaContext.NombreEmpresa</b> se guardan en:</p>
                <pre class="codigo">@RutaEmpresa</pre>
                <p class="text-body-secondary small mb-0">
                    Todas las empresas usan la ruta XML general <code>@Rutas.CarpetaGeneral</code> más su RFC.
                    Para usar una carpeta de red (por ejemplo <code>\\servidor\Boveda</code>), cambia <code>AppSettings:CarpetaXml</code>
                    en appsettings.json y reinicia la aplicación.
                </p>
                break;

            case "enviarcfdi":
                @if (PreparandoEnvio)
                {
                    <div class="text-body-secondary py-4 text-center"><span class="spinner-border spinner-border-sm me-2"></span>Consultando correos…</div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 2rem"></th>
                                    <th>Para</th>
                                    <th class="text-end">CFDI</th>
                                    <th class="text-end">Total</th>
                                    <th style="min-width: 18rem">Correo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (GrupoEnvioCfdi g in GruposEnvio)
                                {
                                    <tr>
                                        <td><input type="checkbox" class="form-check-input" @bind="g.Enviar" disabled="@EnviandoCfdi" /></td>
                                        <td>
                                            <div class="fw-semibold small">@g.Nombre</div>
                                            <div class="small text-body-secondary font-monospace">@g.Rfc@(g.NombreComercial != "" ? $" · {g.NombreComercial}" : "")</div>
                                        </td>
                                        <td class="text-end small" title="@string.Join(", ", g.Cfdis.Select(x => $"{x.Serie}{x.Folio}"))">@g.Cfdis.Count</td>
                                        <td class="text-end small">@g.Total.ToString("C2")</td>
                                        <td>
                                            <input class="form-control form-control-sm" @bind="g.Para" placeholder="correo@cliente.com" disabled="@EnviandoCfdi" />
                                            @if (g.Origen != "")
                                            {
                                                <div class="form-text mt-0">@(g.Origen == "SINUBE" ? "Del catálogo de clientes de SINUBE" : "Último correo usado")</div>
                                            }
                                        </td>
                                        <td class="small">
                                            @if (g.Resultado == "Enviado")
                                            {
                                                <span class="badge text-bg-success">Enviado</span>
                                            }
                                            else if (g.Resultado != "")
                                            {
                                                <span class="text-danger">@g.Resultado</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Con copia (CC)</label>
                            <input class="form-control form-control-sm" @bind="CcEnvio" disabled="@EnviandoCfdi" />
                            @if (MiCorreoEnvio != "")
                            {
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="cfdi-copia" @bind="CopiaParaMiEnvio" disabled="@EnviandoCfdi" />
                                    <label class="form-check-label small" for="cfdi-copia">Enviarme una copia (@MiCorreoEnvio)</label>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Mensaje</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="MensajeEnvio" disabled="@EnviandoCfdi"></textarea>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-body-secondary">PDF (formato SINUBE) y XML de cada CFDI · un correo por destinatario</span>
                        <button type="button" class="btn btn-primary ms-auto" @onclick="EnviarCfdis"
                                disabled="@(EnviandoCfdi || !GruposEnvio.Any(g => g.Enviar && g.Resultado != "Enviado"))">
                            @if (EnviandoCfdi)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-send me-1"></i>
                            }
                            Enviar @GruposEnvio.Count(g => g.Enviar && g.Resultado != "Enviado") correo(s)
                        </button>
                    </div>
                }
                break;

            case "imagen":
                <div class="d-flex flex-column gap-2 mb-3">
                    @foreach (var (clave, titulo, icono) in FormasImagen)
                    {
                        <label class="border rounded-3 p-2 px-3 d-flex align-items-center gap-2 @(FormaImagen == clave ? "border-primary bg-primary-subtle" : "")" style="cursor:pointer">
                            <input type="radio" class="form-check-input m-0" name="forma-imagen" checked="@(FormaImagen == clave)" @onchange="() => FormaImagen = clave" />
                            <i class="bi @icono"></i>@titulo
                        </label>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-body-secondary">@TextoPeriodo()</span>
                    <button type="button" class="btn btn-primary ms-auto" @onclick="ImagenResumen" disabled="@GenerandoImagen">
                        @if (GenerandoImagen)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-download me-1"></i>
                        }
                        Descargar imagen
                    </button>
                </div>
                break;
        }
    </Modal>
</div>

<EnviarCorreoModal Visible="AdjuntosCorreo.Count > 0"
                   Adjuntos="AdjuntosCorreo"
                   AsuntoSugerido="@($"Reporte de XML {EmpresaContext.NombreEmpresa}")"
                   Datos="@([("Empresa", EmpresaContext.NombreEmpresa), ("RFC", EmpresaContext.Rfc)])"
                   EmpresaId="EmpresaContext.EmpresaId"
                   Imagen="ImagenCorreo"
                   OnCerrar="() => AdjuntosCorreo = []"
                   OnEnviado="texto => Avisar(texto)" />

@code {
    private const int TamanoPagina = 200;

    // Panel derecho: secciones con sus acciones (texto, icono, color, acción).
    private IEnumerable<(string, (string, string, string, Func<Task>)[])> Herramientas =>
    [
        ("Herramientas",
        [
            ("Exportar a Excel", "bi-file-earmark-excel", "verde", () => Exportar(TipoReporte)),
            ("Imagen del resumen", "bi-image", "morado", Sincrona(() => AbrirModal("imagen"))),
            ("Enviar por correo", "bi-envelope-paper", "azul", PrepararCorreo),
            ("Enviar CFDI", "bi-send", "verde", PrepararEnvioCfdi),
            ("Abrir XML", "bi-filetype-xml", "azul", Sincrona(AbrirXml)),
            ("Generar PDF", "bi-file-earmark-pdf", "rojo", GenerarPdf),
            ("Valida Estado SAT", "bi-shield-check", "azul", ValidarEstadoSat),
            ("Localizar XML", "bi-search", "azul", Sincrona(Localizar)),
            ("Importar XML", "bi-upload", "azul", Sincrona(() => AbrirModal("importar"))),
            ("Descargar XML (ZIP)", "bi-file-earmark-zip", "ambar", DescargarZipXml),
            ("Descargar PDF (ZIP)", "bi-file-earmark-zip", "rojo", DescargarZipPdf),
            ("Agrupaciones", "bi-diagram-3", "ambar", Sincrona(() => AbrirModal("agrupaciones"))),
            ("Renombrar XML's", "bi-input-cursor-text", "azul", Sincrona(() => AbrirModal("renombrar"))),
            ("Catálogo de logos", "bi-images", "ambar", Sincrona(() => AbrirModal("logos"))),
            ("Verifica series", "bi-123", "azul", Sincrona(() => AbrirModal("series"))),
            ("Leer complemento", "bi-braces", "verde", Sincrona(LeerComplemento)),
            ("XML externos", "bi-box-arrow-in-down", "ambar", Sincrona(() => AbrirModal("externos"))),
            ("Dirección de datos", "bi-hdd-network", "azul", Sincrona(() => AbrirModal("red")))
        ])
    ];

    private static Func<Task> Sincrona(Action accion) => () =>
    {
        accion();
        return Task.CompletedTask;
    };

    private string IconoModal => Modal switch
    {
        "xml" => "bi-filetype-xml",
        "columnas" => "bi-layout-three-columns",
        "importar" => "bi-upload",
        "externos" => "bi-box-arrow-in-down",
        "agrupaciones" => "bi-diagram-3",
        "renombrar" => "bi-input-cursor-text",
        "logos" => "bi-images",
        "series" => "bi-123",
        "complemento" => "bi-braces",
        "red" => "bi-hdd-network",
        "imagen" => "bi-image",
        "enviarcfdi" => "bi-send",
        _ => "bi-window"
    };

    // Reporte en Excel listo para enviar por correo (mientras tenga archivos, el diálogo está abierto).
    private List<CFDIManager.Web.Services.Correo.AdjuntoCorreo> AdjuntosCorreo = [];
    private byte[]? ImagenCorreo;

    // ---------- Enviar CFDI: PDF (formato SINUBE) y XML, un correo por contraparte ----------
    private const int MaximoEnvioCfdi = 200;
    private List<GrupoEnvioCfdi> GruposEnvio = [];
    private bool PreparandoEnvio;
    private bool EnviandoCfdi;
    private string CcEnvio = "";
    private string MiCorreoEnvio = "";
    private bool CopiaParaMiEnvio;
    private string MensajeEnvio = "Buen día:\nTe envío los comprobantes fiscales (PDF y XML) adjuntos.\nSaludos.";

    private static string ClaveCcEnvio(long empresaId) => $"correo_cfdi_cc:{empresaId}";

    /// <summary>Los marcados o, si no hay, el comprobante activo.</summary>
    private async Task PrepararEnvioCfdi()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        List<long> ids = !TodoElFiltro && Marcadas.Count > 0 ? Marcadas.ToList() : Activa is not null ? [ActivaId] : [];

        if (ids.Count == 0)
        {
            Avisar("Selecciona o marca los comprobantes a enviar.", error: true);
            return;
        }

        if (ids.Count > MaximoEnvioCfdi)
        {
            Avisar($"Marca hasta {MaximoEnvioCfdi} comprobantes por envío.", error: true);
            return;
        }

        GruposEnvio = [];
        // CC que la empresa usa siempre (p. ej. sus propios correos de ventas): el último capturado.
        CcEnvio = Repo.ObtenerConfiguracionApp(ClaveCcEnvio(empresa.EmpresaId)) ?? "";

        // Copia para el usuario que envía (su correo de Usuarios), marcada de entrada como en "Enviar por correo".
        var yo = await Acceso.ObtenerUsuarioActualAsync();
        MiCorreoEnvio = CFDIManager.Web.Services.Seguridad.AccesoEmpresasService.ObtenerUsuarioId(yo) is long idUsuario
            ? Repo.ObtenerUsuarioPorId(idUsuario)?.Email ?? ""
            : "";
        CopiaParaMiEnvio = MiCorreoEnvio != "";
        PreparandoEnvio = true;
        TituloModal = "Enviar CFDI";
        Modal = "enviarcfdi";
        StateHasChanged();

        try
        {
            GruposEnvio = await EnvioCfdi.PrepararAsync(empresa, ids);
        }
        catch (Exception ex)
        {
            CerrarModal();
            Avisar(ex.Message, error: true);
        }
        finally
        {
            PreparandoEnvio = false;
        }
    }

    private async Task EnviarCfdis()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        EnviandoCfdi = true;
        var usuario = await Acceso.ObtenerUsuarioActualAsync();
        string enviadoPor = usuario.FindFirst(CFDIManager.Web.Services.Seguridad.UsuarioClaimsFactory.NombreCompleto)?.Value ?? usuario.Identity?.Name ?? "";
        List<string> cc = CFDIManager.Web.Services.Correo.CorreoService.SepararCorreos(CcEnvio);
        Repo.GuardarConfiguracionApp(ClaveCcEnvio(empresa.EmpresaId), string.Join(", ", cc));

        if (CopiaParaMiEnvio && MiCorreoEnvio != "" && !cc.Contains(MiCorreoEnvio, StringComparer.OrdinalIgnoreCase))
            cc.Add(MiCorreoEnvio);

        foreach (GrupoEnvioCfdi g in GruposEnvio.Where(g => g.Enviar && g.Resultado != "Enviado"))
        {
            g.Resultado = "Enviando…";
            StateHasChanged();

            try
            {
                await EnvioCfdi.EnviarAsync(empresa, g, cc, MensajeEnvio, enviadoPor);
                g.Resultado = "Enviado";
            }
            catch (Exception ex)
            {
                g.Resultado = ex.Message;
            }

            StateHasChanged();
        }

        EnviandoCfdi = false;
        int enviados = GruposEnvio.Count(g => g.Resultado == "Enviado");
        Avisar($"{enviados} de {GruposEnvio.Count(g => g.Enviar)} correo(s) enviados.", error: enviados < GruposEnvio.Count(g => g.Enviar));
    }


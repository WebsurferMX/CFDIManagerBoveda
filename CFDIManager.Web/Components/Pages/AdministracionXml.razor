    private RenderFragment PintarNodo(NodoXml n) => __builder =>
    {
        <div class="nodo">
            <b>@n.Nombre</b>
            @if (n.Atributos.Count > 0)
            {
                <dl>
                    @foreach (var a in n.Atributos)
                    {
                        <dt>@a.Key</dt><dd>@a.Value</dd>
                    }
                </dl>
            }
            @foreach (NodoXml h in n.Hijos)
            {
                @PintarNodo(h)
            }
        </div>
    };


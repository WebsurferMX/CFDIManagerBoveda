@page "/administracion-xml"
@attribute [Authorize(Policy = "Tarea:administracion-xml")]
@implements IDisposable

@using CFDIParser.Models
@using CFDIParser.Services
@using CFDIManager.Web.Services
@using CFDIManager.Web.Services.AdministracionXml
@using CFDIManager.Web.Services.Sinube
@using Microsoft.AspNetCore.Components.Forms

@inject EmpresaContext EmpresaContext
@inject PostgreSqlRepository Repo
@inject AdministracionXmlService Admin
@inject CatalogoLogosService Logos
@inject IJSRuntime JS
@inject CFDIManager.Web.Services.Seguridad.AccesoEmpresasService Acceso
@inject DescargasTemporales Descargas
@inject CFDIManager.Web.Services.Storage.EstadoSincronizacionStorage Sincronizacion
@inject RutaXmlService Rutas
@inject PeriodoTrabajoService Periodo
@inject CFDIManager.Web.Services.Sat.EstadoDescargaAutomaticaSat DescargaSat
@inject CFDIManager.Web.Services.AdministracionXml.ValidacionSatSegundoPlano ValidacionesSat
@inject EnvioCfdiService EnvioCfdi
@inject ISnackbar Snackbar
@inject IAuthorizationService Autorizacion

<PageTitle>Administración de XML</PageTitle>

<div class="admin-xml">

    @if (!EmpresaContext.TieneEmpresaActiva)
    {
        <MudAlert Severity="Severity.Warning" Class="ma-3">Selecciona una empresa activa para administrar sus XML.</MudAlert>
    }
    else
    {
        <section class="principal">

            @* Dos tarjetas: filtros (tipo, año, mes, día) y vista previa del comprobante elegido. *@
            <div class="encabezado">
                <MudPaper Elevation="1" Class="filtros">
                    <div class="lista-filtro">
                        <span class="etiqueta">Tipo</span>
                        <MudToggleGroup T="string" Value="Clasificacion" ValueChanged="CambiarClasificacion" Vertical="true" Outlined="true"
                                        Size="Size.Small" Color="Color.Primary" Class="tipo">
                            <MudToggleItem Value="@("EMITIDO")"><i class="bi bi-box-arrow-up-right me-1"></i>Emitidos</MudToggleItem>
                            <MudToggleItem Value="@("RECIBIDO")"><i class="bi bi-box-arrow-in-down-left me-1"></i>Recibidos</MudToggleItem>
                        </MudToggleGroup>

                        <span class="etiqueta mt-2">Año</span>
                        @* Renglones propios y no MudListItem: MudList lleva su propia selección (un solo renglón) y no respeta
                           Ctrl + clic; aquí la selección es la de la página (clase "elegido"). *@
                        <div class="lista corta" role="listbox">
                            @foreach (int a in Anios)
                            {
                                <button type="button" role="option" class="item @(a == Anio ? "elegido" : "")" @onclick="() => CambiarAnio(a)">@a</button>
                            }
                        </div>
                    </div>

                    <div class="lista-filtro">
                        <span class="etiqueta d-flex justify-content-between align-items-center gap-2">
                            Mes
                            <MudSwitch T="bool" Value="Acumular" ValueChanged="CambiarAcumular" Size="Size.Small" Color="Color.Primary"
                                       Label="Acumular" Class="acumular" />
                        </span>
                        <div class="lista alta" role="listbox" title="Ctrl + clic para elegir varios meses">
                            @foreach (int m in MesesDisponibles)
                            {
                                <button type="button" role="option" class="item @(MesesElegidos.Contains(m) ? "elegido" : "")" @onclick="e => ElegirMes(m, e)">
                                    <span class="mes-num me-1">@m.ToString("00")</span>@Cultura.DateTimeFormat.GetMonthName(m)
                                </button>
                            }
                        </div>
                    </div>

                    <div class="lista-filtro dias">
                        <span class="etiqueta d-flex justify-content-between align-items-center gap-2">
                            Día
                            @if (DiasElegidos.Count > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ma-0">@DiasElegidos.Count</MudChip>
                            }
                        </span>
                        @if (MuestraDias)
                        {
                            <div class="lista alta" role="listbox" title="Ctrl + clic para elegir varios días">
                                <button type="button" role="option" class="item renglon @(DiasElegidos.Count == 0 ? "elegido" : "")" @onclick="TodosLosDias">
                                    Todo el mes <span class="cantidad">@DiasDisponibles.Sum(d => d.Cantidad).ToString("N0")</span>
                                </button>
                                @foreach (var (dia, cantidad) in DiasDisponibles)
                                {
                                    <button type="button" role="option" class="item renglon @(DiasElegidos.Contains(dia) ? "elegido" : "") @(cantidad == 0 ? "sin-coincidencias" : "")"
                                            @onclick="e => ElegirDia(dia, e)">
                                        <span><span class="mes-num fw-semibold me-1">@dia.ToString("00")</span><span class="mes-num secundario">@NombreDia(dia)</span></span>
                                        <span class="cantidad">@cantidad.ToString("N0")</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="dias-aviso alta">
                                <i class="bi bi-calendar-day fs-5 opacity-50"></i>
                                <span>Elige un solo mes, sin acumular, para filtrar por día.</span>
                            </div>
                        }
                    </div>
                </MudPaper>

                <MudPaper Elevation="1" Class="resumen">
                    @if (Activa is { } sel)
                    {
                        @* El XML y su representación impresa lado a lado, a todo el ancho. *@
                        <div class="vista-previa">
                            <pre class="vista-xml" title="Doble clic para abrir el XML" @ondblclick="AbrirXml">@XmlVista</pre>
                            @* Imagen de la primera página generada desde el XML: no depende del visor de PDF del navegador. *@
                            <div class="vista-pdf-marco" title="Doble clic para abrir el PDF" @ondblclick="GenerarPdf">
                                <img class="vista-pdf" src="@UrlCfdi(sel.CfdiId, "vista")" alt="Representación impresa" loading="lazy" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="vacio">
                            <i class="bi bi-file-earmark-text fs-1 opacity-50"></i>
                            <span>Selecciona un comprobante para ver su resumen.</span>
                        </div>
                    }
                </MudPaper>
            </div>

            <div class="barra-busqueda">
                @* Contenedores propios con ancho fijo: la clase de MudSelect no queda en su elemento exterior y el
                   campo crecía; así la barra de progreso y avisos toma el resto. *@
                <div class="campo busqueda">
                    <MudTextField T="string" Value="Busqueda" ValueChanged="CambiarBusqueda" DebounceInterval="350" Immediate="true"
                                  Label="Buscar por" Placeholder="UUID, RFC, nombre, serie o folio" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
                </div>

                @* Solo los reportes asignados al usuario (Configuración → Usuarios → Reportes de XML). *@
                @if (ReportesVisibles.Count > 0)
                {
                    <div class="campo reporte">
                        <MudSelect T="string" @bind-Value="TipoReporte" Label="Nvo. reporte de" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Dense="true">
                            @foreach (var (tipo, nombre) in ReportesVisibles)
                            {
                                <MudSelectItem Value="@tipo">@nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }

                <div class="progreso" role="progressbar" aria-label="Progreso del proceso">
                    <MudProgressLinear Value="@(Proceso is { Total: > 0 } p ? (p.Hechos * 100.0 / p.Total) : 0)" Striped="EnProceso"
                                       Color="Color.Primary" Class="barra" />
                    <span class="progreso-texto">@TextoProceso</span>
                    @if (EnProceso)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="CancelarProceso" Class="cancelar">Cancelar</MudButton>
                    }
                </div>
            </div>

            <MudPaper Elevation="1" Class="rejilla-card">
                <div class="pestanas">
                    @foreach (var (clave, titulo, cantidad) in Pestanas)
                    {
                        // Igual que la tarjeta: Nómina 1.1 solo si el filtro trae alguna (o si es la pestaña abierta).
                        if (clave == "nomina11" && cantidad == 0 && Pestana != clave)
                        {
                            continue;
                        }

                        <button type="button" class="pestana tono-@ColorPestana(clave) @(Pestana == clave ? "activa" : "")" @onclick="() => CambiarPestana(clave)">
                            @titulo <span class="cantidad">@cantidad.ToString("N0")</span>
                        </button>
                    }
                </div>

                <div class="rejilla">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Square="true">
                        <thead>
                            <tr>
                                <th class="sel">
                                    <MudCheckBox T="bool" Value="TodoElFiltro" ValueChanged="MarcarTodoElFiltro" Size="Size.Small" Dense="true"
                                                 title="Seleccionar todo el filtro (todas las páginas)" />
                                </th>
                                @foreach (Columna c in ColumnasVisibles)
                                {
                                    <th class="ordenable @(c.Numero ? "num" : "") @(Orden == c.Clave ? "ordenada" : "")"
                                        title="Ordenar por @c.Titulo" @onclick="() => Ordenar(c.Clave)">
                                        @c.Titulo
                                        <i class="bi @(Orden != c.Clave ? "bi-chevron-expand" : Descendente ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (AdminXmlFilaDto x in Filas)
                            {
                                <tr class="@(x.CfdiId == ActivaId ? "activa" : "")" @onclick="e => ClicFila(x, e)" @ondblclick="AbrirXml"
                                    title="Ctrl + clic marca o desmarca · Shift + clic marca un rango">
                                    <td class="sel" @onclick:stopPropagation="true">
                                        <MudCheckBox T="bool" Value="@(TodoElFiltro || Marcadas.Contains(x.CfdiId))" ValueChanged="v => Marcar(x.CfdiId, v)"
                                                     Size="Size.Small" Dense="true" />
                                    </td>
                                    @foreach (Columna c in ColumnasVisibles)
                                    {
                                        <td class="@(c.Numero ? "num" : "") @c.Clase(x)" title="@c.Ayuda(x)"><span>@c.Valor(x)</span></td>
                                    }
                                </tr>
                            }
                            @if (Filas.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(ColumnasVisibles.Count + 1)" class="sin-filas">
                                        <i class="bi bi-inbox fs-4 d-block"></i>
                                        Sin comprobantes para este filtro.
                                        @if (!string.IsNullOrWhiteSpace(Busqueda) && MesesElegidos.Count < MesesDisponibles.Count)
                                        {
                                            <div class="mt-2">
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.Search" OnClick="BuscarEnTodoElAnio">Buscar en todo @Anio</MudButton>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </MudPaper>

            <div class="pie">
                <span class="conteo">
                    <i class="bi bi-files me-1"></i>
                    <b>@(Filas.Count == 0 ? 0 : Pagina * TamanoPagina + 1)–@(Pagina * TamanoPagina + Filas.Count)</b> de <b>@((Totales?.EnPestana ?? 0).ToString("N0"))</b> en el filtro
                    @if (TodoElFiltro)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">todo el filtro marcado</MudChip>
                    }
                    else if (Marcadas.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@Marcadas.Count marcados</MudChip>
                    }
                </span>

                @if (TotalPaginas > 1)
                {
                    <MudPagination Count="TotalPaginas" Selected="@(Pagina + 1)" SelectedChanged="p => IrPagina(p - 1)"
                                   ShowFirstButton="true" ShowLastButton="true" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   MiddleCount="3" BoundaryCount="1" />
                }

                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Class="importe">
                    Vigente <b>$@((Totales?.Vigente ?? 0).ToString("N2"))</b>
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Class="importe">
                    Cancelado <b>$@((Totales?.Cancelado ?? 0).ToString("N2"))</b>
                </MudChip>

                <span class="flex-grow-1"></span>

                <div class="campo filtrar">
                    <MudSelect T="string" Value="Filtrar" ValueChanged="CambiarFiltrar" Label="Filtrar" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Dense="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterAlt">
                        <MudSelectItem Value="@("")">Todos</MudSelectItem>
                        <MudSelectItem Value="@("vigentes")">Vigentes</MudSelectItem>
                        <MudSelectItem Value="@("cancelados")">Cancelados</MudSelectItem>
                        <MudSelectItem Value="@("sinvalidar")">Sin validar en SAT</MudSelectItem>
                        <MudSelectItem Value="@("duplicados")">Duplicados (mismo UUID en varios XML)</MudSelectItem>
                        <MudSelectItem Value="@("ppd")">PPD (pago en parcialidades)</MudSelectItem>
                        <MudSelectItem Value="@("relacionados")">Relacionados (el que relaciona y el relacionado)</MudSelectItem>
                    </MudSelect>
                </div>

                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                    <MudButton StartIcon="@Icons.Material.Filled.ViewColumn" OnClick='() => AbrirModal("columnas")'>Columnas</MudButton>
                    <MudButton StartIcon="@(MostrarDetalles ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                               OnClick="() => MostrarDetalles = !MostrarDetalles">@(MostrarDetalles ? "Ocultar detalles" : "Mostrar detalles")</MudButton>
                </MudButtonGroup>
            </div>

            @* Detalle a la izquierda y totales por tipo a la derecha en 2 columnas; sin detalle, los totales en una fila. *@
            <div class="zona-inferior @(MostrarDetalles ? "" : "sin-detalles")">
            @if (Totales is { } t)
            {
                <div class="kpis">
                    @foreach (var (titulo, cantidad, total, tono, icono) in new[]
                    {
                        ("Facturas", t.Facturas.Cantidad, t.Facturas.Total, "azul", "bi-receipt"),
                        ("Nómina 1.1", t.Nominas11.Cantidad, t.Nominas11.Total, "verde", "bi-people"),
                        ("Nómina 1.2", t.Nominas12.Cantidad, t.Nominas12.Total, "verde", "bi-people"),
                        ("Notas de crédito", t.NotasCredito.Cantidad, t.NotasCredito.Total, "mal", "bi-arrow-counterclockwise"),
                        ("Traslados", t.Traslados.Cantidad, t.Traslados.Total, "ambar", "bi-truck"),
                        ("Pagos", t.Pagos.Cantidad, t.Pagos.Total, "morado", "bi-cash-coin")
                    })
                    {
                        // Nómina 1.1 dejó de emitirse el 1 de abril de 2017: solo se muestra si el filtro trae alguna.
                        if (titulo == "Nómina 1.1" && cantidad == 0)
                        {
                            continue;
                        }

                        <div class="kpi tono-@tono" title="@titulo: @cantidad.ToString("N0") · $@total.ToString("N2")">
                            <span class="ic"><i class="bi @icono"></i></span>
                            <div class="kpi-texto">
                                <div class="kpi-titulo"><span class="kpi-nombre">@titulo</span><span class="cantidad">@cantidad.ToString("N0")</span></div>
                                <div class="kpi-valor">$@total.ToString("N2")</div>
                            </div>
                        </div>
                    }
                    <div class="kpi tono-todos" title="Archivos XML: @t.Archivos.ToString("N0")">
                        <span class="ic"><i class="bi bi-files"></i></span>
                        <div class="kpi-texto">
                            <div class="kpi-titulo">Archivos XML</div>
                            <div class="kpi-valor">@t.Archivos.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            }

            @if (MostrarDetalles)
            {
                <div class="detalles @(VerRelacionados && Relacionados.Count > 0 ? "con-relacionados" : "")">
                    <MudPaper Elevation="1" Class="detalle-tablas">
                        <div class="detalle-encabezado">
                            @* Las pestañas solo eligen qué se ve abajo; el contenido se pinta fuera de MudTabs. *@
                            <MudTabs ActivePanelIndex="IndiceDetalle" ActivePanelIndexChanged="i => CambiarDetalle(PestanasDetalle[i].Clave)"
                                     Elevation="0" Color="Color.Transparent" SliderColor="Color.Primary" MinimumTabWidth="0px"
                                     Class="detalle-pestanas" TabPanelsClass="d-none">
                                @foreach (var (_, titulo) in PestanasDetalle)
                                {
                                    <MudTabPanel Text="@titulo" />
                                }
                            </MudTabs>
                            @* Solo cuando el comprobante relaciona otros CFDI o algún CFDI lo relaciona a él. *@
                            @if (Relacionados.Count > 0)
                            {
                                <MudButton Size="Size.Small" Variant="@(VerRelacionados ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Link" OnClick="() => VerRelacionados = !VerRelacionados" Class="me-1">
                                    Relacionados (@Relacionados.Count)
                                </MudButton>
                            }
                        </div>
                        <div class="detalle-cuerpo">
                            @if (Activa is null)
                            {
                                <p class="secundario pa-3 mb-0">Selecciona un comprobante.</p>
                            }
                            else if (Det == "conceptos")
                            {
                                <MudSimpleTable Dense="true" Striped="true" Elevation="0" Square="true">
                                    <thead><tr><th>ClaveProdServ</th><th>NoIdentificación</th><th class="num">Cantidad</th><th>Clave unidad</th><th>Unidad</th><th>Descripción</th><th class="num">Valor unitario</th><th class="num">Descuento</th><th class="num">Importe</th></tr></thead>
                                    <tbody>
                                        @foreach (ConceptoDto k in Conceptos)
                                        {
                                            <tr><td>@k.ClaveProdServ</td><td>@k.NoIdentificacion</td><td class="num">@k.Cantidad.ToString("N2")</td><td>@k.ClaveUnidad</td><td>@k.Unidad</td><td class="largo" title="@k.Descripcion">@k.Descripcion</td><td class="num">@k.ValorUnitario.ToString("N2")</td><td class="num">@((k.Descuento ?? 0).ToString("N2"))</td><td class="num">@k.Importe.ToString("N2")</td></tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                            else if (Det == "impuestos")
                            {
                                <MudSimpleTable Dense="true" Striped="true" Elevation="0" Square="true">
                                    <thead><tr><th>Concepto</th><th>Tipo</th><th>Impuesto</th><th>Factor</th><th class="num">Tasa o cuota</th><th class="num">Base</th><th class="num">Importe</th></tr></thead>
                                    <tbody>
                                        @for (int i = 0; i < Conceptos.Count; i++)
                                        {
                                            int n = i + 1;
                                            foreach (ImpuestoDto imp in Conceptos[i].Impuestos)
                                            {
                                                <tr><td>@n</td><td>@imp.Tipo</td><td>@NombreImpuesto(imp.Impuesto)</td><td>@imp.TipoFactor</td><td class="num">@imp.Tasa.ToString("0.######")</td><td class="num">@imp.Base.ToString("N2")</td><td class="num">@imp.Importe.ToString("N2")</td></tr>
                                            }
                                        }
                                    </tbody>
                                </MudSimpleTable>
                                <div class="d-flex flex-wrap gap-1 pa-1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">IVA @Activa.Iva.ToString("N2")</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">IEPS @Activa.Ieps.ToString("N2")</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Ret. IVA @Activa.RetIva.ToString("N2")</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Ret. ISR @Activa.RetIsr.ToString("N2")</MudChip>
                                </div>
                            }
                            else if (Det == "complemento")
                            {
                                <div class="pa-2">
                                    @if (ComplementosDetalle.Count == 0)
                                    {
                                        <p class="secundario mb-0">Sin complementos.</p>
                                    }
                                    @foreach (NodoXml n in ComplementosDetalle)
                                    {
                                        @PintarNodo(n)
                                    }
                                </div>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Striped="true" Elevation="0" Square="true">
                                    <thead><tr><th>Tipo</th><th>Impuesto</th><th class="num">Tasa</th><th class="num">Importe</th></tr></thead>
                                    <tbody>
                                        @foreach (ImpuestoLocalDto l in ImpuestosLocales)
                                        {
                                            <tr><td>@l.Tipo</td><td>@l.Nombre</td><td class="num">@l.Tasa.ToString("0.####")</td><td class="num">@l.Importe.ToString("N2")</td></tr>
                                        }
                                        @if (ImpuestosLocales.Count == 0)
                                        {
                                            <tr><td colspan="4" class="secundario">Sin impuestos locales.</td></tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </div>
                    </MudPaper>
                    @* Se abre con el botón Relacionados; se cierra con el mismo botón o al cambiar de comprobante. *@
                    @if (VerRelacionados && Relacionados.Count > 0)
                    {
                        <MudPaper Elevation="1" Class="relacionados">
                            <div class="relacionados-encabezado">
                                <span class="flex-grow-1"><i class="bi bi-link-45deg me-1"></i>Relacionados</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Cerrar" OnClick="() => VerRelacionados = false" />
                            </div>
                            <div class="relacionados-lista">
                                @foreach (var grupo in Relacionados.GroupBy(r => r.RelacionaAEste))
                                {
                                    <div class="grupo">@(grupo.Key ? "Lo relacionan" : "Este CFDI relaciona")</div>
                                    @foreach (CfdiRelacionadoDto r in grupo)
                                    {
                                        <div class="relacionado @(r.RelacionaAEste && r.TipoRelacion == "04" ? "sustituido" : "")">
                                            <span class="tipo-relacion" title="Tipo de relación @r.TipoRelacion · @NombreTipoRelacion(r.TipoRelacion)">
                                                @r.TipoRelacion · @(r.RelacionaAEste ? NombreRelacionInversa(r.TipoRelacion) : NombreTipoRelacion(r.TipoRelacion))
                                            </span>
                                            @if (r.EnBase)
                                            {
                                                <span class="datos">
                                                    @r.TipoCfdi · @(string.IsNullOrEmpty(r.Serie) ? "" : r.Serie + " ")@r.Folio
                                                    · @r.FechaEmision?.ToString("dd/MM/yyyy") · $@r.Total.ToString("N2")
                                                    @if (r.EstadoSat.StartsWith("Cancel", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="ms-1">Cancelado</MudChip>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="datos secundario">No está en la bóveda</span>
                                            }
                                            <span class="font-monospace uuid" title="@r.UUID">@r.UUID</span>
                                        </div>
                                    }
                                }
                            </div>
                        </MudPaper>
                    }
                </div>
            }
            </div>
        </section>

        @* Solo los botones que el usuario tiene asignados (Configuración → Usuarios → Herramientas de XML). *@
        @if (HerramientasPermitidas.Count > 0)
        {
            <MudPaper Elevation="1" Class="herramientas">
                <div class="seccion">Herramientas</div>
                @foreach (Tarea t in HerramientasPermitidas)
                {
                    var (tono, accion) = AccionesHerramientas[t.Clave];
                    <button type="button" class="herramienta" @onclick="accion">
                        <span class="ic tono-@tono"><i class="bi @t.Icono"></i></span>@t.Nombre
                    </button>
                }
            </MudPaper>
        }
    }

    <MudDialog Visible="@(Modal != "")" VisibleChanged="v => { if (!v) CerrarModal(); }" Options="OpcionesModal">
        <TitleContent>
            <span class="d-flex align-items-center gap-2">
                <i class="bi @IconoModal"></i>@TituloModal
            </span>
        </TitleContent>
        <DialogContent>
            <div class="dialogo">
            @switch (Modal)
            {
                case "xml":
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                                   Href="@UrlCfdi(ActivaId, "xml", true)" Target="_blank">Descargar XML</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="GenerarPdf">Ver PDF</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="Localizar">Localizar en carpeta</MudButton>
                    </div>
                    <pre class="codigo">@TextoXml</pre>
                    break;

                case "columnas":
                    <p class="secundario small">La selección se guarda en este navegador.</p>
                    <div class="columnas-elegir">
                        @foreach (Columna c in Columnas)
                        {
                            <MudCheckBox T="bool" Value="@(!Ocultas.Contains(c.Clave))" ValueChanged="v => AlternarColumna(c.Clave, v)"
                                         Label="@c.Titulo" Size="Size.Small" Dense="true" Color="Color.Primary" />
                        }
                    </div>
                    break;

                case "importar":
                case "externos":
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Los XML se importan a <b>@EmpresaContext.NombreEmpresa</b> igual que en Importaciones: se clasifican como
                        emitidos o recibidos, se copian a <b>@RutaEmpresa</b> y se registran en la base de datos. Los repetidos se actualizan.
                    </MudAlert>
                    @if (Modal == "importar")
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".xml" MaximumFileCount="5000" OnFilesChanged="ElegirArchivos">
                                <CustomContent>
                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile" OnClick="@context.OpenFilePickerAsync">
                                        Elegir archivos XML
                                    </MudButton>
                                </CustomContent>
                            </MudFileUpload>
                            <span class="secundario small">@(ArchivosElegidos.Count == 0 ? "Ningún archivo elegido" : $"{ArchivosElegidos.Count:N0} archivo(s) elegido(s)")</span>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" Class="ms-auto"
                                       Disabled="@(ArchivosElegidos.Count == 0 || Cancelacion is not null)" OnClick="ImportarArchivos">
                                Importar @ArchivosElegidos.Count archivo(s)
                            </MudButton>
                        </div>
                        <MudDivider Class="mb-3" />
                    }
                    <div class="d-flex align-items-center gap-2">
                        <MudTextField T="string" @bind-Value="CarpetaImportar" Label="Carpeta completa (incluye subcarpetas), por ejemplo la bóveda de AdminXML"
                                      Placeholder="@($@"C:\AdminXML\BovedaCFDi\{EmpresaContext.Rfc}")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Folder" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder" Class="text-nowrap"
                                   Disabled="@(Cancelacion is not null)" OnClick="ImportarCarpeta">Importar carpeta</MudButton>
                    </div>
                    break;

                case "agrupaciones":
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <MudSelect T="string" @bind-Value="AgruparPor" @bind-Value:after="CargarAgrupaciones" Label="Agrupar por"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" FullWidth="false" Style="min-width: 200px">
                            <MudSelectItem Value="@("emisor")">Emisor</MudSelectItem>
                            <MudSelectItem Value="@("receptor")">Receptor</MudSelectItem>
                            <MudSelectItem Value="@("mes")">Mes</MudSelectItem>
                            <MudSelectItem Value="@("uso")">Uso CFDI</MudSelectItem>
                            <MudSelectItem Value="@("metodo")">Método de pago</MudSelectItem>
                            <MudSelectItem Value="@("tipo")">Tipo</MudSelectItem>
                        </MudSelect>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.GridOn"
                                   OnClick='() => Exportar("agrupado:" + AgruparPor)'>Exportar a Excel</MudButton>
                    </div>
                    <p class="secundario small">Facturas menos notas de crédito del filtro actual (sin importar la pestaña).</p>
                    <MudSimpleTable Dense="true" Striped="true" Hover="true" Elevation="0" Outlined="true">
                        <thead><tr><th>Clave</th><th>Nombre</th><th class="num">Comprobantes</th><th class="num">SubTotal</th><th class="num">IVA</th><th class="num">Total</th></tr></thead>
                        <tbody>
                            @foreach (AdminXmlAgrupacionDto a in Agrupaciones)
                            {
                                <tr><td class="font-monospace">@a.Clave</td><td class="largo" title="@a.Nombre">@a.Nombre</td><td class="num">@a.Cantidad</td><td class="num">@a.Subtotal.ToString("N2")</td><td class="num">@a.Iva.ToString("N2")</td><td class="num fw-semibold">@a.Total.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    break;

                case "renombrar":
                    <CFDIManager.Web.Components.AdministracionXml.RenombrarXmlAsistente
                        Ejemplo="@(Activa ?? Filas.FirstOrDefault())"
                        Alcance="@DescribirAlcance()"
                        OnIniciar="Renombrar" />
                    break;

                case "logos":
                    <p class="secundario small">El logo del RFC emisor aparece en sus PDF. PNG o JPG.</p>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <MudTextField T="string" @bind-Value="RfcLogo" Label="RFC" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Class="rfc-logo" InputClass="font-monospace text-uppercase" />
                        <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" OnFilesChanged="GuardarLogo">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Image" OnClick="@context.OpenFilePickerAsync">Subir logo</MudButton>
                            </CustomContent>
                        </MudFileUpload>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <MudTextField T="string" @bind-Value="LogoSinube" Label="De SINUBE" Placeholder="Dirección del logo o HTML del formato de SINUBE"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CloudDownload" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ImportarLogo" Disabled="@(string.IsNullOrWhiteSpace(LogoSinube))">Importar</MudButton>
                    </div>
                    <div class="logos">
                        @foreach (string rfc in LogosGuardados)
                        {
                            <MudPaper Outlined="true" Class="logo">
                                <img src="/api/logos/@rfc?v=@VersionLogos" alt="Logo de @rfc" />
                                <span class="small font-monospace">@rfc</span>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="() => QuitarLogo(rfc)">Quitar</MudButton>
                            </MudPaper>
                        }
                        @if (LogosGuardados.Count == 0)
                        {
                            <p class="secundario">Aún no hay logos.</p>
                        }
                    </div>
                    break;

                case "series":
                    <p class="secundario small">Folios numéricos del filtro actual (sin importar la pestaña).</p>
                    <MudSimpleTable Dense="true" Striped="true" Elevation="0" Outlined="true">
                        <thead><tr><th>Serie</th><th>Tipos</th><th class="num">Desde</th><th class="num">Hasta</th><th class="num">Cantidad</th><th>Faltantes</th><th>Repetidos</th></tr></thead>
                        <tbody>
                            @foreach (AdminXmlSerieDto s in Series)
                            {
                                <tr>
                                    <td class="fw-semibold">@s.Serie</td><td>@s.Tipos</td><td class="num">@s.Desde</td><td class="num">@s.Hasta</td><td class="num">@s.Cantidad</td>
                                    <td class="@(s.Faltantes.Count > 0 ? "mal" : "ok") ajusta">@(s.Faltantes.Count == 0 ? "Ninguno" : $"{s.Faltantes.Count}{(s.Faltantes.Count >= 500 ? "+" : "")}: {string.Join(", ", s.Faltantes.Take(60))}{(s.Faltantes.Count > 60 ? "…" : "")}")</td>
                                    <td class="@(s.Repetidos.Count > 0 ? "mal" : "ok") ajusta">@(s.Repetidos.Count == 0 ? "Ninguno" : string.Join(", ", s.Repetidos.Take(30)))</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    break;

                case "complemento":
                    @if (Complementos.Count == 0)
                    {
                        <p class="secundario">Sin complementos.</p>
                    }
                    @foreach (NodoXml n in Complementos)
                    {
                        @PintarNodo(n)
                    }
                    break;

                case "red":
                    <p>Los XML de <b>@EmpresaContext.NombreEmpresa</b> se guardan en:</p>
                    <pre class="codigo">@RutaEmpresa</pre>
                    <p class="secundario small mb-0 mt-2">
                        Todas las empresas usan la ruta XML general <code>@Rutas.CarpetaGeneral</code> más su RFC.
                        Para usar una carpeta de red (por ejemplo <code>\\servidor\Boveda</code>), cambia <code>AppSettings:CarpetaXml</code>
                        en appsettings.json y reinicia la aplicación.
                    </p>
                    break;

                case "enviarcfdi":
                    @if (PreparandoEnvio)
                    {
                        <div class="secundario py-4 text-center">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />Consultando correos…
                        </div>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Elevation="0" Outlined="true" Class="mb-3">
                            <thead>
                                <tr>
                                    <th style="width: 2rem"></th>
                                    <th>Para</th>
                                    <th class="num">CFDI</th>
                                    <th class="num">Total</th>
                                    <th style="min-width: 18rem">Correo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (GrupoEnvioCfdi g in GruposEnvio)
                                {
                                    <tr>
                                        <td><MudCheckBox T="bool" @bind-Value="g.Enviar" Disabled="@EnviandoCfdi" Size="Size.Small" Dense="true" Color="Color.Primary" /></td>
                                        <td>
                                            <div class="fw-semibold small">@g.Nombre</div>
                                            <div class="small secundario font-monospace">@g.Rfc@(g.NombreComercial != "" ? $" · {g.NombreComercial}" : "")</div>
                                        </td>
                                        <td class="num small" title="@string.Join(", ", g.Cfdis.Select(x => $"{x.Serie}{x.Folio}"))">@g.Cfdis.Count</td>
                                        <td class="num small">@g.Total.ToString("C2")</td>
                                        <td class="correos">
                                            <MudTextField T="string" @bind-Value="g.Para" Placeholder="Sin correo en SINUBE" Disabled="@EnviandoCfdi"
                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                          HelperText="@(g.Origen == "SINUBE" ? "Del catálogo de clientes de SINUBE" : "SINUBE no tiene correo para este cliente")" />
                                            <MudTextField T="string" @bind-Value="g.Adicionales" Placeholder="Correos adicionales" Disabled="@EnviandoCfdi"
                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                          HelperText="Adicionales: se recuerdan para este RFC; si los dejas vacíos, se borran" />
                                        </td>
                                        <td class="small">
                                            @if (g.Resultado == "Enviado")
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Enviado</MudChip>
                                            }
                                            else if (g.Resultado != "")
                                            {
                                                <span class="mal">@g.Resultado</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>

                        <div class="formulario-envio mb-3">
                            @if (GruposEnvio.Any(g => g.Cfdis.Any(x => x.TipoCfdi is not ("P" or "N"))))
                            {
                                <MudSelect T="string" @bind-Value="FormatoCfdiEnvio" Disabled="@EnviandoCfdi" Label="Formato del PDF"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (FormatoImpresionSinube f in FormatosEnvio.Where(f => f.Tipo == SinubeDatosService.FormatoFactura))
                                    {
                                        <MudSelectItem Value="@f.Nombre">@f.Nombre</MudSelectItem>
                                    }
                                    <MudSelectItem Value="@("")">Formato propio de CFDI Manager</MudSelectItem>
                                </MudSelect>
                            }
                            @if (GruposEnvio.Any(g => g.Cfdis.Any(x => x.TipoCfdi == "P")))
                            {
                                <MudSelect T="string" @bind-Value="FormatoPagoEnvio" Disabled="@EnviandoCfdi" Label="Formato de los pagos"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (FormatoImpresionSinube f in FormatosEnvio.Where(f => f.Tipo == SinubeDatosService.FormatoPago))
                                    {
                                        <MudSelectItem Value="@f.Nombre">@f.Nombre</MudSelectItem>
                                    }
                                    <MudSelectItem Value="@("")">Formato propio de CFDI Manager</MudSelectItem>
                                </MudSelect>
                            }
                        </div>

                        <div class="formulario-envio mb-3">
                            <div>
                                <MudTextField T="string" @bind-Value="CcEnvio" Disabled="@EnviandoCfdi" Label="Con copia (CC)"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                @if (MiCorreoEnvio != "")
                                {
                                    <MudCheckBox T="bool" @bind-Value="CopiaParaMiEnvio" Disabled="@EnviandoCfdi" Size="Size.Small" Dense="true"
                                                 Color="Color.Primary" Label="@($"Enviarme una copia ({MiCorreoEnvio})")" Class="mt-1" />
                                }
                            </div>
                            <MudTextField T="string" @bind-Value="MensajeEnvio" Disabled="@EnviandoCfdi" Label="Mensaje" Lines="3"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="small secundario">PDF y XML de cada CFDI · un correo por destinatario</span>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ms-auto" OnClick="EnviarCfdis"
                                       Disabled="@(EnviandoCfdi || !GruposEnvio.Any(g => g.Enviar && g.Resultado != "Enviado"))"
                                       StartIcon="@(EnviandoCfdi ? null : Icons.Material.Filled.Send)">
                                @if (EnviandoCfdi)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                }
                                Enviar @GruposEnvio.Count(g => g.Enviar && g.Resultado != "Enviado") correo(s)
                            </MudButton>
                        </div>
                    }
                    break;

                case "imagen":
                    <MudRadioGroup T="string" @bind-Value="FormaImagen" Class="formas-imagen mb-3">
                        @foreach (var (clave, titulo, icono) in FormasImagen)
                        {
                            <MudPaper Outlined="true" Class="@($"forma-imagen {(FormaImagen == clave ? "elegida" : "")}")">
                                <MudRadio T="string" Value="clave" Color="Color.Primary" Dense="true">
                                    <i class="bi @icono me-2"></i>@titulo
                                </MudRadio>
                            </MudPaper>
                        }
                    </MudRadioGroup>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small secundario">@TextoPeriodo()</span>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ms-auto" OnClick="ImagenResumen" Disabled="@GenerandoImagen"
                                   StartIcon="@(GenerandoImagen ? null : Icons.Material.Filled.Download)">
                            @if (GenerandoImagen)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            }
                            Descargar imagen
                        </MudButton>
                    </div>
                    break;
            }
            </div>
        </DialogContent>
    </MudDialog>
</div>

<EnviarCorreoModal Visible="AdjuntosCorreo.Count > 0"
                   Adjuntos="AdjuntosCorreo"
                   AsuntoSugerido="@($"Reporte de XML {EmpresaContext.NombreEmpresa}")"
                   Datos="@([("Empresa", EmpresaContext.NombreEmpresa), ("RFC", EmpresaContext.Rfc)])"
                   EmpresaId="EmpresaContext.EmpresaId"
                   Imagen="ImagenCorreo"
                   OnCerrar="() => AdjuntosCorreo = []"
                   OnEnviado="texto => Avisar(texto)" />

@code {
    private const int TamanoPagina = 200;

    // Panel derecho: el texto, el icono y el orden salen de Tareas.HerramientasXml; aquí el color y la acción de cada uno.
    private Dictionary<string, (string Tono, Func<Task> Accion)> AccionesHerramientas => new()
    {
        ["xml-exportar-excel"] = ("verde", ExportarReporteElegido),
        ["xml-imagen-resumen"] = ("morado", Sincrona(() => AbrirModal("imagen"))),
        ["xml-enviar-correo"] = ("azul", PrepararCorreo),
        ["xml-enviar-cfdi"] = ("verde", PrepararEnvioCfdi),
        ["xml-abrir-xml"] = ("azul", Sincrona(AbrirXml)),
        ["xml-generar-pdf"] = ("rojo", GenerarPdf),
        ["xml-validar-sat"] = ("azul", ValidarEstadoSat),
        ["xml-localizar"] = ("azul", Sincrona(Localizar)),
        ["xml-importar"] = ("azul", Sincrona(() => AbrirModal("importar"))),
        ["xml-zip-xml"] = ("ambar", DescargarZipXml),
        ["xml-zip-pdf"] = ("rojo", DescargarZipPdf),
        ["xml-agrupaciones"] = ("ambar", Sincrona(() => AbrirModal("agrupaciones"))),
        ["xml-renombrar"] = ("azul", Sincrona(() => AbrirModal("renombrar"))),
        ["xml-logos"] = ("ambar", Sincrona(() => AbrirModal("logos"))),
        ["xml-series"] = ("azul", Sincrona(() => AbrirModal("series"))),
        ["xml-complemento"] = ("verde", Sincrona(LeerComplemento)),
        ["xml-externos"] = ("ambar", Sincrona(() => AbrirModal("externos"))),
        ["xml-direccion-datos"] = ("azul", Sincrona(() => AbrirModal("red")))
    };

    // Botones y reportes que el usuario tiene asignados (Administrador: todos); se calculan al abrir la página.
    // Sin ningún reporte, "Exportar a Excel" no tiene qué exportar y no se muestra.
    private List<Tarea> HerramientasPermitidas = new();
    private List<Tarea> ReportesPermitidos = new();

    private async Task CargarHerramientasPermitidas()
    {
        System.Security.Claims.ClaimsPrincipal usuario = await Acceso.ObtenerUsuarioActualAsync();

        async Task<List<Tarea>> SoloPermitidas(IEnumerable<Tarea> tareas)
        {
            List<Tarea> permitidas = new();

            foreach (Tarea t in tareas)
            {
                if ((await Autorizacion.AuthorizeAsync(usuario, t.Politica)).Succeeded)
                {
                    permitidas.Add(t);
                }
            }

            return permitidas;
        }

        ReportesPermitidos = await SoloPermitidas(Tareas.ReportesXml);
        HerramientasPermitidas = (await SoloPermitidas(Tareas.HerramientasXml))
            .Where(t => t.Clave != "xml-exportar-excel" || ReportesPermitidos.Count > 0)
            .ToList();
        AjustarTipoReporte();
    }

    // Reportes permitidos que aplican al filtro: emisor en recibidos o receptor en emitidos; por mes con varios meses.
    private List<(string Tipo, string Nombre)> ReportesVisibles =>
        ReportesPermitidos
            .Where(r => r.Ruta != "agrupado:mes" || VariosMeses)
            .Select(r => r.Ruta == "agrupado:contraparte"
                ? Clasificacion == "RECIBIDO" ? ("agrupado:emisor", "Agrupado por emisor") : ("agrupado:receptor", "Agrupado por receptor")
                : (r.Ruta, r.Nombre))
            .ToList();

    // Revisa otra vez el permiso: el reporte elegido debe estar entre los visibles del usuario.
    private Task ExportarReporteElegido()
    {
        AjustarTipoReporte();

        if (!ReportesVisibles.Any(r => r.Tipo == TipoReporte))
        {
            Avisar("No tienes asignado ese reporte.", error: true);
            return Task.CompletedTask;
        }

        return Exportar(TipoReporte);
    }

    private void AjustarTipoReporte()
    {
        List<(string Tipo, string Nombre)> visibles = ReportesVisibles;

        if (visibles.Count > 0 && !visibles.Any(r => r.Tipo == TipoReporte))
        {
            TipoReporte = visibles.Any(r => r.Tipo == "general") ? "general" : visibles[0].Tipo;
        }
    }

    private static Func<Task> Sincrona(Action accion) => () =>
    {
        accion();
        return Task.CompletedTask;
    };

    private string IconoModal => Modal switch
    {
        "xml" => "bi-filetype-xml",
        "columnas" => "bi-layout-three-columns",
        "importar" => "bi-upload",
        "externos" => "bi-box-arrow-in-down",
        "agrupaciones" => "bi-diagram-3",
        "renombrar" => "bi-input-cursor-text",
        "logos" => "bi-images",
        "series" => "bi-123",
        "complemento" => "bi-braces",
        "red" => "bi-hdd-network",
        "imagen" => "bi-image",
        "enviarcfdi" => "bi-send",
        _ => "bi-window"
    };

    // Reporte en Excel listo para enviar por correo (mientras tenga archivos, el diálogo está abierto).
    private List<CFDIManager.Web.Services.Correo.AdjuntoCorreo> AdjuntosCorreo = [];
    private byte[]? ImagenCorreo;

    // ---------- Enviar CFDI: PDF (formato SINUBE) y XML, un correo por contraparte ----------
    private const int MaximoEnvioCfdi = 200;
    private List<GrupoEnvioCfdi> GruposEnvio = [];
    private bool PreparandoEnvio;
    private bool EnviandoCfdi;
    private string CcEnvio = "";
    private string MiCorreoEnvio = "";
    private bool CopiaParaMiEnvio;
    private string MensajeEnvio = "Buen día:\nTe envío los comprobantes fiscales (PDF y XML) adjuntos.\nSaludos.";

    private static string ClaveCcEnvio(long empresaId) => $"correo_cfdi_cc:{empresaId}";

    // Formatos de impresión de SINUBE (su plantilla vigente); "" es el formato propio. Se recuerdan por empresa.
    private List<FormatoImpresionSinube> FormatosEnvio = [];
    private string FormatoCfdiEnvio = "";
    private string FormatoPagoEnvio = "";

    private static string ClaveFormatoEnvio(long empresaId, int tipo) => $"formato_pdf_cfdi:{empresaId}:{tipo}";

    private string FormatoInicial(long empresaId, int tipo)
    {
        string? recordado = Repo.ObtenerConfiguracionApp(ClaveFormatoEnvio(empresaId, tipo));
        List<FormatoImpresionSinube> deTipo = FormatosEnvio.Where(f => f.Tipo == tipo).ToList();

        if (recordado is not null && (recordado == "" || deTipo.Any(f => f.Nombre == recordado)))
            return recordado;

        return deTipo.FirstOrDefault()?.Nombre ?? "";
    }

    private FormatoImpresionSinube? FormatoElegido(string nombre, int tipo) =>
        nombre == "" ? null : FormatosEnvio.FirstOrDefault(f => f.Tipo == tipo && f.Nombre == nombre);

    /// <summary>Los marcados o, si no hay, el comprobante activo.</summary>
    private async Task PrepararEnvioCfdi()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        List<long> ids = !TodoElFiltro && Marcadas.Count > 0 ? Marcadas.ToList() : Activa is not null ? [ActivaId] : [];

        if (ids.Count == 0)
        {
            Avisar("Selecciona o marca los comprobantes a enviar.", error: true);
            return;
        }

        if (ids.Count > MaximoEnvioCfdi)
        {
            Avisar($"Marca hasta {MaximoEnvioCfdi} comprobantes por envío.", error: true);
            return;
        }

        GruposEnvio = [];
        // CC que la empresa usa siempre (p. ej. sus propios correos de ventas): el último capturado.
        CcEnvio = Repo.ObtenerConfiguracionApp(ClaveCcEnvio(empresa.EmpresaId)) ?? "";

        // Copia para el usuario que envía (su correo de Usuarios), marcada de entrada como en "Enviar por correo".
        var yo = await Acceso.ObtenerUsuarioActualAsync();
        MiCorreoEnvio = CFDIManager.Web.Services.Seguridad.AccesoEmpresasService.ObtenerUsuarioId(yo) is long idUsuario
            ? Repo.ObtenerUsuarioPorId(idUsuario)?.Email ?? ""
            : "";
        CopiaParaMiEnvio = MiCorreoEnvio != "";
        PreparandoEnvio = true;
        TituloModal = "Enviar CFDI";
        Modal = "enviarcfdi";
        StateHasChanged();

        try
        {
            Task<List<FormatoImpresionSinube>> formatos = EnvioCfdi.FormatosAsync(empresa);
            GruposEnvio = await EnvioCfdi.PrepararAsync(empresa, ids);
            FormatosEnvio = await formatos;
            FormatoCfdiEnvio = FormatoInicial(empresa.EmpresaId, SinubeDatosService.FormatoFactura);
            FormatoPagoEnvio = FormatoInicial(empresa.EmpresaId, SinubeDatosService.FormatoPago);
        }
        catch (Exception ex)
        {
            CerrarModal();
            Avisar(ex.Message, error: true);
        }
        finally
        {
            PreparandoEnvio = false;
        }
    }

    private async Task EnviarCfdis()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        EnviandoCfdi = true;
        var usuario = await Acceso.ObtenerUsuarioActualAsync();
        string enviadoPor = usuario.FindFirst(CFDIManager.Web.Services.Seguridad.UsuarioClaimsFactory.NombreCompleto)?.Value ?? usuario.Identity?.Name ?? "";
        List<string> cc = CFDIManager.Web.Services.Correo.CorreoService.SepararCorreos(CcEnvio);
        Repo.GuardarConfiguracionApp(ClaveCcEnvio(empresa.EmpresaId), string.Join(", ", cc));

        if (CopiaParaMiEnvio && MiCorreoEnvio != "" && !cc.Contains(MiCorreoEnvio, StringComparer.OrdinalIgnoreCase))
            cc.Add(MiCorreoEnvio);

        FormatoImpresionSinube? formatoCfdi = FormatoElegido(FormatoCfdiEnvio, SinubeDatosService.FormatoFactura);
        FormatoImpresionSinube? formatoPago = FormatoElegido(FormatoPagoEnvio, SinubeDatosService.FormatoPago);
        if (FormatosEnvio.Count > 0)
        {
            if (GruposEnvio.Any(g => g.Cfdis.Any(x => x.TipoCfdi is not ("P" or "N"))))
                Repo.GuardarConfiguracionApp(ClaveFormatoEnvio(empresa.EmpresaId, SinubeDatosService.FormatoFactura), FormatoCfdiEnvio);
            if (GruposEnvio.Any(g => g.Cfdis.Any(x => x.TipoCfdi == "P")))
                Repo.GuardarConfiguracionApp(ClaveFormatoEnvio(empresa.EmpresaId, SinubeDatosService.FormatoPago), FormatoPagoEnvio);
        }

        foreach (GrupoEnvioCfdi g in GruposEnvio.Where(g => g.Enviar && g.Resultado != "Enviado"))
        {
            g.Resultado = "Enviando…";
            StateHasChanged();

            try
            {
                await EnvioCfdi.EnviarAsync(empresa, g, cc, MensajeEnvio, enviadoPor, formatoCfdi, formatoPago);
                g.Resultado = "Enviado";
            }
            catch (Exception ex)
            {
                g.Resultado = ex.Message;
            }

            StateHasChanged();
        }

        EnviandoCfdi = false;
        int enviados = GruposEnvio.Count(g => g.Resultado == "Enviado");
        Avisar($"{enviados} de {GruposEnvio.Count(g => g.Enviar)} correo(s) enviados.", error: enviados < GruposEnvio.Count(g => g.Enviar));
    }

    private async Task PrepararCorreo()
    {
        // El correo adjunta el reporte elegido: debe ser uno de los asignados al usuario.
        AjustarTipoReporte();

        if (!ReportesVisibles.Any(r => r.Tipo == TipoReporte))
        {
            Avisar("No tienes asignado ningún reporte para adjuntar.", error: true);
            return;
        }

        try
        {
            AdminXmlFiltroDto f = FiltroAccion();
            EmpresaDto empresa = EmpresaContext.EmpresaActiva!;
            (byte[] contenido, string nombre) = await Task.Run(() => Admin.GenerarExcel(empresa, f, TipoReporte));

            // Resumen dentro del correo, con el tema que el usuario tiene en la app.
            bool claroCorreo = await JS.InvokeAsync<string>("cfdiTheme.current") == "light";
            ImagenCorreo = await GenerarImagenResumen(empresa, "debajo", claroCorreo);

            AdjuntosCorreo =
            [
                new(nombre, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", contenido)
            ];
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
        }
    }

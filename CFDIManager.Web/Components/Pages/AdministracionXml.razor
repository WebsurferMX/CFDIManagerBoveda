    private string FormaImagen = "debajo";
    private bool GenerandoImagen;

    /// <summary>PNG con los totales del periodo de emitidos (ingresos) y/o recibidos (egresos), sin pestaña ni búsqueda.</summary>
    private async Task ImagenResumen()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
            return;

        GenerandoImagen = true;

        try
        {
            string periodo = TextoPeriodo();
            string forma = FormaImagen;

            // La imagen sigue el tema que el usuario tiene en la app (claro u oscuro).
            bool claro = await JS.InvokeAsync<string>("cfdiTheme.current") == "light";
            byte[] png = await GenerarImagenResumen(empresa, forma, claro);

            string lado = forma switch { "emitidos" => " Emitidos", "recibidos" => " Recibidos", _ => "" };
            string nombre = $"{empresa.Rfc} Resumen{lado} {periodo.Replace("–", "a").Replace(",", "")}.png";
            await JS.InvokeVoidAsync("descargarArchivoBase64", nombre, "image/png", Convert.ToBase64String(png));
            CerrarModal();
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
        }
        finally
        {
            GenerandoImagen = false;
        }
    }

    /// <summary>PNG con los totales del periodo (sin pestaña ni búsqueda) en la forma elegida.</summary>
    private Task<byte[]> GenerarImagenResumen(EmpresaDto empresa, string forma, bool claro)
    {
        AdminXmlFiltroDto Para(string clasificacion)
        {
            AdminXmlFiltroDto f = FiltroSinPestana();
            f.Clasificacion = clasificacion;
            f.Busqueda = "";
            f.Filtrar = "";
            return f;
        }

        string periodo = TextoPeriodo();
        var secciones = new List<CFDIManager.Web.Services.AdministracionXml.ResumenImagen.Seccion>();

        if (forma != "recibidos")
            secciones.Add(new("Emitidos", "ingresos", Repo.ObtenerTotalesAdministracionXml(Para("EMITIDO"))));
        if (forma != "emitidos")
            secciones.Add(new("Recibidos", "egresos", Repo.ObtenerTotalesAdministracionXml(Para("RECIBIDO"))));

        return Task.Run(() => CFDIManager.Web.Services.AdministracionXml.ResumenImagen.Generar(
            empresa.NombreParaMostrar, empresa.Rfc, periodo, secciones, claro: claro));
    }

    /// <summary>"Octubre 2026", "Septiembre – Octubre 2026", "Octubre 2026 · días 1, 2" o "Enero – Octubre 2026 (acumulado)".</summary>
    private string TextoPeriodo()
    {
        string Mes(int m) => Cultura.TextInfo.ToTitleCase(Cultura.DateTimeFormat.GetMonthName(m));
        List<int> meses = MesesElegidos.Order().ToList();

        if (Anio is not int anio || meses.Count == 0)
            return Anio?.ToString() ?? "";

        if (Acumular)
            return $"Enero – {Mes(meses[^1])} {anio} (acumulado)";

        string texto = meses.Count == 1 ? $"{Mes(meses[0])} {anio}"
            : meses.Count <= 3 ? $"{string.Join(", ", meses.Select(Mes))} {anio}"
            : $"{Mes(meses[0])} – {Mes(meses[^1])} {anio}";

        return MuestraDias && DiasElegidos.Count > 0 ? $"{texto} · días {string.Join(", ", DiasElegidos.Order())}" : texto;
    }


    private static readonly (string Clave, string Titulo, string Icono)[] FormasImagen =
    [
        ("emitidos", "Solo emitidos (ingresos)", "bi-box-arrow-up-right"),
        ("recibidos", "Solo recibidos (egresos)", "bi-box-arrow-in-down-left"),
        ("debajo", "Emitidos y recibidos", "bi-layout-three-columns")

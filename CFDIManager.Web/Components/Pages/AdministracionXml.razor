    // ---------- procesos con progreso ----------
    /// <param name="alAvanzar">Se llama con cada avance y al terminar (bajo el candado del resultado).</param>
    /// <param name="texto">Texto de avance propio; por omisión "hechos de total".</param>
    /// <param name="alTerminar">Se llama solo si el proceso terminó (no si se canceló o falló).</param>
    private async Task Ejecutar(string titulo, Func<IProgress<ResultadoProcesoXml>, CancellationToken, Task<ResultadoProcesoXml>> proceso, bool recargar,
        Action<ResultadoProcesoXml>? alAvanzar = null, Func<ResultadoProcesoXml, string>? texto = null,
        Func<ResultadoProcesoXml, Task>? alTerminar = null)
    {
        if (EnProceso)
        {
            Avisar("Ya hay un proceso en curso.", error: true);
            return;
        }

        Cancelacion = new CancellationTokenSource();
        Proceso = new ResultadoProcesoXml();
        TextoProceso = $"{titulo}…";

        var progreso = new Progress<ResultadoProcesoXml>(r =>
        {
            lock (r)
            {
                Proceso = r;
                alAvanzar?.Invoke(r);
                TextoProceso = texto?.Invoke(r) ?? $"{titulo}: {r.Hechos:N0} de {r.Total:N0}{(r.Errores > 0 ? $" · {r.Errores} errores" : "")}";
            }

            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            ResultadoProcesoXml r = await proceso(progreso, Cancelacion.Token);
            Proceso = r;

            lock (r)
            {
                alAvanzar?.Invoke(r);
            }

            string detalle = r.Detalle.Count > 0 ? " · " + string.Join(", ", r.Detalle.Select(d => $"{d.Key}: {d.Value}")) : "";
            TextoProceso = $"{titulo}: terminado ({r.Hechos:N0})";
            Avisar($"{titulo}: {r.Correctos:N0} correctos, {r.Errores:N0} con error{detalle}.", error: r.Errores > 0 && r.Correctos == 0, carpeta: r.Carpeta);

            if (alTerminar is not null)
            {
                await alTerminar(r);
            }
        }
        catch (OperationCanceledException)
        {
            TextoProceso = $"{titulo}: cancelado";
        }
        catch (Exception ex)
        {
            TextoProceso = $"{titulo}: error";
            Avisar(ex.Message, error: true);
        }
        finally
        {
            Cancelacion = null;
        }

        if (recargar)
        {
            await CargarOpciones();
        }
    }

    /// <summary>
    /// Valida los marcados o, si no hay, todo el filtro (con su pestaña): tres consultas a la vez, avance por tipo
    /// y cada celda de Estado SAT se actualiza al recibir la respuesta. "Cancelar" lo detiene.
    /// </summary>
    private async Task ValidarEstadoSat()
    {
        if (EnProceso)
        {
            Avisar("Ya hay un proceso en curso.", error: true);
            return;
        }

        List<AdminXmlFilaDto> filas;

        try
        {
            filas = Repo.ObtenerSeleccionAdministracionXml(FiltroAccion());
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
            return;
        }

        if (filas.Count == 0)
        {
            Avisar("No hay comprobantes para validar.", error: true);
            return;
        }

        string conteo = string.Join(", ", AdministracionXmlService.OrdenTiposSat
            .Select(t => (Tipo: t, Cantidad: filas.Count(x => x.TipoCfdi == t)))
            .Where(p => p.Cantidad > 0)
            .Select(p => $"{NombreTipo(p.Tipo)}: {p.Cantidad:N0}"));

        if (!await JS.InvokeAsync<bool>("confirm", $"Se validará el estado SAT de {filas.Count:N0} comprobantes ({conteo}). ¿Continuar?"))
        {
            return;
        }

        // Corre en segundo plano: sigue aunque se cambie de pantalla y al volver se ve su avance.
        if (!ValidacionesSat.Iniciar(EmpresaContext.EmpresaActiva!, filas))
        {
            Avisar("Ya hay una validación SAT en curso para esta empresa.", error: true);
            return;
        }

        Proceso = ValidacionesSat.Obtener(EmpresaContext.EmpresaId)?.Resultado;
        TextoProceso = "Valida Estado SAT…";
    }

    private bool ValidandoSat => ValidacionesSat.Obtener(EmpresaContext.EmpresaId) is { EnCurso: true };

    private bool EnProceso => Cancelacion is not null || ValidandoSat;

    private void CancelarProceso()
    {
        if (ValidandoSat)
            ValidacionesSat.Cancelar(EmpresaContext.EmpresaId);
        else
            Cancelacion?.Cancel();
    }

    private void ValidacionSatCambio(long empresaId)
    {
        if (empresaId == EmpresaContext.EmpresaId)
            _ = InvokeAsync(() =>
            {
                ConectarValidacionSat();
                StateHasChanged();
            });
    }

    /// <summary>Muestra el avance de la validación de la empresa activa y, al terminar, su resumen (una sola vez).</summary>
    private void ConectarValidacionSat()
    {
        if (ValidacionesSat.Obtener(EmpresaContext.EmpresaId) is not { } t)
            return;

        ResultadoProcesoXml r = t.Resultado;

        lock (r)
        {
            Proceso = r;
            PintarEstadosSat(r);

            TextoProceso = t.EnCurso
                ? $"Valida Estado SAT: {r.Hechos:N0} de {r.Total:N0} · " +
                  string.Join(" · ", r.PorTipo.Select(p => $"{NombreTipo(p.Key)} {p.Value.Hechos:N0}/{p.Value.Total:N0}")) +
                  (r.Errores > 0 ? $" · {r.Errores} sin respuesta" : "")
                : t.Error is not null ? "Valida Estado SAT: error"
                : t.Cancelado ? $"Valida Estado SAT: cancelado ({r.Hechos:N0} de {r.Total:N0})"
                : $"Valida Estado SAT: terminado ({r.Hechos:N0})";
        }

        if (!t.Terminado || t.Avisado)
            return;

        t.Avisado = true;

        if (t.Error is not null)
        {
            Avisar(t.Error, error: true);
            return;
        }

        string detalle = r.Detalle.Count > 0 ? " · " + string.Join(", ", r.Detalle.Select(d => $"{d.Key}: {d.Value}")) : "";
        Avisar($"Valida Estado SAT: {r.Correctos:N0} correctos, {r.Errores:N0} con error{detalle}.", error: r.Errores > 0 && r.Correctos == 0);

        // Vigente / Cancelado del pie cambian con los nuevos estados.
        Totales = Repo.ObtenerTotalesAdministracionXml(Filtro());
    }

    private void PintarEstadosSat(ResultadoProcesoXml r)
    {
        while (r.Estados.TryDequeue(out var e))
        {
            if (Filas.FirstOrDefault(f => f.CfdiId == e.CfdiId) is { } fila)
            {
                fila.EstadoSat = e.Estado;
                fila.FechaValidacionSat = DateTime.Now;
                fila.OrigenValidacionSat = "Consulta SAT";
            }
        }
    }



    private async Task GuardarLogo(InputFileChangeEventArgs e)
    {
        try
        {
            using var memoria = new MemoryStream();
            await e.File.OpenReadStream(5 * 1024 * 1024).CopyToAsync(memoria);
            Logos.Guardar(RfcLogo, memoria.ToArray());
            LogosGuardados = Logos.Listar();
            VersionLogos++;
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
        }
    }

    private string LogoSinube = "";

    private async Task ImportarLogo()
    {
        try
        {
            await Logos.ImportarAsync(RfcLogo, LogoSinube);
            LogoSinube = "";
            LogosGuardados = Logos.Listar();
            VersionLogos++;
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
        }
    }

    private void QuitarLogo(string rfc)
    {
        Logos.Quitar(rfc);
        LogosGuardados = Logos.Listar();
    }

        Relacionados = x is null ? new() : Repo.ObtenerRelacionadosCfdi(EmpresaContext.EmpresaId, x.CfdiId);

        // La tarjeta de relacionados se abre con su pestaña para cada comprobante.
        if (x?.CfdiId != _relacionadosDe)
        {
            VerRelacionados = false;
        }

        _relacionadosDe = x?.CfdiId;
        ImpuestosLocales = new();
        ComplementosDetalle = new();

@page "/"
@page "/resumen"
@implements IDisposable

@using System.Globalization
@using CFDIParser.Models
@using CFDIParser.Services
@using CFDIManager.Web.Services

@inject PostgreSqlRepository Repo
@inject EmpresaContext EmpresaContext

<PageTitle>CFDI Manager</PageTitle>

@* Tabler solo en esta pantalla: en toda la app cambia el aspecto de las que ya estaban terminadas. *@
<HeadContent>
    <link rel="stylesheet" href="lib/tabler/css/tabler.min.css" />
</HeadContent>

<div class="resumen">
    @* ---------- Encabezado y periodo ---------- *@
    <div class="page-header mb-3">
        <div class="row g-3 align-items-end">
            <div class="col">
                <div class="page-pretitle">CFDI Manager · @RfcEmpresa</div>
                <h2 class="page-title">Resumen fiscal</h2>
                <div class="text-secondary mt-1">CFDI emitidos y recibidos del periodo.</div>
            </div>

            <div class="col-auto">
                <div class="d-flex flex-wrap align-items-end gap-2">
                    <div>
                        <label class="form-label mb-1">Fecha inicial</label>
                        <FechaInput @bind-Valor="FechaInicio" />
                    </div>
                    <div>
                        <label class="form-label mb-1">Fecha final</label>
                        <FechaInput @bind-Valor="FechaFin" />
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="CargarDashboard" disabled="@Cargando">
                        <i class="ti ti-refresh me-1"></i>@(Cargando ? "Actualizando…" : "Consultar")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">
            <div class="d-flex gap-2">
                <i class="ti ti-alert-octagon fs-2"></i>
                <div>
                    <h4 class="alert-title">No se pudo cargar el resumen</h4>
                    <div class="text-secondary">@Error</div>
                </div>
            </div>
        </div>
    }
    else if (Cargando)
    {
        <div class="card">
            <div class="card-body">
                <div class="text-secondary mb-2">Consultando información en PostgreSQL…</div>
                <div class="progress progress-sm"><div class="progress-bar progress-bar-indeterminate"></div></div>
            </div>
        </div>
    }
    else
    {
        <ul class="nav nav-pills mb-3 paginas">
            @foreach (var (clave, titulo, icono) in Paginas)
            {
                <li class="nav-item">
                    <button type="button" class="nav-link @(Pagina == clave ? "active" : "")" @onclick="() => Pagina = clave">
                        <i class="ti @icono me-1"></i>@titulo
                    </button>
                </li>
            }
        </ul>

        @if (Pagina == "iva")
        {
            @ProyeccionIva()
        }
        else
        {
        @* ---------- Indicadores ---------- *@
        <div class="row row-cards mb-3 kpis-principales">
            <div class="col-sm-6 col-xl-3">
                @Kpi("Facturación neta", Moneda(Datos.FacturacionNeta), "Facturas menos notas de crédito", "ti-trending-up", "azul")
            </div>
            <div class="col-sm-6 col-xl-3">
                @Kpi("Compras netas", Moneda(Datos.ComprasNetas), "Facturas recibidas menos notas de crédito", "ti-shopping-cart", "teal")
            </div>
            <div class="col-sm-6 col-xl-3">
                @Kpi("Ventas − compras", Moneda(Diferencia), "Facturación neta menos compras netas",
                     Diferencia >= 0 ? "ti-arrow-up-right" : "ti-arrow-down-right", Diferencia >= 0 ? "verde" : "rojo")
            </div>
            <div class="col-sm-6 col-xl-3">
                @Kpi("CFDI del periodo", (Datos.CfdiEmitidos + Datos.CfdiRecibidos).ToString("N0"),
                     $"{Datos.CfdiEmitidos:N0} emitidos · {Datos.CfdiRecibidos:N0} recibidos", "ti-files", "morado")
            </div>
        </div>

        @* ---------- Emitidos y recibidos por tipo ---------- *@
        <div class="row row-cards">
            @foreach (Grupo grupo in Grupos)
            {
                <div class="col-xl-6">
                    <div class="card h-100 grupo" style="--color-tipo: var(--tblr-@(grupo.Clave == "EMITIDOS" ? "blue" : "teal"))">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">
                                    <span class="badge @grupo.Insignia me-2">@grupo.Clave</span>@grupo.Titulo
                                </h3>
                                <div class="card-subtitle">@grupo.Descripcion</div>
                            </div>
                            <div class="card-actions text-end">
                                <div class="subheader">@grupo.EtiquetaNeto</div>
                                <div class="h3 mb-0">@Moneda(grupo.Neto)</div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary">Composición por número de CFDI</span>
                                <strong>@grupo.Total.ToString("N0") CFDI</strong>
                            </div>

                            @if (grupo.Total > 0)
                            {
                                <div class="progress progress-separated progress-lg mb-3">
                                    @foreach (Renglon r in grupo.Renglones.Where(r => r.Cantidad > 0))
                                    {
                                        <div class="progress-bar @r.Fondo" role="progressbar"
                                             style="width: @Porcentaje(r.Cantidad, grupo.Total).ToString("0.##", CultureInfo.InvariantCulture)%"
                                             title="@r.Nombre: @r.Cantidad.ToString("N0") (@Porcentaje(r.Cantidad, grupo.Total).ToString("0.#")%)"></div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="progress progress-lg mb-3"></div>
                            }

                            <div class="d-flex flex-wrap gap-3 small text-secondary">
                                @foreach (Renglon r in grupo.Renglones)
                                {
                                    <span><span class="legend @r.Fondo me-1"></span>@r.Nombre</span>
                                }
                            </div>
                        </div>

                        <div class="card-body pt-0">
                            <div class="row g-2">
                                @foreach (Renglon r in grupo.Renglones)
                                {
                                    <div class="col-6 col-md-4 @(r.Nombre == "Facturas" ? "col-md-8" : "")">
                                        @Kpi(r.Nombre, r.Importe is decimal importe ? Moneda(importe) : "—",
                                             $"{r.Cantidad:N0} CFDI · {Porcentaje(r.Cantidad, grupo.Total):0.#}%", r.Icono, r.Tono, r.Cantidad == 0)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        }
    }
</div>

@code {
    private static readonly CultureInfo Mx = CultureInfo.GetCultureInfo("es-MX");

    private DashboardDto Datos { get; set; } = new();

    [Inject] private PeriodoTrabajoService Periodo { get; set; } = default!;

    private DateTime FechaInicio { get; set; }

    private DateTime FechaFin { get; set; }

    private bool Cargando { get; set; } = true;

    private string? Error { get; set; }

    private string RfcEmpresa =>
        string.IsNullOrWhiteSpace(EmpresaContext.Rfc) ? "Empresa no seleccionada" : EmpresaContext.Rfc;

    private decimal Diferencia => Datos.FacturacionNeta - Datos.ComprasNetas;

    // Lo que retuvieron los clientes no se cobró: lo enteran ellos.
    private decimal IvaCobrado => Datos.IvaTrasladadoEmitidos.Total - Datos.IvaRetenidoEmitidos.Total;

    // IVA cobrado − IVA acreditable. Negativo = saldo a favor.
    private decimal IvaPorPagar => IvaCobrado - Datos.IvaTrasladadoRecibidos.Total;

    // Un renglón por tipo, siempre en el orden Facturas, Nómina, Notas de crédito, Traslados, Pagos.
    // Los traslados no llevan importe.
    private sealed record Renglon(string Icono, string Nombre, string Fondo, string Tono, long Cantidad, decimal? Importe);

    private sealed record Grupo(string Clave, string Insignia, string Titulo, string Descripcion,
                                string EtiquetaNeto, decimal Neto, long Total, List<Renglon> Renglones);

    private IEnumerable<Grupo> Grupos =>
    [
        new("EMITIDOS", "bg-blue-lt", "Facturación y ventas", "CFDI donde el RFC es emisor",
            "Facturación neta", Datos.FacturacionNeta, Datos.CfdiEmitidos,
            Renglones(Datos.IngresosEmitidos, Datos.TotalIngresosEmitidos,
                      Datos.NominasEmitidas, Datos.TotalNominasEmitidas,
                      Datos.EgresosEmitidos, Datos.TotalEgresosEmitidos,
                      Datos.TrasladosEmitidos,
                      Datos.PagosEmitidos, Datos.TotalPagosEmitidos)),
        new("RECIBIDOS", "bg-teal-lt", "Compras y gastos", "CFDI donde el RFC es receptor",
            "Compras netas", Datos.ComprasNetas, Datos.CfdiRecibidos,
            Renglones(Datos.IngresosRecibidos, Datos.TotalIngresosRecibidos,
                      Datos.NominasRecibidas, Datos.TotalNominasRecibidas,
                      Datos.EgresosRecibidos, Datos.TotalEgresosRecibidos,
                      Datos.TrasladosRecibidos,
                      Datos.PagosRecibidos, Datos.TotalPagosRecibidos))
    ];

    private static List<Renglon> Renglones(long facturas, decimal importeFacturas,
                                           long nominas, decimal importeNominas,
                                           long notas, decimal importeNotas,
                                           long traslados,
                                           long pagos, decimal importePagos) =>
    [
        new("ti-file-invoice", "Facturas", "bg-blue", "azul", facturas, importeFacturas),
        new("ti-users", "Nómina", "bg-green", "verde", nominas, importeNominas),
        new("ti-receipt-refund", "Notas de crédito", "bg-red", "rojo", notas, importeNotas),
        new("ti-truck", "Traslados", "bg-yellow", "ambar", traslados, null),
        new("ti-cash", "Pagos", "bg-purple", "morado", pagos, importePagos)
    ];

    // ---------- Páginas ----------

    private static readonly (string Clave, string Titulo, string Icono)[] Paginas =
    [
        ("resumen", "Resumen", "ti-layout-dashboard"),
        ("iva", "Proyección de IVA", "ti-receipt-tax")
    ];

    private string Pagina = "resumen";

    /// <summary>KPI con fondo degradado del tono (azul, teal, verde, rojo, ambar, morado, naranja, gris).</summary>
    private static RenderFragment Kpi(string titulo, string valor, string detalle, string icono, string tono, bool apagado = false, string? ayuda = null) => __builder =>
    {
        <div class="kpi-degradado tono-@tono @(apagado ? "apagado" : "")" title="@ayuda">
            <div class="kpi-icono"><i class="ti @icono"></i></div>
            <div class="kpi-titulo">@titulo</div>
            <div class="kpi-valor">@valor</div>
            <div class="kpi-detalle">@detalle</div>
        </div>
    };

    // Desglose de un impuesto: facturas PUE y notas de crédito por un lado, complementos de pago por otro.
    private static string Desglose(ImpuestoDashboardDto i) => $"PUE y NC {Moneda(i.Facturas)} · Pagos {Moneda(i.Pagos)}";

    // Impuestos que retuve a mis proveedores: los entero yo.
    private decimal RetencionesPorEnterar => Datos.IvaRetenidoRecibidos.Total + Datos.IsrRetenidoRecibidos.Total;

    private decimal TotalAPagar => Math.Max(IvaPorPagar, 0) + RetencionesPorEnterar;

    private RenderFragment ProyeccionIva() => __builder =>
    {
        <div class="row row-cards mb-3">
            <div class="col-xl-6">
                <div class="card h-100 grupo" style="--color-tipo: var(--tblr-blue)">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title"><span class="badge bg-blue-lt me-2">EMITIDOS</span>Impuestos de lo que facturé</h3>
                            <div class="card-subtitle">IVA trasladado a mis clientes y lo que ellos me retuvieron</div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">@Kpi("IVA trasladado", Moneda(Datos.IvaTrasladadoEmitidos.Total), Desglose(Datos.IvaTrasladadoEmitidos), "ti-receipt-tax", "azul")</div>
                            <div class="col-md-4">@Kpi("IVA que me retuvieron", Moneda(Datos.IvaRetenidoEmitidos.Total), Desglose(Datos.IvaRetenidoEmitidos), "ti-receipt-2", "naranja")</div>
                            <div class="col-md-4">@Kpi("ISR que me retuvieron", Moneda(Datos.IsrRetenidoEmitidos.Total), Desglose(Datos.IsrRetenidoEmitidos), "ti-building-bank", "morado")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card h-100 grupo" style="--color-tipo: var(--tblr-teal)">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title"><span class="badge bg-teal-lt me-2">RECIBIDOS</span>Impuestos de lo que me facturaron</h3>
                            <div class="card-subtitle">IVA acreditable y lo que retuve a mis proveedores</div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">@Kpi("IVA acreditable", Moneda(Datos.IvaTrasladadoRecibidos.Total), Desglose(Datos.IvaTrasladadoRecibidos), "ti-receipt-tax", "teal")</div>
                            <div class="col-md-4">@Kpi("IVA que retuve", Moneda(Datos.IvaRetenidoRecibidos.Total), Desglose(Datos.IvaRetenidoRecibidos), "ti-receipt-2", "naranja")</div>
                            <div class="col-md-4">@Kpi("ISR que retuve", Moneda(Datos.IsrRetenidoRecibidos.Total), Desglose(Datos.IsrRetenidoRecibidos), "ti-building-bank", "morado")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card grupo" style="--color-tipo: var(--tblr-@(IvaPorPagar >= 0 ? "red" : "green"))">
            <div class="card-header">
                <div>
                    <h3 class="card-title"><span class="badge bg-@(IvaPorPagar >= 0 ? "red" : "green")-lt me-2">PROYECCIÓN</span>IVA del periodo</h3>
                    <div class="card-subtitle">@FechaInicio.ToString("dd/MM/yyyy") al @FechaFin.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap flex-xl-nowrap align-items-stretch gap-2 proyeccion">
                    <div class="paso">@Kpi("IVA cobrado", Moneda(IvaCobrado), $"Trasladado {Moneda(Datos.IvaTrasladadoEmitidos.Total)} − retenido {Moneda(Datos.IvaRetenidoEmitidos.Total)}", "ti-cash-register", "azul")</div>
                    <span class="operador">−</span>
                    <div class="paso">@Kpi("IVA acreditable", Moneda(Datos.IvaTrasladadoRecibidos.Total), Desglose(Datos.IvaTrasladadoRecibidos), "ti-receipt-tax", "teal")</div>
                    <span class="operador">=</span>
                    <div class="paso">@Kpi(IvaPorPagar >= 0 ? "IVA por pagar" : "Saldo a favor de IVA", Moneda(Math.Abs(IvaPorPagar)),
                                          IvaCobrado == 0 ? "Sin IVA cobrado" : $"{Math.Abs(IvaPorPagar) / IvaCobrado:P1} del IVA cobrado", IvaPorPagar >= 0 ? "ti-arrow-up-right" : "ti-arrow-down-left", IvaPorPagar >= 0 ? "rojo" : "verde")</div>
                    <span class="operador">+</span>
                    <div class="paso">@Kpi("Retenciones por enterar", Moneda(RetencionesPorEnterar), $"IVA {Moneda(Datos.IvaRetenidoRecibidos.Total)} · ISR {Moneda(Datos.IsrRetenidoRecibidos.Total)}", "ti-building-bank", "ambar")</div>
                    <span class="operador">=</span>
                    <div class="paso">@Kpi("Total estimado a pagar", Moneda(TotalAPagar), IvaPorPagar >= 0 ? "IVA por pagar más retenciones" : "Solo retenciones: el IVA queda a favor", "ti-calculator", "gris")</div>
                </div>
            </div>
        </div>
    };

    protected override void OnInitialized()
    {
        FechaInicio = Periodo.Inicio;
        FechaFin = Periodo.Fin;
        EmpresaContext.OnChange += CambiarEmpresa;
        CargarDashboard();
    }

    private void CargarDashboard()
    {
        Cargando = true;
        Error = null;

        try
        {
            if (!EmpresaContext.TieneEmpresaActiva)
                throw new InvalidOperationException("Selecciona una empresa o RFC.");

            if (FechaFin.Date < FechaInicio.Date)
                throw new InvalidOperationException("La fecha final no puede ser menor que la fecha inicial.");

            Datos = Repo.ObtenerDashboard(EmpresaContext.EmpresaId, FechaInicio, FechaFin);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private void CambiarEmpresa()
    {
        _ = InvokeAsync(() =>
        {
            CargarDashboard();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EmpresaContext.OnChange -= CambiarEmpresa;
    }

    private static double Porcentaje(long parte, long total) => total <= 0 ? 0 : parte * 100d / total;

    private static string Moneda(decimal valor) => valor.ToString("C2", Mx);
}

@page "/"
@page "/resumen"
@implements IDisposable

@using System.Globalization
@using CFDIParser.Models
@using CFDIParser.Services
@using CFDIManager.Web.Services

@inject PostgreSqlRepository Repo
@inject EmpresaContext EmpresaContext

<PageTitle>CFDI Manager</PageTitle>

@* Tabler solo en esta pantalla: en toda la app cambia el aspecto de las que ya estaban terminadas. *@
<HeadContent>
    <link rel="stylesheet" href="lib/tabler/css/tabler.min.css" />
</HeadContent>

<div class="resumen">
    @* ---------- Encabezado y periodo ---------- *@
    <div class="page-header mb-3">
        <div class="row g-3 align-items-end">
            <div class="col">
                <div class="page-pretitle">CFDI Manager · @RfcEmpresa</div>
                <h2 class="page-title">Resumen fiscal</h2>
                <div class="text-secondary mt-1">CFDI emitidos y recibidos del periodo.</div>
            </div>

            <div class="col-auto">
                <div class="d-flex flex-wrap align-items-end gap-2">
                    <div>
                        <label class="form-label mb-1">Fecha inicial</label>
                        <FechaInput @bind-Valor="FechaInicio" />
                    </div>
                    <div>
                        <label class="form-label mb-1">Fecha final</label>
                        <FechaInput @bind-Valor="FechaFin" />
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="CargarDashboard" disabled="@Cargando">
                        <i class="ti ti-refresh me-1"></i>@(Cargando ? "Actualizando…" : "Consultar")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">
            <div class="d-flex gap-2">
                <i class="ti ti-alert-octagon fs-2"></i>
                <div>
                    <h4 class="alert-title">No se pudo cargar el resumen</h4>
                    <div class="text-secondary">@Error</div>
                </div>
            </div>
        </div>
    }
    else if (Cargando)
    {
        <div class="card">
            <div class="card-body">
                <div class="text-secondary mb-2">Consultando información en PostgreSQL…</div>
                <div class="progress progress-sm"><div class="progress-bar progress-bar-indeterminate"></div></div>
            </div>
        </div>
    }
    else
    {
        @* ---------- Indicadores ---------- *@
        <div class="row row-cards mb-3">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-sm h-100 kpi" style="--color-tipo: var(--tblr-blue)">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <span class="avatar bg-blue text-white"><i class="ti ti-trending-up"></i></span>
                            <div>
                                <div class="subheader">Facturación neta</div>
                                <div class="h2 mb-0">@Moneda(Datos.FacturacionNeta)</div>
                                <div class="text-secondary small">Facturas menos notas de crédito</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card card-sm h-100 kpi" style="--color-tipo: var(--tblr-teal)">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <span class="avatar bg-teal text-white"><i class="ti ti-shopping-cart"></i></span>
                            <div>
                                <div class="subheader">Compras netas</div>
                                <div class="h2 mb-0">@Moneda(Datos.ComprasNetas)</div>
                                <div class="text-secondary small">Facturas recibidas menos notas de crédito</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card card-sm h-100 kpi" style="--color-tipo: var(--tblr-@(Diferencia >= 0 ? "green" : "red"))">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <span class="avatar @(Diferencia >= 0 ? "bg-green" : "bg-red") text-white">
                                <i class="ti @(Diferencia >= 0 ? "ti-arrow-up-right" : "ti-arrow-down-right")"></i>
                            </span>
                            <div>
                                <div class="subheader">Ventas − compras</div>
                                <div class="h2 mb-0 @(Diferencia >= 0 ? "text-green" : "text-red")">@Moneda(Diferencia)</div>
                                <div class="text-secondary small">Facturación neta menos compras netas</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card card-sm h-100 kpi" style="--color-tipo: var(--tblr-azure)">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <span class="avatar bg-azure text-white"><i class="ti ti-files"></i></span>
                            <div>
                                <div class="subheader">CFDI del periodo</div>
                                <div class="h2 mb-0">@((Datos.CfdiEmitidos + Datos.CfdiRecibidos).ToString("N0"))</div>
                                <div class="text-secondary small">
                                    @Datos.CfdiEmitidos.ToString("N0") emitidos · @Datos.CfdiRecibidos.ToString("N0") recibidos
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------- Emitidos y recibidos por tipo ---------- *@
        <div class="row row-cards">
            @foreach (Grupo grupo in Grupos)
            {
                <div class="col-xl-6">
                    <div class="card h-100 grupo" style="--color-tipo: var(--tblr-@(grupo.Clave == "EMITIDOS" ? "blue" : "teal"))">
                        <div class="card-header">
                            <div>
                                <h3 class="card-title">
                                    <span class="badge @grupo.Insignia me-2">@grupo.Clave</span>@grupo.Titulo
                                </h3>
                                <div class="card-subtitle">@grupo.Descripcion</div>
                            </div>
                            <div class="card-actions text-end">
                                <div class="subheader">@grupo.EtiquetaNeto</div>
                                <div class="h3 mb-0">@Moneda(grupo.Neto)</div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary">Composición por número de CFDI</span>
                                <strong>@grupo.Total.ToString("N0") CFDI</strong>
                            </div>

                            @if (grupo.Total > 0)
                            {
                                <div class="progress progress-separated progress-lg mb-3">
                                    @foreach (Renglon r in grupo.Renglones.Where(r => r.Cantidad > 0))
                                    {
                                        <div class="progress-bar @r.Fondo" role="progressbar"
                                             style="width: @Porcentaje(r.Cantidad, grupo.Total).ToString("0.##", CultureInfo.InvariantCulture)%"
                                             title="@r.Nombre: @r.Cantidad.ToString("N0") (@Porcentaje(r.Cantidad, grupo.Total).ToString("0.#")%)"></div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="progress progress-lg mb-3"></div>
                            }

                            <div class="d-flex flex-wrap gap-3 small text-secondary">
                                @foreach (Renglon r in grupo.Renglones)
                                {
                                    <span><span class="legend @r.Fondo me-1"></span>@r.Nombre</span>
                                }
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th class="text-end">CFDI</th>
                                        <th class="text-end">%</th>
                                        <th class="text-end">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (Renglon r in grupo.Renglones)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="avatar avatar-sm @r.Claro"><i class="ti @r.Icono"></i></span>
                                                    <span>@r.Nombre</span>
                                                </div>
                                            </td>
                                            <td class="text-end">@r.Cantidad.ToString("N0")</td>
                                            <td class="text-end text-secondary">@Porcentaje(r.Cantidad, grupo.Total).ToString("0.#")%</td>
                                            <td class="text-end fw-bold">@(r.Importe is decimal importe ? Moneda(importe) : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Mx = CultureInfo.GetCultureInfo("es-MX");

    private DashboardDto Datos { get; set; } = new();

    [Inject] private PeriodoTrabajoService Periodo { get; set; } = default!;

    private DateTime FechaInicio { get; set; }

    private DateTime FechaFin { get; set; }

    private bool Cargando { get; set; } = true;

    private string? Error { get; set; }

    private string RfcEmpresa =>
        string.IsNullOrWhiteSpace(EmpresaContext.Rfc) ? "Empresa no seleccionada" : EmpresaContext.Rfc;

    private decimal Diferencia => Datos.FacturacionNeta - Datos.ComprasNetas;

    // Un renglón por tipo, siempre en el orden Facturas, Nómina, Notas de crédito, Traslados, Pagos.
    // Los traslados no llevan importe.
    private sealed record Renglon(string Icono, string Nombre, string Fondo, string Claro, long Cantidad, decimal? Importe);

    private sealed record Grupo(string Clave, string Insignia, string Titulo, string Descripcion,
                                string EtiquetaNeto, decimal Neto, long Total, List<Renglon> Renglones);

    private IEnumerable<Grupo> Grupos =>
    [
        new("EMITIDOS", "bg-blue-lt", "Facturación y ventas", "CFDI donde el RFC es emisor",
            "Facturación neta", Datos.FacturacionNeta, Datos.CfdiEmitidos,
            Renglones(Datos.IngresosEmitidos, Datos.TotalIngresosEmitidos,
                      Datos.NominasEmitidas, Datos.TotalNominasEmitidas,
                      Datos.EgresosEmitidos, Datos.TotalEgresosEmitidos,
                      Datos.TrasladosEmitidos,
                      Datos.PagosEmitidos, Datos.TotalPagosEmitidos)),
        new("RECIBIDOS", "bg-teal-lt", "Compras y gastos", "CFDI donde el RFC es receptor",
            "Compras netas", Datos.ComprasNetas, Datos.CfdiRecibidos,
            Renglones(Datos.IngresosRecibidos, Datos.TotalIngresosRecibidos,
                      Datos.NominasRecibidas, Datos.TotalNominasRecibidas,
                      Datos.EgresosRecibidos, Datos.TotalEgresosRecibidos,
                      Datos.TrasladosRecibidos,
                      Datos.PagosRecibidos, Datos.TotalPagosRecibidos))
    ];

    private static List<Renglon> Renglones(long facturas, decimal importeFacturas,
                                           long nominas, decimal importeNominas,
                                           long notas, decimal importeNotas,
                                           long traslados,
                                           long pagos, decimal importePagos) =>
    [
        new("ti-file-invoice", "Facturas", "bg-blue", "bg-blue-lt", facturas, importeFacturas),
        new("ti-users", "Nómina", "bg-green", "bg-green-lt", nominas, importeNominas),
        new("ti-receipt-refund", "Notas de crédito", "bg-red", "bg-red-lt", notas, importeNotas),
        new("ti-truck", "Traslados", "bg-yellow", "bg-yellow-lt", traslados, null),
        new("ti-cash", "Pagos", "bg-purple", "bg-purple-lt", pagos, importePagos)
    ];

    protected override void OnInitialized()
    {
        FechaInicio = Periodo.Inicio;
        FechaFin = Periodo.Fin;
        EmpresaContext.OnChange += CambiarEmpresa;
        CargarDashboard();
    }

    private void CargarDashboard()
    {
        Cargando = true;
        Error = null;

        try
        {
            if (!EmpresaContext.TieneEmpresaActiva)
                throw new InvalidOperationException("Selecciona una empresa o RFC.");

            if (FechaFin.Date < FechaInicio.Date)
                throw new InvalidOperationException("La fecha final no puede ser menor que la fecha inicial.");

            Datos = Repo.ObtenerDashboard(EmpresaContext.EmpresaId, FechaInicio, FechaFin);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private void CambiarEmpresa()
    {
        _ = InvokeAsync(() =>
        {
            CargarDashboard();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EmpresaContext.OnChange -= CambiarEmpresa;
    }

    private static double Porcentaje(long parte, long total) => total <= 0 ? 0 : parte * 100d / total;

    private static string Moneda(decimal valor) => valor.ToString("C2", Mx);
}

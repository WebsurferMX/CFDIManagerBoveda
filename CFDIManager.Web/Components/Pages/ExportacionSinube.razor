    private int Procesados;
    private int Total;
    private string? Error;
    private List<SinubeEnvioDto> Resultados = [];
    private CancellationTokenSource? Cancelacion;

    private string? NuevaPassword;
    private bool Probando;
    private string? MensajeHerramientas;
    private bool MensajeOk;
    private bool TieneCiec;

    private bool ZipEmitidos = true;
    private List<DateTime> PeriodosZip = [];
    private string ZipPeriodo = "";
    private bool GenerandoZip;

    private List<SinubeEnvioDto> Historial = [];

    private List<SinubeFoliadorDto> Foliadores = [];
    private string LlaveFoliador = "";
    private bool SustituirFolio;
    private bool CargandoFoliadores;

    private bool Clientes => Tab is "C" or "S";

    private bool SinFolio => Tab == "S";

    private string? FaltaConfiguracion =>
        Config is null ? null : SinubeService.FaltanDatos(Config, requierePassword: Clientes);

    private bool PuedeEnviar =>
        !Enviando && FaltaConfiguracion is null && PeriodoTexto != ""
        && (Clientes || IncluirIngreso || IncluirEgreso || IncluirPago)
        && (!SinFolio || LlaveFoliador != "");

    private string CarpetaActual =>
        EmpresaContext.EmpresaActiva is EmpresaDto empresa && TryPeriodo(PeriodoTexto, out DateTime periodo)
            ? Sinube.CarpetaPeriodo(empresa, Clientes, periodo)
            : "";

    private IEnumerable<SinubeEnvioDto> ResultadosVisibles =>
        SoloProblemas ? Resultados.Where(r => r.Estatus is "ERROR" or "INVALIDO" or "IEPS" or "FOLIO") : Resultados;

    private string EjemploNombre =>
        Config is null
            ? ""
            : SinubeService.NombreXml(
                System.Xml.Linq.XDocument.Parse(
                    """<cfdi:Comprobante xmlns:cfdi="http://www.sat.gob.mx/cfd/4" xmlns:tfd="http://www.sat.gob.mx/TimbreFiscalDigital" Version="4.0" Serie="A" Folio="123" Fecha="2026-10-15T10:30:00" TipoDeComprobante="I"><cfdi:Emisor Rfc="EMP010101AAA" Nombre="EMPRESA SA DE CV"/><cfdi:Receptor Rfc="CLI010101BBB" Nombre="CLIENTE SA DE CV"/><cfdi:Complemento><tfd:TimbreFiscalDigital UUID="0A1B2C3D-0000-4000-8000-000000000001"/></cfdi:Complemento></cfdi:Comprobante>"""),
                Config,
                emitido: true) + ".xml";

    protected override void OnInitialized()
    {
        EmpresaContext.OnChange += EmpresaCambio;
        Cargar();
    }

    private void Cargar()
    {
        Revision = null;
        Resultados = [];
        Error = null;
        Total = Procesados = 0;
        MensajeHerramientas = null;
        NuevaPassword = null;

        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa)
        {
            Config = null;
            return;
        }

        Config = Sinube.ObtenerConfiguracion(empresa);
        Foliadores = [];
        LlaveFoliador = Config.FoliadorLlave;
        TieneCiec = !string.IsNullOrEmpty(Repo.ObtenerEmpresaSat(empresa.EmpresaId)?.SatPassword);
        CargarPeriodos();
        CambiarOrigenZip(ZipEmitidos);
        CargarHistorial();
    }

    private void CargarPeriodos()
    {
        Periodos = EmpresaContext.EmpresaActiva is EmpresaDto empresa ? Sinube.Periodos(empresa, Clientes) : [];
        // Abre en el periodo de trabajo (como las demás pantallas) si tiene carpeta; si no, en el más reciente.
        DateTime trabajo = Periodo.Inicio;
        PeriodoTexto = Periodos.Count == 0 ? ""
            : (Periodos.Any(p => p.Year == trabajo.Year && p.Month == trabajo.Month) ? trabajo : Periodos[0]).ToString("yyyy-MM");
    }

    /// <summary>Lo que ya tiene SINUBE del periodo y lo ya enviado desde la app; el resto queda por subir.</summary>
    private sealed class RevisionSinube
    {
        public int Archivos { get; init; }
        public HashSet<string> YaEnSinube { get; init; } = new(StringComparer.OrdinalIgnoreCase);
        public int EnSinube { get; init; }
        public int EnviadosAntes { get; init; }

        /// <summary>Recibos de nómina del periodo (clientes): SINUBE no los importa.</summary>
        public int Nomina { get; init; }

        /// <summary>Pagos de clientes cuyo serie-folio ya ocupa otro pago en SINUBE: se suben con la serie alterna.</summary>
        public int PagosSerieAlterna { get; init; }

        /// <summary>Pagos con folio ocupado que no se pueden subir (sin serie alterna, o también ocupada).</summary>
        public int PagosFolioOcupado { get; init; }

        /// <summary>Proveedores: pendientes de un tipo de comprobante no marcado (Ingreso, Egreso, Pago).</summary>
        public int TipoNoSeleccionado { get; init; }

        /// <summary>Pagos de clientes en SINUBE (DbDeposito) por "SERIE|FOLIO" → UUID, para el envío.</summary>
        public Dictionary<string, string>? PagosEnSinube { get; init; }

        public List<string> PorSubir { get; init; } = [];
    }

    private RevisionSinube? Revision;
    private bool Revisando;

    // Revisión que se hace sola al terminar un envío (abajo, "Así quedó en SINUBE").
    private bool RevisandoFinal;

    private void LimpiarRevision() => Revision = null;

    private RenderFragment TarjetasRevision(RevisionSinube r, string ancho) =>
        @<text>
            <TarjetaTotal Ancho="@ancho" Titulo="XML del periodo" Valor="@r.Archivos.ToString("N0")" Icono="bi-files" />
            <TarjetaTotal Ancho="@ancho" Titulo="Ya en SINUBE" Valor="@r.EnSinube.ToString("N0")" Icono="bi-cloud-check" Color="info" />
            <TarjetaTotal Ancho="@ancho" Titulo="Enviados antes" Valor="@r.EnviadosAntes.ToString("N0")" Icono="bi-clock-history" />
            @if (r.Nomina > 0)
            {
                <TarjetaTotal Ancho="@ancho" Titulo="Nómina (no se sube)" Valor="@r.Nomina.ToString("N0")" Icono="bi-people" Color="primary" />
            }
            @if (r.PagosSerieAlterna > 0)
            {
                <TarjetaTotal Ancho="@ancho" Titulo="@($"Folio ocupado → {string.Join(" / ", Config?.SeriesAlternasPagos ?? [])}")" Valor="@r.PagosSerieAlterna.ToString("N0")" Icono="bi-arrow-left-right" Color="info" />
            }
            @if (r.TipoNoSeleccionado > 0)
            {
                <TarjetaTotal Ancho="@ancho" Titulo="Tipo no marcado" Valor="@r.TipoNoSeleccionado.ToString("N0")" Icono="bi-funnel" />
            }
            @if (r.PagosFolioOcupado > 0)
            {
                <TarjetaTotal Ancho="@ancho" Titulo="Folio ocupado (no se sube)" Valor="@r.PagosFolioOcupado.ToString("N0")" Icono="bi-exclamation-octagon" Color="danger" />
            }
            <TarjetaTotal Ancho="@ancho" Titulo="Por subir" Valor="@r.PorSubir.Count.ToString("N0")" Icono="bi-cloud-arrow-up" Color="@(r.PorSubir.Count > 0 ? "warning" : "success")" />
        </text>;

    private async Task RevisarSinube()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa || Config is null || !TryPeriodo(PeriodoTexto, out DateTime periodo))
            return;

        Error = null;
        Resultados = [];
        Total = Procesados = 0;
        Revision = null;
        Revisando = true;

        try
        {
            Revision = await ConsultarRevisionAsync(empresa, Config, Clientes, periodo);
        }
        catch (Exception ex)
        {
            Error = $"No se pudo consultar SINUBE: {ex.Message}";
        }
        finally
        {
            Revisando = false;
        }
    }

    private async Task<RevisionSinube> ConsultarRevisionAsync(EmpresaDto empresa, SinubeConfiguracionDto config, bool clientes, DateTime periodo)
    {
        List<string> archivos = Sinube.Archivos(empresa, clientes, periodo);
        HashSet<string> enSinube = await DatosSinube.UuidsEnSinubeAsync(config, clientes, [periodo]);
        HashSet<string> enviados = Reenviar ? [] : Sinube.UuidsEnviados(empresa, clientes);
        Dictionary<string, DatosXml> datos = await Task.Run(() => archivos.ToDictionary(a => a, DatosDeArchivo));

        // SINUBE no importa nómina: en clientes se cuenta aparte y no queda por subir.
        bool EsNomina(string a) => clientes && datos[a].Tipo == "N";
        List<string> facturas = archivos.Where(a => !EsNomina(a)).ToList();

        // Los pagos de clientes viven en DbDeposito y SINUBE valida su serie-folio, no el UUID.
        List<string> pagos = clientes ? facturas.Where(a => datos[a].Tipo == "P").ToList() : [];
        Dictionary<string, string>? pagosEnSinube = pagos.Count > 0
            ? await PagosEnSinubeAsync(config, pagos.Select(a => datos[a].Serie))
            : null;

        if (pagosEnSinube is not null)
        {
            // Los pagos ya importados quedan en DbDeposito sin serie ni folio: se reconocen por UUID, en los depósitos
            // del mes anterior al siguiente (el mes del depósito es el de la fecha de pago).
            enSinube.UnionWith(pagosEnSinube.Values);
            enSinube.UnionWith(await DatosSinube.UuidsDepositosAsync(config, [periodo.AddMonths(-1), periodo, periodo.AddMonths(1)]));
        }

        bool EnSinube(string a) => enSinube.Contains(datos[a].Uuid);
        bool Ocupado(string a) => pagosEnSinube?.ContainsKey(PagoSinube.SerieFolio(datos[a].Serie, datos[a].Folio)) == true && !EnSinube(a);

        List<string> alternas = config.SeriesAlternasPagos;
        bool SeSubeConAlterna(string a) => alternas.Any(s => !pagosEnSinube!.ContainsKey(PagoSinube.SerieFolio(s, datos[a].Folio)));

        List<string> pendientes = facturas.Where(a => !EnSinube(a) && !enviados.Contains(datos[a].Uuid)).ToList();

        // Proveedores: solo los tipos marcados se envían; los demás se cuentan aparte.
        HashSet<string>? tipos = clientes ? null : TiposSeleccionados();
        List<string> noMarcados = tipos is null ? [] : pendientes.Where(a => !tipos.Contains(datos[a].Tipo)).ToList();
        pendientes = pendientes.Except(noMarcados).ToList();

        List<string> ocupados = pendientes.Where(a => datos[a].Tipo == "P" && Ocupado(a)).ToList();
        List<string> bloqueados = ocupados.Where(a => !SeSubeConAlterna(a)).ToList();

        return new RevisionSinube
        {
            Archivos = archivos.Count,
            YaEnSinube = enSinube,
            Nomina = archivos.Count - facturas.Count,
            EnSinube = facturas.Count(EnSinube),
            EnviadosAntes = facturas.Count(a => !EnSinube(a) && enviados.Contains(datos[a].Uuid)),
            PagosSerieAlterna = ocupados.Count - bloqueados.Count,
            PagosFolioOcupado = bloqueados.Count,
            TipoNoSeleccionado = noMarcados.Count,
            PagosEnSinube = pagosEnSinube,
            PorSubir = pendientes.Except(bloqueados).ToList()
        };
    }

    /// <summary>Pagos de clientes que SINUBE ya tiene con esas series o con las series alternas: "SERIE|FOLIO" → UUID.</summary>
    private async Task<Dictionary<string, string>> PagosEnSinubeAsync(SinubeConfiguracionDto config, IEnumerable<string> series)
    {
        List<PagoSinube> pagos = await DatosSinube.PagosClientesAsync(config, series.Concat(config.SeriesAlternasPagos));
        var porLlave = new Dictionary<string, string>();

        foreach (PagoSinube p in pagos)
            porLlave.TryAdd(p.Llave, p.Uuid);

        return porLlave;
    }

    private sealed record DatosXml(string Uuid, string Tipo, string Serie, string Folio);

    /// <summary>
    /// UUID, TipoDeComprobante, Serie y Folio del XML, leídos en streaming (los atributos están en la raíz y el timbre
    /// al final). Los XML de la bóveda se llaman {UUID}.xml: entonces basta con la raíz.
    /// </summary>
    private static DatosXml DatosDeArchivo(string archivo)
    {
        string nombre = Path.GetFileNameWithoutExtension(archivo);
        bool nombreEsUuid = Guid.TryParse(nombre, out _);
        string tipo = "", serie = "", folio = "";

        try
        {
            using var lector = System.Xml.XmlReader.Create(archivo);

            while (lector.Read())
            {
                if (lector.NodeType != System.Xml.XmlNodeType.Element)
                    continue;

                if (lector.LocalName == "Comprobante")
                {
                    tipo = (lector.GetAttribute("TipoDeComprobante") ?? "").ToUpperInvariant();
                    serie = lector.GetAttribute("Serie") ?? "";
                    folio = lector.GetAttribute("Folio") ?? "";

                    if (nombreEsUuid)
                        break;
                }
                else if (lector.LocalName == "TimbreFiscalDigital")
                {
                    return new DatosXml((lector.GetAttribute("UUID") ?? nombre).ToUpperInvariant(), tipo, serie, folio);
                }
            }
        }
        catch (Exception)
        {
            // Un XML ilegible se queda con el nombre; el envío lo marcará como inválido.
        }

        return new DatosXml(nombre.ToUpperInvariant(), tipo, serie, folio);
    }

    private void CambiarTab(string tab)
    {
        if (Enviando || Tab == tab)
            return;

        Tab = tab;
        Revision = null;
        Resultados = [];
        Error = null;
        Total = Procesados = 0;

        if (tab is "C" or "P" or "S")
            CargarPeriodos();
        else
            CargarHistorial();
    }

    /// <summary>Tipos de comprobante marcados en proveedores (Ingreso, Egreso, Pago).</summary>
    private HashSet<string> TiposSeleccionados()
    {
        HashSet<string> tipos = [];
        if (IncluirIngreso) tipos.Add("I");
        if (IncluirEgreso) tipos.Add("E");
        if (IncluirPago) tipos.Add("P");
        return tipos;
    }

    private static bool TryPeriodo(string texto, out DateTime periodo) =>
        DateTime.TryParseExact(texto + "-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out periodo);

    private async Task EnviarAsync()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa || Config is null || !TryPeriodo(PeriodoTexto, out DateTime periodo))
            return;

        Error = null;
        Resultados = [];
        Procesados = 0;

        // Revisado en SINUBE: solo los pendientes; sin revisar, toda la carpeta del periodo.
        List<string> archivos = Revision?.PorSubir ?? Sinube.Archivos(empresa, Clientes, periodo);
        IReadOnlySet<string>? yaEnSinube = Revision?.YaEnSinube;
        Total = archivos.Count;

        if (Total == 0)
        {
            Error = "No hay XML en " + CarpetaActual;
            return;
        }

        HashSet<string>? tipos = Clientes ? null : TiposSeleccionados();

        SinubeSinFolioDto? sinFolio = null;

        if (SinFolio)
        {
            sinFolio = new SinubeSinFolioDto { LlaveFoliador = LlaveFoliador, SustituirFolio = SustituirFolio };

            if (Foliadores.FirstOrDefault(f => f.Llave == LlaveFoliador) is SinubeFoliadorDto elegido)
            {
                Config.FoliadorLlave = elegido.Llave;
                Config.FoliadorNombre = elegido.Nombre;
            }
        }

        // Las opciones de clientes (y el foliador) quedan guardadas para la siguiente vez.
        if (Clientes)
            Sinube.GuardarConfiguracion(Config, null);

        Enviando = true;
        Cancelacion = new CancellationTokenSource();
        bool clientes = Clientes;
        bool terminado = false;

        try
        {
            // Pagos de clientes ya en SINUBE (serie-folio → UUID): de la revisión, o se consultan ahora.
            Dictionary<string, string>? pagosEnSinube = Revision?.PagosEnSinube;

            if (clientes && Revision is null)
            {
                List<DatosXml> pagos = await Task.Run(() => archivos.Select(DatosDeArchivo).Where(d => d.Tipo == "P").ToList());

                if (pagos.Count > 0)
                {
                    pagosEnSinube = await PagosEnSinubeAsync(Config, pagos.Select(p => p.Serie));
                    yaEnSinube = await DatosSinube.UuidsDepositosAsync(Config, [periodo.AddMonths(-1), periodo, periodo.AddMonths(1)]);
                }
            }

            await Task.Run(() => Sinube.EnviarArchivosAsync(
                empresa,
                Config,
                clientes,
                archivos,
                tipos,
                Reenviar,
                EnviarConIeps,
                (envio, actual, total) => InvokeAsync(() =>
                {
                    Resultados.Add(envio);
                    Procesados = actual;
                    StateHasChanged();
                }),
                Cancelacion.Token,
                sinFolio,
                yaEnSinube,
                pagosEnSinube));

            terminado = true;
        }
        catch (OperationCanceledException)
        {
            Error = $"Proceso detenido. Se procesaron {Procesados} de {Total} archivo(s).";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Enviando = false;
            Cancelacion?.Dispose();
            Cancelacion = null;
            await InvokeAsync(StateHasChanged);
        }

        if (terminado)
            await RevisarAlTerminarAsync(empresa, Config, clientes, periodo);
    }

    /// <summary>Vuelve a consultar SINUBE para ver cómo quedó el periodo; los resultados del envío se conservan.</summary>
    private async Task RevisarAlTerminarAsync(EmpresaDto empresa, SinubeConfiguracionDto config, bool clientes, DateTime periodo)
    {
        Revision = null;
        RevisandoFinal = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            Revision = await ConsultarRevisionAsync(empresa, config, clientes, periodo);
        }
        catch (Exception ex)
        {
            Error = $"Se envió, pero no se pudo volver a consultar SINUBE: {ex.Message}";
        }
        finally
        {
            RevisandoFinal = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancelar() => Cancelacion?.Cancel();

    private async Task CargarFoliadoresAsync()
    {
        if (Config is null)
            return;

        CargandoFoliadores = true;
        Error = null;

        try
        {
            Foliadores = await Sinube.ObtenerFoliadoresAsync(Config);

            if (Foliadores.Count == 0)
                Error = "SINUBE no devolvió foliadores para la sucursal " + Config.Sucursal + ".";
            else if (Foliadores.All(f => f.Llave != LlaveFoliador))
                LlaveFoliador = Foliadores.Count == 1 ? Foliadores[0].Llave : "";
        }
        catch (Exception ex)
        {
            Error = "No se pudieron cargar los foliadores: " + ex.Message;
        }
        finally
        {
            CargandoFoliadores = false;
        }
    }

    private int Contar(string estatus) => Resultados.Count(r => r.Estatus == estatus);

    private static string ClaseEstatus(string estatus) => estatus switch
    {
        "OK" => "ok",
        "EXISTE" => "exists",
        "OMITIDO" or "NOMINA" => "skipped",
        "IEPS" => "warn",
        _ => "error"
    };

    private static string NombreAmbiente(string ambiente) => ambiente switch
    {
        SinubeAmbientes.PruebasFacturanube => "Pruebas facturanube",
        SinubeAmbientes.PruebasSinubeFb => "Pruebas si-nube-fb",
        _ => "Producción"
    };

    private async Task CopiarResultadoAsync()
    {
        var texto = new System.Text.StringBuilder("Estatus\tTipo\tSerie\tFolio\tFecha\tRFC\tNombre\tUUID\tMensaje\n");

        foreach (SinubeEnvioDto r in ResultadosVisibles)
        {
            texto.Append($"{r.Estatus}\t{r.TipoComprobante}\t{r.Serie}\t{r.Folio}\t{r.FechaCfdi:dd/MM/yyyy}\t{r.Rfc}\t{r.Nombre}\t{r.Uuid}\t{r.Mensaje.Replace('\n', ' ')}\n");
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto.ToString());
    }

    // ───────────── Herramientas ─────────────

    private void Guardar()
    {
        if (Config is null)
            return;

        try
        {
            Sinube.GuardarConfiguracion(Config, NuevaPassword);
            NuevaPassword = null;
            Config = Sinube.ObtenerConfiguracion(EmpresaContext.EmpresaActiva!);
            MensajeOk = true;
            MensajeHerramientas = "Configuración guardada.";
        }
        catch (Exception ex)
        {
            MensajeOk = false;
            MensajeHerramientas = ex.Message;
        }
    }

    private async Task ProbarAccesoAsync()
    {
        if (Config is null)
            return;

        Guardar();

        if (!MensajeOk)
            return;

        Probando = true;
        MensajeHerramientas = null;

        try
        {
            (MensajeOk, MensajeHerramientas) = await Sinube.ProbarAccesoAsync(Config);
            Config = Sinube.ObtenerConfiguracion(EmpresaContext.EmpresaActiva!);
        }
        catch (Exception ex)
        {
            MensajeOk = false;
            MensajeHerramientas = ex.Message;
        }
        finally
        {
            Probando = false;
        }
    }

    private void CambiarOrigenZip(bool emitidos)
    {
        ZipEmitidos = emitidos;
        PeriodosZip = EmpresaContext.EmpresaActiva is EmpresaDto empresa ? Sinube.Periodos(empresa, emitidos) : [];
        ZipPeriodo = PeriodosZip.Count > 0 ? PeriodosZip[0].ToString("yyyy-MM") : "";
    }

    private async Task DescargarZipAsync()
    {
        if (EmpresaContext.EmpresaActiva is not EmpresaDto empresa || Config is null || !TryPeriodo(ZipPeriodo, out DateTime periodo))
            return;

        GenerandoZip = true;
        MensajeHerramientas = null;

        try
        {
            SinubeConfiguracionDto config = Config;
            var (contenido, nombre, _) = await Task.Run(() => Sinube.GenerarZipRenombrado(empresa, config, ZipEmitidos, periodo));

            await JS.InvokeVoidAsync("descargarArchivoBase64", nombre, "application/zip", Convert.ToBase64String(contenido));
        }
        catch (Exception ex)
        {
            MensajeOk = false;
            MensajeHerramientas = ex.Message;
        }
        finally
        {
            GenerandoZip = false;
        }
    }

    private void CargarHistorial()
    {
        Historial = EmpresaContext.TieneEmpresaActiva ? Repo.ObtenerHistorialSinube(EmpresaContext.EmpresaId, 200) : [];
    }

    private async Task BorrarHistorialAsync()
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Borrar el historial de envíos a SINUBE de esta empresa? Después se podrán volver a enviar todos los XML.");

        if (!confirmar)
            return;

        Repo.BorrarHistorialSinube(EmpresaContext.EmpresaId, null);
        CargarHistorial();
    }

    private void EmpresaCambio()
    {
        if (Enviando)
            Cancelacion?.Cancel();

        _ = InvokeAsync(() =>
        {
            Cargar();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EmpresaContext.OnChange -= EmpresaCambio;
        Cancelacion?.Cancel();
    }
}

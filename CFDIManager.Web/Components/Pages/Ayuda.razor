@page "/ayuda"
@page "/novedades"
@attribute [Authorize]
@implements IDisposable
@using CFDIManager.Web.Components.Ayuda
@using CFDIManager.Web.Services.Ayuda
@inject NavigationManager Navigation

@* Manual de usuario (/ayuda) y Registro de cambios (/novedades): Markdown de CFDIManager.Web\Ayuda. *@

<PageTitle>@Documento.Titulo</PageTitle>

<VistaDocumento Documento="Documento" Ruta="@Ruta" />

@code {
    // Las dos rutas usan esta misma página: al pasar de una a otra Blazor la reutiliza sin volver a dibujarla.
    protected override void OnInitialized() => Navigation.LocationChanged += Cambio;

    private void Cambio(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= Cambio;

    private string Ruta => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#', '?')[0];

    private DocumentoAyuda Documento => DocumentosAyuda.Obtener(
        Ruta.StartsWith("novedades", StringComparison.OrdinalIgnoreCase) ? DocumentosAyuda.Novedades : DocumentosAyuda.Manual,
        Ruta.StartsWith("novedades", StringComparison.OrdinalIgnoreCase) ? "novedades" : "ayuda");
}

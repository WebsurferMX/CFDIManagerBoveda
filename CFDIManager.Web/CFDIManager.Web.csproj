<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CFDIParser\CFDIParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <!-- Storage son datos de cada equipo: publicarlo sobrescribiría los del servidor (solicitudes del SAT, CIF...). -->
  <ItemGroup>
    <Content Remove="Storage\**" />
    <None Remove="Storage\**" />
  </ItemGroup>

  <!-- Base vacía en modo Escritorio: Services\Esquema\EsquemaInicial.cs la aplica. -->
  <ItemGroup>
    <EmbeddedResource Include="Services\Esquema\esquema_inicial.sql" />
    <!-- Manual de usuario y Registro de cambios (menú del usuario → Ayuda, Registro de cambios). -->
    <EmbeddedResource Include="Ayuda\*.md" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>CFDIManagerBoveda-Web</UserSecretsId>
  </PropertyGroup>

</Project>

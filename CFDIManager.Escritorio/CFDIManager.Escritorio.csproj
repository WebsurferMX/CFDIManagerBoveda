<Project Sdk="Microsoft.NET.Sdk">

  <!-- CFDI Manager Escritorio: ventana WPF + WebView2 que abre CFDIManager.Web en otro equipo (modo Servidor) o en esta
       PC con PostgreSQL portátil (modo Local). Instalador y actualizaciones con Velopack (herramientas\Publicar-Escritorio.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo para el ícono de la bandeja (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CFDIManager.Escritorio</RootNamespace>
    <AssemblyName>CFDIManagerEscritorio</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>CFDI Manager Escritorio</Product>
    <Version>0.1.0</Version>
    <!-- Main propio (Program.cs): Velopack debe correr antes que WPF. -->
    <StartupObject>CFDIManager.Escritorio.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- WPF y Windows Forms comparten nombres (Application, Clipboard, MessageBox...): se usan los de WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>

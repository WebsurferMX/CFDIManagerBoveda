@page "/cuenta/cambiar-password"
@layout LoginLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using CFDIParser.Models
@using Microsoft.AspNetCore.Identity

@inject UserManager<UsuarioDto> UserManager
@inject SignInManager<UsuarioDto> SignInManager
@inject NavigationManager Navigation
@inject ILogger<CambiarPassword> Logger

<PageTitle>Cambiar contraseña · CFDI Manager</PageTitle>

<div class="login-card">
    <div class="marca">
        <span class="logo"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i></span>
        <div>
            <strong>CFDI Manager</strong>
            <small>@HttpContext.User.FindFirst(UsuarioClaimsFactory.NombreCompleto)?.Value</small>
        </div>
    </div>

    <h1>@(Obligatorio ? "Elige tu contraseña" : "Cambiar contraseña")</h1>

    @if (Obligatorio)
    {
        <div class="mensaje-info">
            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
            Estás usando una contraseña temporal. Para continuar, elige una contraseña personal.
        </div>
    }

    @if (Errores.Count > 0)
    {
        <div class="mensaje-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@string.Join(" ", Errores)</span>
        </div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="Cambiar" FormName="cambiar-password">
        <DataAnnotationsValidator />

        <div class="campo">
            <label for="actual">@(Obligatorio ? "Contraseña temporal" : "Contraseña actual")</label>
            <InputText id="actual" type="password" @bind-Value="Input.Actual" autocomplete="current-password" autofocus />
            <ValidationMessage For="() => Input.Actual" />
        </div>

        <div class="campo">
            <label for="nueva">Contraseña nueva</label>
            <InputText id="nueva" type="password" @bind-Value="Input.Nueva" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Nueva" />
        </div>

        <div class="campo">
            <label for="confirmar">Confirmar contraseña nueva</label>
            <InputText id="confirmar" type="password" @bind-Value="Input.Confirmar" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Confirmar" />
        </div>

        <p class="ayuda">Mínimo 8 caracteres con mayúscula, minúscula y número.</p>

        <button type="submit" class="entrar">
            <i class="bi bi-check2-circle" aria-hidden="true"></i>
            Guardar contraseña
        </button>

        @if (!Obligatorio)
        {
            <a href="@DestinoSeguro(ReturnUrl)" class="cancelar">Cancelar</a>
        }
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private CambioModelo Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private List<string> Errores = new();

    private bool Obligatorio => HttpContext.User.HasClaim(c => c.Type == UsuarioClaimsFactory.DebeCambiarPassword);

    protected override void OnInitialized() => Input ??= new();

    private async Task Cambiar()
    {
        UsuarioDto? usuario = await UserManager.GetUserAsync(HttpContext.User);

        if (usuario is null)
        {
            Navigation.NavigateTo("/cuenta/login", forceLoad: true);
            return;
        }

        if (Input.Nueva == Input.Actual)
        {
            Errores = ["La contraseña nueva debe ser distinta de la actual."];
            return;
        }

        // Solo se guarda si el cambio procede (ChangePasswordAsync actualiza el usuario completo).
        usuario.DebeCambiarPassword = false;

        IdentityResult resultado = await UserManager.ChangePasswordAsync(usuario, Input.Actual, Input.Nueva);

        if (!resultado.Succeeded)
        {
            Errores = resultado.Errors
                .Select(e => e.Code == "PasswordMismatch" ? "La contraseña actual no es correcta." : e.Description)
                .ToList();
            return;
        }

        // Nueva cookie con el sello de seguridad actualizado y sin la marca de contraseña temporal.
        await SignInManager.RefreshSignInAsync(usuario);
        Logger.LogInformation("{Usuario} cambió su contraseña.", usuario.NombreUsuario);

        Navigation.NavigateTo(DestinoSeguro(ReturnUrl), forceLoad: true);
    }

    private static string DestinoSeguro(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\")
            ? url
            : "/";

    private sealed class CambioModelo
    {
        [Required(ErrorMessage = "Escribe tu contraseña actual.")]
        public string Actual { get; set; } = "";

        [Required(ErrorMessage = "Escribe la contraseña nueva.")]
        public string Nueva { get; set; } = "";

        [Compare(nameof(Nueva), ErrorMessage = "La confirmación no coincide.")]
        public string Confirmar { get; set; } = "";
    }
}

@page "/cuenta/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using CFDIParser.Models
@using CFDIParser.Services
@using Microsoft.AspNetCore.Identity

@inject SignInManager<UsuarioDto> SignInManager
@inject UserManager<UsuarioDto> UserManager
@inject PostgreSqlRepository Repo
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Iniciar sesión · CFDI Manager</PageTitle>

<div class="login-card">
    <div class="marca">
        <span class="logo"><i class="bi bi-safe2-fill" aria-hidden="true"></i></span>
        <div>
            <strong>CFDI Manager</strong>
            <small>Bóveda de comprobantes fiscales</small>
        </div>
    </div>

    <h1>Iniciar sesión</h1>

    @if (!string.IsNullOrWhiteSpace(MensajeError))
    {
        <div class="mensaje-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            @MensajeError
        </div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="IniciarSesion" FormName="login">
        <DataAnnotationsValidator />

        <div class="campo">
            <label for="usuario">Usuario</label>
            <InputText id="usuario" @bind-Value="Input.Usuario" autocomplete="username" autofocus />
            <ValidationMessage For="() => Input.Usuario" />
        </div>

        <div class="campo">
            <label for="password">Contraseña</label>
            <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="current-password" />
            <ValidationMessage For="() => Input.Password" />
        </div>

        <label class="recordar">
            <InputCheckbox @bind-Value="Input.Recordarme" />
            Mantener la sesión en este equipo
        </label>

        <button type="submit" class="entrar">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            Entrar
        </button>
    </EditForm>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginModelo Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? MensajeError;

    private async Task IniciarSesion()
    {
        UsuarioDto? usuario = await UserManager.FindByNameAsync(Input.Usuario.Trim());

        // Mismo mensaje para usuario inexistente o inactivo, para no revelar qué usuarios existen.
        if (usuario is null || !usuario.Activo)
        {
            MensajeError = "Usuario o contraseña incorrectos.";
            return;
        }

        SignInResult resultado = await SignInManager.PasswordSignInAsync(
            usuario, Input.Password, Input.Recordarme, lockoutOnFailure: true);

        if (resultado.Succeeded)
        {
            Repo.RegistrarAccesoUsuario(usuario.UsuarioId);
            Logger.LogInformation("Inicio de sesión de {Usuario}.", usuario.NombreUsuario);
            string destino = DestinoSeguro(ReturnUrl);

            Navigation.NavigateTo(
                usuario.DebeCambiarPassword
                    ? $"/cuenta/cambiar-password?returnUrl={Uri.EscapeDataString(destino)}"
                    : destino,
                forceLoad: true);
            return;
        }

        MensajeError = resultado.IsLockedOut
            ? "La cuenta está bloqueada por intentos fallidos. Intenta de nuevo en 15 minutos."
            : "Usuario o contraseña incorrectos.";
    }

    // Solo rutas locales, para que ?returnUrl= no sirva para redirigir a otro sitio.
    private static string DestinoSeguro(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\")
            ? url
            : "/";

    private sealed class LoginModelo
    {
        [Required(ErrorMessage = "Escribe tu usuario.")]
        public string Usuario { get; set; } = "";

        [Required(ErrorMessage = "Escribe tu contraseña.")]
        public string Password { get; set; } = "";

        public bool Recordarme { get; set; }
    }
}

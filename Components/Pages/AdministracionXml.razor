    /// <summary>Marcados (o todo el filtro, con confirmación) o, si no hay, el renglón activo. Desmarca solo si todos ya estaban verificados.</summary>
    private async Task AlternarVerificado()
    {
        List<AdminXmlFilaDto> objetivo;

        try
        {
            objetivo = TodoElFiltro || Marcadas.Count > 0
                ? Repo.ObtenerSeleccionAdministracionXml(FiltroAccion())
                : Activa is { } a ? new() { a } : new();
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
            return;
        }

        if (objetivo.Count == 0)
        {
            Avisar("Marca o selecciona comprobantes.", error: true);
            return;
        }

        bool verificar = !objetivo.All(f => f.Verificado);

        if (TodoElFiltro && !await JS.InvokeAsync<bool>("confirm",
                $"¿{(verificar ? "Marcar" : "Desmarcar")} como verificados los {objetivo.Count:N0} comprobantes del filtro?"))
        {
            return;
        }

        List<long> ids = objetivo.Select(f => f.CfdiId).ToList();
        int n = Repo.MarcarVerificadosAdministracionXml(EmpresaContext.EmpresaId, ids, verificar);

        foreach (AdminXmlFilaDto f in Filas.Where(f => ids.Contains(f.CfdiId)))
        {
            f.Verificado = verificar;
        }

        Avisar($"{n} {(verificar ? "marcados como verificados" : "desmarcados")}.");
    }


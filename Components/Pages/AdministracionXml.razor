    private async Task GuardarLogo(InputFileChangeEventArgs e)
    {
        try
        {
            using var memoria = new MemoryStream();
            await e.File.OpenReadStream(5 * 1024 * 1024).CopyToAsync(memoria);
            Logos.Guardar(RfcLogo, memoria.ToArray());
            LogosGuardados = Logos.Listar();
            VersionLogos++;
        }
        catch (Exception ex)
        {
            Avisar(ex.Message, error: true);
        }
    }


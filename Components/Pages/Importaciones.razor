@using CFDIManager.Web.Components.Layout

@page "/importaciones"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.AspNetCore.Components.Forms
@using CFDIParser.Models
@using CFDIParser.Services
@using CFDIManager.Web.Services

@inject EmpresaContext EmpresaContext
@inject ImportacionCfdiService Importacion

<PageTitle>Importación de XML</PageTitle>

<div class="importacion-page">
    <div class="page-header">
        <div class="eyebrow">
            CFDI MANAGER
        </div>

        <h1>
            Importación de XML
        </h1>

        <p>
            Carga, clasifica e importa comprobantes para la empresa seleccionada.
        </p>
    </div>


    @if (EmpresaContext.EmpresaActiva is null)
    {
        <div class="alerta alerta-advertencia">
            <strong>No hay una empresa activa.</strong>

            <span>
                Selecciona una empresa antes de importar archivos XML.
            </span>
        </div>
    }
    else
    {
        <section class="empresa-card">
            <span class="empresa-label">
                EMPRESA ACTIVA
            </span>

            <strong>
                @EmpresaContext.EmpresaActiva.Rfc ·
                @EmpresaContext.EmpresaActiva.NombreParaMostrar
            </strong>
        </section>
    }

    <section class="selector-card">
        <div class="selector-zone">
            <div class="xml-icon">
                XML
            </div>

            <div class="selector-info">
                <h2>
                    Seleccionar archivos XML
                </h2>

                <p>
                    Puedes seleccionar hasta
                    @MaximoArchivos archivos por lote.
                    Los archivos se preparan inmediatamente
                    para evitar que el navegador pierda la selección.
                </p>
            </div>

            <div class="selector-control">
                <InputFile @key="_inputKey"
                           OnChange="SeleccionarArchivos"
                           multiple
                           accept=".xml,text/xml,application/xml"
                           disabled="@(_seleccionando || _procesando)" />
            </div>
        </div>

        <div class="selector-footer">
            <div class="seleccion-resumen">
                <strong>
                    @CantidadArchivosMostrada
                </strong>

                <span>
                    @TextoSeleccionArchivos
                </span>
            </div>

            <div class="acciones">
                <button type="button"
                        class="btn btn-secundario"
                        disabled="@(_seleccionando || _procesando)"
                        @onclick="LimpiarAsync">
                    Limpiar
                </button>

                <button type="button"
                        class="btn btn-principal"
                        disabled="@NoSePuedeImportar"
                        @onclick="ClasificarEImportarAsync">
                    @TextoBotonImportar
                </button>
            </div>
        </div>

        @if (_seleccionando)
        {
            <div class="barra-area">
                <div class="barra-progreso">
                    <div class="barra-progreso-valor"
                         style="@($"width: {PorcentajePreparacion:0.##}%")">
                    </div>
                </div>

                <span>
                    Preparando @_archivosPreparados de
                    @_totalArchivosSeleccionados archivo(s)...
                </span>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="@ClaseMensaje">
            @_mensaje
        </div>
    }

    <section class="metricas-grid">
        <article class="metrica metrica-correctos">
            <span>
                Correctos
            </span>

            <strong>
                @_correctos
            </strong>
        </article>

        <article class="metrica metrica-ingresos">
            <span>
                Emitidos
            </span>

            <strong>
                @_emitidos
            </strong>
        </article>

        <article class="metrica metrica-egresos">
            <span>
                Recibidos
            </span>

            <strong>
                @_recibidos
            </strong>
        </article>

        <article class="metrica metrica-duplicados">
            <span>
                Actualizados
            </span>

            <strong>
                @_actualizados
            </strong>
        </article>

        <article class="metrica metrica-noidentificados">
            <span>
                No identificados
            </span>

            <strong>
                @_noIdentificados
            </strong>
        </article>

        <article class="metrica metrica-errores">
            <span>
                Errores
            </span>

            <strong>
                @_errores
            </strong>
        </article>
    </section>

    <section class="resultados-card">
        <header class="resultados-header">
            <div>
                <span class="eyebrow">
                    RESULTADOS
                </span>

                <h2>
                    Detalle de importación
                </h2>
            </div>

            <span>
                @_resultados.Count procesado(s)
            </span>
        </header>

        @if (_resultados.Count == 0)
        {
            <div class="sin-resultados">
                Todavía no hay resultados de importación.
            </div>
        }
        else
        {
            <div class="tabla-wrapper">
                <table class="resultados-tabla">
                    <thead>
                        <tr>
                            <th>Archivo</th>
                            <th>UUID</th>
                            <th>Clasificación</th>
                            <th>Estatus</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (ResultadoImportacionVista resultado
                                  in _resultados)
                        {
                            <tr>
                                <td class="archivo-cell">
                                    @resultado.Archivo
                                </td>

                                <td class="uuid-cell">
                                    @MostrarTexto(resultado.UUID)
                                </td>

                                <td>
                                    <span class="@ObtenerClaseClasificacion(
                                                     resultado.Clasificacion)">
                                        @MostrarTexto(resultado.Clasificacion)
                                    </span>
                                </td>

                                <td>
                                    <span class="@ObtenerClaseEstatus(
                                                     resultado.Estatus)">
                                        @resultado.Estatus
                                    </span>
                                </td>

                                <td class="detalle-cell">
                                    @resultado.Detalle
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>


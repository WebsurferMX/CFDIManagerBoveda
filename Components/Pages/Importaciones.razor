@code {
    private const int MaximoArchivos =
        500;

    private const long TamanoMaximoXml =
        20L * 1024L * 1024L;

    private readonly List<ArchivoXmlTemporal> _archivos =
        new();

    private readonly List<ResultadoImportacionVista> _resultados =
        new();

    private bool _seleccionando;

    private bool _procesando;

    private int _inputKey;

    private int _archivosPreparados;

    private int _totalArchivosSeleccionados;

    private int _correctos;

    private int _emitidos;

    private int _recibidos;

    private int _actualizados;

    private int _noIdentificados;

    private int _errores;

    private string _mensaje =
        "";

    private TipoMensaje _tipoMensaje =
        TipoMensaje.Info;

    private double _porcentajeSeleccion =>
        _totalArchivosSeleccionados == 0
            ? 0
            : (double)_archivosPreparados /
              _totalArchivosSeleccionados;

    private bool NoSePuedeImportar =>
        _seleccionando ||
        _procesando ||
        _archivos.Count == 0 ||
        EmpresaContext.EmpresaActiva is null;

    private string TextoBotonImportar =>
        _procesando
            ? $"Importando {_resultados.Count} de {_archivos.Count}..."
            : "Clasificar e importar";

    private string ClaseMensaje =>
        _tipoMensaje switch
        {
            TipoMensaje.Exito =>
                "alerta alerta-exito",

            TipoMensaje.Error =>
                "alerta alerta-error",

            TipoMensaje.Advertencia =>
                "alerta alerta-advertencia",

            _ =>
                "alerta alerta-info"
        };

protected override void OnInitialized()
{
    EmpresaContext.OnChange += EmpresaActivaCambio;
}
    private void EmpresaActivaCambio()
    {
        _ = InvokeAsync(
            StateHasChanged);
    }


    private async Task SeleccionarArchivos(
    InputFileChangeEventArgs e)
{
    if (_procesando)
    {
        return;
    }

    _seleccionando =
        true;

    _mensaje =
        "";

    _tipoMensaje =
        TipoMensaje.Info;

    _archivosPreparados =
        0;

    _totalArchivosSeleccionados =
        0;

    await EliminarTemporalesAsync();

    _archivos.Clear();

    try
    {
        IReadOnlyList<IBrowserFile> archivos =
            e.GetMultipleFiles(
                MaximoArchivos);

        _totalArchivosSeleccionados =
            archivos.Count;

        _mensaje =
            $"Preparando {_totalArchivosSeleccionados} " +
            "archivo(s) XML...";

        await InvokeAsync(
            StateHasChanged);

        foreach (IBrowserFile archivo in archivos)
        {
            try
            {
                if (!archivo.Name.EndsWith(
                        ".xml",
                        StringComparison.OrdinalIgnoreCase))
                {
                    RegistrarResultado(
                        archivo.Name,
                        "",
                        "",
                        "OMITIDO",
                        "El archivo seleccionado no tiene extensión XML.");

                    continue;
                }

                ArchivoXmlTemporal temporal =
                    await CopiarATemporalAsync(
                        archivo);

                _archivos.Add(
                    temporal);
            }
            catch (Exception ex)
            {
                _errores++;

                RegistrarResultado(
                    archivo.Name,
                    "",
                    "",
                    "ERROR",
                    "No se pudo preparar el archivo: " +
                    ex.Message);
            }
            finally
            {
                _archivosPreparados++;

                /*
                 * Se actualiza la pantalla cada archivo.
                 * Para lotes grandes, Task.Yield permite que
                 * Blazor procese el renderizado pendiente.
                 */

                if (_archivosPreparados % 10 == 0 ||
                    _archivosPreparados ==
                        _totalArchivosSeleccionados)
                {
                    await InvokeAsync(
                        StateHasChanged);

                    await Task.Yield();
                }
                            }
                        }

        if (_archivos.Count == 0)
        {
            _mensaje =
                "No se pudo preparar ningún archivo XML.";

            _tipoMensaje =
                TipoMensaje.Advertencia;
        }
        else
        {
            _mensaje =
                $"{_archivos.Count} archivo(s) XML " +
                "listo(s) para clasificar e importar.";

            _tipoMensaje =
                _errores == 0
                    ? TipoMensaje.Exito
                    : TipoMensaje.Advertencia;
        }
    }
    catch (InvalidOperationException ex)
    {
        _mensaje =
            "No fue posible obtener la selección de archivos. " +
            ex.Message;

        _tipoMensaje =
            TipoMensaje.Error;
    }
    catch (Exception ex)
    {
        _mensaje =
            "No se pudieron preparar los archivos: " +
            ex.Message;

        _tipoMensaje =
            TipoMensaje.Error;
    }
    finally
    {
        _seleccionando =
            false;

        await InvokeAsync(
            StateHasChanged);
    }
}

   private async Task<ArchivoXmlTemporal> CopiarATemporalAsync(
        IBrowserFile archivo)
    {
        string nombreSeguro =
            Path.GetFileName(
                archivo.Name);

        string carpetaTemporal =
            Path.Combine(
                Path.GetTempPath(),
                "CFDIManager",
                "Importaciones",
                Guid.NewGuid().ToString("N"));

        Directory.CreateDirectory(
            carpetaTemporal);

        string rutaTemporal =
            Path.Combine(
                carpetaTemporal,
                nombreSeguro);

        await using Stream origen =
            archivo.OpenReadStream(
                TamanoMaximoXml);

        await using var destino =
            new FileStream(
                rutaTemporal,
                FileMode.CreateNew,
                FileAccess.Write,
                FileShare.None,
                bufferSize: 81920,
                useAsync: true);

        await origen.CopyToAsync(
            destino);

        return new ArchivoXmlTemporal
        {
            Nombre =
                nombreSeguro,

            RutaTemporal =
                rutaTemporal,

            Tamano =
                archivo.Size
        };
    }

    private async Task ClasificarEImportarAsync()
    {
        EmpresaDto? empresa =
            EmpresaContext.EmpresaActiva;

        if (empresa is null)
        {
            _mensaje =
                "Selecciona una empresa antes de importar.";

            _tipoMensaje =
                TipoMensaje.Advertencia;

            return;
        }

        if (_archivos.Count == 0)
        {
            _mensaje =
                "Selecciona al menos un archivo XML.";

            _tipoMensaje =
                TipoMensaje.Advertencia;

            return;
        }

        _procesando =
            true;

        ReiniciarContadoresImportacion();

        try
        {
            List<ArchivoXmlTemporal> archivosAProcesar =
                _archivos.ToList();

            foreach (ArchivoXmlTemporal archivo
                     in archivosAProcesar)
            {
                await ProcesarArchivoAsync(
                    empresa,
                    archivo);

                await InvokeAsync(
                    StateHasChanged);
            }

            _mensaje =
                $"Proceso terminado. " +
                $"{_correctos} correcto(s), " +
                $"{_actualizados} actualizado(s), " +
                $"{_errores} error(es).";

            _tipoMensaje =
                _errores == 0
                    ? TipoMensaje.Exito
                    : TipoMensaje.Advertencia;
        }
        catch (Exception ex)
        {
            _mensaje =
                $"La importación no pudo finalizar: {ex.Message}";

            _tipoMensaje =
                TipoMensaje.Error;
        }
        finally
        {
            _procesando =
                false;

            await EliminarTemporalesAsync();

            _archivos.Clear();

            _inputKey++;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private Task ProcesarArchivoAsync(
        EmpresaDto empresa,
        ArchivoXmlTemporal archivo)
    {
        ResultadoImportacionCfdi resultado =
            Importacion.Importar(
                empresa,
                archivo.RutaTemporal,
                archivo.Nombre);

        switch (resultado.Estatus)
        {
            case "OMITIDO":
                _noIdentificados++;

                RegistrarResultado(
                    archivo.Nombre,
                    resultado.Uuid,
                    "NO IDENTIFICADO",
                    "OMITIDO",
                    resultado.Detalle);
                break;

            case "ERROR":
                _errores++;

                RegistrarResultado(
                    archivo.Nombre,
                    resultado.Uuid,
                    "",
                    "ERROR",
                    resultado.Detalle);
                break;

            default:
                _correctos++;

                if (resultado.Clasificacion == "EMITIDO")
                {
                    _emitidos++;
                }
                else
                {
                    _recibidos++;
                }

                if (resultado.YaExistia)
                {
                    _actualizados++;
                }

                RegistrarResultado(
                    archivo.Nombre,
                    resultado.Uuid,
                    resultado.Clasificacion,
                    resultado.Estatus,
                    resultado.Detalle);
                break;
        }

        return Task.CompletedTask;
    }

    private void RegistrarResultado(
        string archivo,
        string? uuid,
        string? clasificacion,
        string estatus,
        string detalle)
    {
        _resultados.Add(
            new ResultadoImportacionVista
            {
                Archivo =
                    archivo,

                UUID =
                    uuid ?? "",

                Clasificacion =
                    clasificacion ?? "",

                Estatus =
                    estatus,

                Detalle =
                    detalle
            });
    }

    private void ReiniciarContadoresImportacion()
    {
        _resultados.Clear();

        _correctos =
            0;

        _emitidos =
            0;

        _recibidos =
            0;

        _actualizados =
            0;

        _noIdentificados =
            0;

        _errores =
            0;
    }

    private async Task LimpiarAsync()
    {
        if (_procesando)
        {
            return;
        }

        await EliminarTemporalesAsync();

        _archivos.Clear();

        _resultados.Clear();

        _mensaje =
            "";

        _inputKey++;

        _archivosPreparados =
            0;

        _totalArchivosSeleccionados =
            0;

        _correctos =
            0;

        _emitidos =
            0;

        _recibidos =
            0;

        _actualizados =
            0;

        _noIdentificados =
            0;

        _errores =
            0;
    }

    private Task EliminarTemporalesAsync()
    {
        foreach (ArchivoXmlTemporal archivo
                 in _archivos)
        {
            try
            {
                if (File.Exists(
                        archivo.RutaTemporal))
                {
                    File.Delete(
                        archivo.RutaTemporal);
                }

                string? carpeta =
                    Path.GetDirectoryName(
                        archivo.RutaTemporal);

                if (!string.IsNullOrWhiteSpace(carpeta) &&
                    Directory.Exists(carpeta))
                {
                    Directory.Delete(
                        carpeta,
                        recursive: true);
                }
            }
            catch
            {
                // La limpieza no debe detener el proceso.
            }
        }

        return Task.CompletedTask;
    }

    private static string MostrarTexto(
        string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }

    private static string ObtenerClaseClasificacion(
        string? clasificacion)
    {
        return clasificacion switch
        {
            "EMITIDO" =>
                "badge badge-emitido",

            "RECIBIDO" =>
                "badge badge-recibido",

            _ =>
                "badge badge-noidentificado"
        };
    }

    private static string ObtenerClaseEstatus(
        string estatus)
    {
        return estatus switch
        {
            "CORRECTO" =>
                "badge estatus-correcto",

            "ACTUALIZADO" =>
                "badge estatus-actualizado",

            "OMITIDO" =>
                "badge estatus-omitido",

            _ =>
                "badge estatus-error"
        };
    }

    public void Dispose()
    {
        EmpresaContext.OnChange -=
            EmpresaActivaCambio;

        foreach (ArchivoXmlTemporal archivo
                 in _archivos)
        {
            try
            {
                if (File.Exists(
                        archivo.RutaTemporal))
                {
                    File.Delete(
                        archivo.RutaTemporal);
                }
            }
            catch
            {
                // No se lanza una excepción durante Dispose.
            }
        }
    }

    private sealed class ArchivoXmlTemporal
    {
        public string Nombre { get; init; } =
            "";

        public string RutaTemporal { get; init; } =
            "";

        public long Tamano { get; init; }
    }

    private sealed class ResultadoImportacionVista
    {
        public string Archivo { get; init; } =
            "";

        public string UUID { get; init; } =
            "";

        public string Clasificacion { get; init; } =
            "";

        public string Estatus { get; init; } =
            "";

        public string Detalle { get; init; } =
            "";
    }

    private enum TipoMensaje
    {
        Info,
        Exito,
        Advertencia,
        Error
    }

private int CantidadArchivosMostrada =>
    _seleccionando
        ? _totalArchivosSeleccionados
        : _archivos.Count;

private string TextoSeleccionArchivos
{
    get
    {
        if (_seleccionando)
        {
            return
                $"{_archivosPreparados} preparado(s) de " +
                $"{_totalArchivosSeleccionados} seleccionado(s)";
        }

        return "archivo(s) listo(s) para importar";
    }
}

private double PorcentajePreparacion
{
    get
    {
        if (_totalArchivosSeleccionados <= 0)
        {
            return 0;
        }

        return
            (double)_archivosPreparados /
            _totalArchivosSeleccionados *
            100d;
    }
}

